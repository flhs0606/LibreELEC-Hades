diff --git a/tools/dvbridge/dvbridge_hdrvivid.c b/tools/dvbridge/dvbridge_hdrvivid.c
new file mode 100644
index 00000000000..d4ae38f1d27
--- /dev/null
+++ b/tools/dvbridge/dvbridge_hdrvivid.c
@@ -0,0 +1,179 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#include "dvbridge_hdrvivid.h"
+#include "dvbridge_hdr10plus.h"
+
+#include <string.h>
+#include <libavutil/mem.h>
+
+bool dvbridge_hdrvivid_level1(const AVDynamicHDRVivid *m, struct dvbridge_hdrvivid_l1 *l1)
+{
+    if (!m || !l1 || m->num_windows < 1)
+        return false;
+    if (m->system_start_code < 1 || m->system_start_code > 7)
+        return false;
+
+    memset(l1, 0, sizeof(*l1));
+    const AVHDRVividColorTransformParams *w = &m->params[0];
+
+    if (w->minimum_maxrgb.den <= 0 || w->average_maxrgb.den <= 0 || w->maximum_maxrgb.den <= 0)
+        return false;
+
+    const unsigned min_raw = (unsigned)w->minimum_maxrgb.num;
+    const unsigned avg_raw = (unsigned)w->average_maxrgb.num;
+    const unsigned max_raw = (unsigned)w->maximum_maxrgb.num;
+
+    if (min_raw > avg_raw || avg_raw > max_raw || max_raw > 4095)
+        return false;
+
+    l1->min_raw = min_raw;
+    l1->avg_raw = avg_raw;
+    l1->max_raw = max_raw;
+
+    l1->min_pq = min_raw <= 12 ? min_raw : 12;
+    l1->max_pq = max_raw < 2081 ? 2081 : max_raw;
+    l1->avg_pq = avg_raw < 819 ? 819 : avg_raw;
+    if (l1->avg_pq > l1->max_pq - 1)
+        l1->avg_pq = l1->max_pq - 1;
+    if (l1->min_pq > l1->avg_pq)
+        l1->min_pq = l1->avg_pq;
+
+    return true;
+}
+
+bool dvbridge_hdrvivid_level1_from_t35(const uint8_t *t35, size_t size, struct dvbridge_hdrvivid_l1 *l1)
+{
+    if (!t35 || size < 12 || !l1)
+        return false;
+    if (t35[0] != 0x26 || t35[1] != 0x00 || t35[2] != 0x04 || t35[3] != 0x00 || t35[4] != 0x05)
+        return false;
+    const uint8_t start_code = t35[5];
+    if (start_code < 1 || start_code > 7)
+        return false;
+
+    const unsigned min_raw = ((unsigned)t35[6] << 4) | ((unsigned)t35[7] >> 4);
+    const unsigned avg_raw = (((unsigned)t35[7] & 0x0F) << 8) | (unsigned)t35[8];
+    const unsigned max_raw = (((unsigned)t35[10] & 0x0F) << 8) | (unsigned)t35[11];
+
+    if (min_raw > avg_raw || avg_raw > max_raw || max_raw > 4095)
+        return false;
+
+    l1->min_raw = min_raw;
+    l1->avg_raw = avg_raw;
+    l1->max_raw = max_raw;
+
+    l1->min_pq = min_raw <= 12 ? min_raw : 12;
+    l1->max_pq = max_raw < 2081 ? 2081 : max_raw;
+    l1->avg_pq = avg_raw < 819 ? 819 : avg_raw;
+    if (l1->avg_pq > l1->max_pq - 1)
+        l1->avg_pq = l1->max_pq - 1;
+    if (l1->min_pq > l1->avg_pq)
+        l1->min_pq = l1->avg_pq;
+
+    return true;
+}
+
+bool dvbridge_hdrvivid_same_scene(const AVDynamicHDRVivid *a, const AVDynamicHDRVivid *b)
+{
+    if (!a || !b || a->system_start_code != b->system_start_code || a->num_windows != b->num_windows)
+        return false;
+    const int windows = a->num_windows < 1 ? 1 : a->num_windows > 3 ? 3 : a->num_windows;
+    for (int i = 0; i < windows; ++i) {
+        const AVHDRVividColorTransformParams *p = &a->params[i], *q = &b->params[i];
+        if (p->minimum_maxrgb.num != q->minimum_maxrgb.num ||
+            p->average_maxrgb.num != q->average_maxrgb.num ||
+            p->maximum_maxrgb.num != q->maximum_maxrgb.num ||
+            p->tone_mapping_mode_flag != q->tone_mapping_mode_flag)
+            return false;
+    }
+    return true;
+}
+
+struct dvbridge_hdrvivid_scene *dvbridge_hdrvivid_scene_create(void)
+{
+    return av_mallocz(sizeof(struct dvbridge_hdrvivid_scene));
+}
+
+void dvbridge_hdrvivid_scene_reset(struct dvbridge_hdrvivid_scene *s)
+{
+    if (!s)
+        return;
+    av_freep(&s->first);
+    av_freep(&s->made);
+    memset(s, 0, sizeof(*s));
+}
+
+void dvbridge_hdrvivid_scene_destroy(struct dvbridge_hdrvivid_scene *s)
+{
+    dvbridge_hdrvivid_scene_reset(s);
+    av_free(s);
+}
+
+const AVDOVIMetadata *dvbridge_hdrvivid_next(struct dvbridge_hdrvivid_scene *s,
+                                             const AVDynamicHDRVivid *vivid,
+                                             const uint8_t *t35, size_t t35_size,
+                                             const AVMasteringDisplayMetadata *mastering,
+                                             const AVContentLightMetadata *light,
+                                             size_t *size, bool *repeated)
+{
+    if (!s || !size || !repeated)
+        return NULL;
+    *repeated = false;
+
+    struct dvbridge_hdrvivid_l1 l1;
+    bool has_l1 = false;
+    if (vivid)
+        has_l1 = dvbridge_hdrvivid_level1(vivid, &l1);
+    else if (t35 && t35_size >= 12)
+        has_l1 = dvbridge_hdrvivid_level1_from_t35(t35, t35_size, &l1);
+
+    if (has_l1) {
+        if (s->made && s->have_from && vivid && dvbridge_hdrvivid_same_scene(&s->from, vivid)) {
+            *size = s->size;
+            return s->made;
+        }
+
+        AVMasteringDisplayMetadata default_mastering;
+        if (!mastering || !mastering->has_luminance) {
+            memset(&default_mastering, 0, sizeof(default_mastering));
+            default_mastering.has_luminance = 1;
+            default_mastering.max_luminance = (AVRational){4000, 1};
+            default_mastering.min_luminance = (AVRational){1, 10000};
+            mastering = &default_mastering;
+        }
+
+        size_t bytes = 0;
+        AVDOVIMetadata *first = dvbridge_profile81_metadata(l1.min_pq, l1.max_pq, l1.avg_pq, NULL,
+                                                            mastering, light, true, &bytes);
+        AVDOVIMetadata *made = first ? av_malloc(bytes) : NULL;
+        if (made) {
+            memcpy(made, first, bytes);
+            av_dovi_get_color(made)->scene_refresh_flag = 0;
+            av_free(s->first);
+            av_free(s->made);
+            s->first = first;
+            s->made = made;
+            s->size = bytes;
+            if (vivid) {
+                s->from = *vivid;
+                s->have_from = true;
+            } else {
+                s->have_from = false;
+            }
+            *size = bytes;
+            return s->first;
+        }
+        av_free(first);
+    }
+
+    if (!s->made)
+        return NULL;
+    *repeated = true;
+    *size = s->size;
+    return s->made;
+}
