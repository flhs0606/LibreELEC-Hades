+bool CDVDDemuxFFmpeg::ProbeHdrVivid(CDemuxStream* stream,
+                                    int streamIdx,
+                                    const uint8_t* data,
+                                    int size,
+                                    unsigned int& probed,
+                                    unsigned int done)
+{
+  if (m_dvFromHdrVivid.count(streamIdx))
+    return true;
+  if (m_dvFromHdr10Plus.count(streamIdx))
+    return false;
+  const AVStream* avStream = m_pFormatContext->streams[streamIdx];
+  const CDVHdrVivid::AccessUnit unit = CDVHdrVivid::Read(
+      data, static_cast<size_t>(size), CDVLayerMerge::LengthSize(avStream->codecpar));
+  auto* video = static_cast<CDemuxStreamVideo*>(stream);
+  const bool containerMastering =
+      video->masteringMetaData && video->masteringMetaData->has_luminance;
+
+  if (unit.t35.empty())
+    return false;
+
+  if (m_dvMeasured.count(streamIdx))
+    UnmakeMeasured(stream, streamIdx, "it has HDR Vivid metadata of its own");
+
+  const CDVHdrVivid::Verdict verdict =
+      CDVHdrVivid::Judge(unit, avStream->codecpar, containerMastering);
+  if (verdict != CDVHdrVivid::Verdict::HDR_VIVID)
+  {
+    if (verdict != CDVHdrVivid::Verdict::NOT_YET || probed >= done)
+    {
+      probed = done;
+      CLog::Log(LOGDEBUG, "CDVDDemuxFFmpeg: stream {} has HDR Vivid metadata; not as Dolby Vision: {}",
+                streamIdx, CDVHdrVivid::Why(unit, avStream->codecpar, containerMastering));
+    }
+    return true;
+  }
+  probed = done;
+  DVBRIDGE::HdrVividFound();
+  if (!DVBRIDGE::HdrVividAsDolbyVision())
+  {
+    CLog::Log(LOGDEBUG,
+              "CDVDDemuxFFmpeg: stream {} has HDR Vivid metadata; not sent as Dolby Vision (the "
+              "setting is off, or no native Dolby Vision)",
+              streamIdx);
+    return true;
+  }
+
+  AVDOVIDecoderConfigurationRecord record{};
+  const AVRational rate =
+      av_guess_frame_rate(m_pFormatContext, const_cast<AVStream*>(avStream), nullptr);
+  if (!CDVHdrVivid::Record(avStream->codecpar, rate, record))
+    return true;
+
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: stream {} is HDR Vivid without Dolby Vision: it is Dolby Vision profile "
+            "8.1 from here on, with metadata made from its HDR Vivid metadata (HDR Vivid as Dolby Vision)",
+            streamIdx);
+  m_dvPromoted[streamIdx] = record;
+  m_dvFromHdrVivid[streamIdx] = true;
+  m_dvHdrBefore[streamIdx] = video->hdr_type;
+  video->doviFromHdrVivid = true;
+  PromoteDolbyVision(stream, record, nullptr);
+  return true;
+}
