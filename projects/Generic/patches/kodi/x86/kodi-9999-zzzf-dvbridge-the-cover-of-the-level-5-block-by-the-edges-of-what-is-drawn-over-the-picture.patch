 bool dvbridge_render_pack(struct dvbridge_renderer *renderer, struct dvbridge_gl_packer *packer,
                           unsigned framebuffer, int width, int height, bool flip_y, int cover,
-                          unsigned gui_texture, float gui_pq_peak);
+                          unsigned given, unsigned gui_texture, float gui_pq_peak);
 /* Hades: whether the pack of the frame that is prepared would take the GUI over its picture (the
  * converted transport), for the caller to hand it the GUI (dvbridge_render_pack()) instead of
  * compositing the GUI into the picture itself: the pass of the composite is not run then */
