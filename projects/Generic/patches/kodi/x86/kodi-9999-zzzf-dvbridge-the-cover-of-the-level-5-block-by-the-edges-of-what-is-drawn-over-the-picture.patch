+void CWinSystemGbmGLESContext::DVHDROverlayDrawn(const CRect& drawn)
+{
+  // Hades: the PQ subtitles that the overlay renderer drew into the picture, over the video and
+  // before the GUI (BeginDVBridgeHDROverlays()): their rectangle — in the top-down coordinates
+  // of the window — tells the level 5 cover of the frame (DVCoverEdges()) where they went;
