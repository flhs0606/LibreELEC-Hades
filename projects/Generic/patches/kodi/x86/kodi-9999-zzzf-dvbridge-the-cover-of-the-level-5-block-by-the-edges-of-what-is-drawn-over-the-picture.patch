diff --git a/tools/dvbridge/dvbridge_render.h b/tools/dvbridge/dvbridge_render.h
index 00d786c..6218e30 100644
--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -723,14 +723,17 @@ bool dvbridge_render_source_scales(const struct dvbridge_renderer *renderer,
  * display is sent describes it (dvbridge_candidate_cover()): nothing was (as prepared, the film's
  * active area); something was, and the edges of the active picture it goes beyond are measured on
  * the GPU (the call waits for it); something was, and the area is taken out on every edge that has
- * bars (where the caller does not wait for the GPU). */
+ * bars (where the caller does not wait for the GPU); something was, and the area is taken out on
+ * the edges the caller gives in given (1 left, 2 right, 4 top, 8 bottom), of those that have bars
+ * (a caller that does not wait for the GPU either, and knows what its GUI reaches). */
 #define DVBRIDGE_COVER_NONE 0
 #define DVBRIDGE_COVER_MEASURE 1
 #define DVBRIDGE_COVER_BARS 2
+#define DVBRIDGE_COVER_GIVEN 3
