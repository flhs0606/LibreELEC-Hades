 {
   // Hades: the output goes back to the menus in Dolby Vision, where they go on (CDVMenus::AfterVideo())
@@ -7550,6 +7591,58 @@ void CWinSystemGbmGLESContext::DVTilesUpdate(bool wanted)
   m_packerTried = wanted && (m_tilesPending || have);
 }
 
+unsigned int CWinSystemGbmGLESContext::DVCoverEdges(const unsigned int margins[4]) const
+{
+  // Hades: the edges that what was drawn over the frame reaches, from each of the two that know
+  // where it went: the occupancy rectangles of the GUI (DVTilesUpdate(): a pass of the packer
+  // made them, or the composite's own mask was asked for) and the rectangle of the PQ subtitles
+  // drawn into the picture (DVHDROverlayDrawn()). An edge that none of them reaches keeps its
+  // offsets.
+  unsigned edges = 0;
+  // (the rectangles say nothing where they are not of this GUI, where there are none, where they
+  // stand for the whole quad, or where they are not in the pixels of the transport's raster; the
+  // mask of the HDR composite is not taken either: it is made for another composite)
+  const bool tiles = m_tilesUse && m_tilesGen == m_guiGen && !m_tilesRects.empty() &&
+                     (m_tilesKind == TILES_PACKER || m_tilesKind == TILES_GUI_DV) &&
+                     m_guiFboWidth == 3840 && m_guiFboHeight == 2160;
+  if (tiles)
+  {
+    // (the bands the display would gate beyond the active area, at the bottom-left origin of the
+    // window the rectangles of the tiles are in: the top margin of the raster at the top of it)
+    const unsigned left = margins[0], right = 3840 - margins[1], top = 2160 - margins[2],
+                   bottom = margins[3];
+    for (const auto& r : m_tilesRects)
+    {
+      if (r.x * DVBRIDGE_SOURCE_TILE < left)
+        edges |= 1;
+      if ((r.x + r.w) * DVBRIDGE_SOURCE_TILE > right)
+        edges |= 2;
+      if ((r.y + r.h) * DVBRIDGE_SOURCE_TILE > top)
+        edges |= 4;
+      if (r.y * DVBRIDGE_SOURCE_TILE < bottom)
+        edges |= 8;
+    }
+  }
+  else if (m_dvGuiOver)
+    return 16; // (the GUI was drawn over and its rectangles say nothing: every edge stays taken)
+  // (the subtitles of the picture: their rectangle is in the top-down coordinates of the window,
+  // the raster's rows numbered their own way)
+  if (m_dvOverlayDrawn && m_nWidth == 3840 && m_nHeight == 2160)
+  {
+    const unsigned left = margins[0], right = 3840 - margins[1], top = margins[2],
+                   bottom = 2160 - margins[3];
+    if (m_dvOverlayRect.x1 < left)
+      edges |= 1;
+    if (m_dvOverlayRect.x2 > right)
+      edges |= 2;
+    if (m_dvOverlayRect.y1 < top)
+      edges |= 4;
+    if (m_dvOverlayRect.y2 > bottom)
+      edges |= 8;
+  }
+  return edges;
+}
