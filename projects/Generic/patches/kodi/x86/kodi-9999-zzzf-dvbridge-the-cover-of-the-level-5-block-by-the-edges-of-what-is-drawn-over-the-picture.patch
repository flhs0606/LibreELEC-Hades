                     }
                 } else {
                     ok = dvbridge_render_packed(r, frame, metadata, bytes, pts, frame_el, geometry,
@@ -3636,7 +3637,7 @@ int dvbridge_render_warm(struct dvbridge_renderer *r, const struct pl_frame *sou
             const bool ok =
                 dvbridge_render_rgb(r, source, metadata, bytes, pts, el_pts, geometry) &&
                 (!packer || dvbridge_render_pack(r, packer, framebuffer, 3840, 2160, true,
-                                                 DVBRIDGE_COVER_MEASURE, 0, 0.0f));
+                                                 DVBRIDGE_COVER_MEASURE, 0, 0, 0.0f));
             r->gui_level = level;
             glFinish();
             done.made += ok;
@@ -3954,7 +3955,7 @@ bool dvbridge_render_pack_takes_gui(const struct dvbridge_renderer *r)
 
 bool dvbridge_render_pack(struct dvbridge_renderer *r, struct dvbridge_gl_packer *packer,
                           unsigned framebuffer, int width, int height, bool flip, int cover,
-                          unsigned gui_texture, float gui_peak)
+                          unsigned given, unsigned gui_texture, float gui_peak)
 {
     if (r)
         r->gui_drawn = 0; /* (Hades: until a pack in the source transport says otherwise) */
