+
+// Hades: the fidelity step-down level of a picture rebuilt for output as HDR10, as the settings
+// say now (a bridge for it takes it when it is made, CWinSystemGbmGLESContext::RenderDVConversion();
+// native output reads it when it starts, CWinSystemGbmGLESContext::DVEngineRead()): the level the
+// settings force; without one the faithful picture, for the automatic step-down has nothing to
+// feed on this path (no frame of the conversion is measured)
+int ConversionStepLevel()
+{
+  // (Hades: the fast mode of the mapping (videoscreen.hadesdtmfast) reads its own step-down, as
+  // the engine of a native output does (DVEngineRead()), and draws at level 1 without one being
+  // forced: what that level changes of a picture that the reshaping composes, the upscalers of
+  // its planes, is what the conversion waits for)
+  const bool fast = DVBRIDGE::DtmFast();
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const auto advanced = component ? component->GetAdvancedSettings() : nullptr;
+  CDVEngineSettings::Read read;
+  read.step = settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEPMODE)
+                   ? settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEPMODE)
+                   : 0;
+  if (fast)
+    read.step = static_cast<int>(CDVEngineSettings::Step::AUTOMATIC);
+  CDVEngineSettings::Advanced fromFile;
+  if (advanced)
+    fromFile.stepDown = advanced->m_videoDVStepDown;
+  const int forced = CDVEngineSettings::Resolve(read, fromFile).stepForced;
+  return forced >= 0 ? forced : (fast ? 1 : 0);
+}
