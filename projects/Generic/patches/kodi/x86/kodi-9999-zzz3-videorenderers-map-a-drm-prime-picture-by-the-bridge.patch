+#ifdef HAVE_DVBRIDGE
+bool CRendererDRMPRIMEGLES::LibplaceboKneeWanted() const
+{
+  return m_videoSettings.m_ToneMapMethod == VS_TONEMAPMETHOD_BT2390_LIBPLACEBO;
