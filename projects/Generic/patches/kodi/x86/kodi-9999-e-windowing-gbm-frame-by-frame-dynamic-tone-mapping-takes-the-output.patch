+bool DVBRIDGE::DtmToSdr()
+{
+  const auto settings = SettingsNow();
+  return settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDTMSDR) &&
+         settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESDTMSDR);
+}
+
+bool DVBRIDGE::DtmToHdr()
+{
+  const auto settings = SettingsNow();
+  return settings && settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDTMHDR) &&
+         settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESDTMHDR);
+}
+
+bool DVBRIDGE::DtmTakesOutput()
+{
+  return DtmToSdr() || DtmToHdr();
+}
+
+int DVBRIDGE::ToneMapMethodOf(int method)
+{
+  // Hades: the curve of the branch that is on takes the place of the video's tone mapping method
+  // at every place that asks by it; without the branches, the choice of the video is the authority
+  // again
+  if (!DtmTakesOutput())
+    return method;
+  const bool sdr = DtmToSdr();
+  const auto settings = SettingsNow();
+  const char* const curve = sdr ? CSettings::SETTING_VIDEOSCREEN_HADESDTMSDRCURVE
+                                : CSettings::SETTING_VIDEOSCREEN_HADESDTMHDRCURVE;
+  return settings && settings->GetSetting(curve) && settings->GetInt(curve) == 2
+             ? VS_TONEMAPMETHOD_BT2390_LIBPLACEBO
+             : VS_TONEMAPMETHOD_BT2390;
+}
