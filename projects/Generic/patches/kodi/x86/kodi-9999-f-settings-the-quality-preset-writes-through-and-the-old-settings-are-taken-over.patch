+// Hades: the value that guisettings.xml has for a setting that this build no longer defines (an
+// earlier build saved it): read once, when the settings are loaded, to take the choice over
+std::string OldSettingXmlValue(const TiXmlElement* root, const char* id)
+{
+  if (!root)
+    return "";
+  for (const auto* element = root->FirstChildElement("setting"); element;
+       element = element->NextSiblingElement("setting"))
+  {
+    const char* const saved = element->Attribute("id");
+    if (saved && StringUtils::EqualsNoCase(saved, id))
+    {
+      const char* const value = element->GetText();
+      return value ? value : "";
+    }
+  }
+  return "";
+}
+
+// Hades: what a user chose in an earlier build is taken over by the settings of frame-by-frame
+// dynamic tone mapping, once, when the settings are loaded: the projector's way of mapping to SDR
+// (videoscreen.hadesdvsdrtarget 2 or 3) turns the SDR branch on and carries its white and its
+// gamma; three settings that only an earlier build defined (its gamut, its curve and its contrast
+// recovery) are read from the file as it was saved; and the curve of the HDR10 adaptation is
+// carried to the curve of the HDR branch. A setting is only written while it is at its default:
+// what was chosen in this build stays, and what is taken over is taken over only once.
+bool MigrateDtmBranches(CSettingsManager& manager, const TiXmlElement* root)
+{
+  bool changed = false;
+  const auto sdr =
+      std::dynamic_pointer_cast<CSettingBool>(manager.GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDTMSDR));
+  const auto target =
+      std::dynamic_pointer_cast<CSettingInt>(manager.GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVSDRTARGET));
+  if (sdr && target && !sdr->GetValue() &&
+      (target->GetValue() == 2 || target->GetValue() == 3))
+  {
+    const int oldTarget = target->GetValue();
+    if (sdr->SetValue(true))
+      changed = true;
+    const auto oldWhite =
+        std::dynamic_pointer_cast<CSettingInt>(manager.GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVSDRWHITE));
+    const auto white =
+        std::dynamic_pointer_cast<CSettingInt>(manager.GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDTMSDRWHITE));
+    if (oldWhite && white && white->GetValue() == white->GetDefault() &&
+        oldWhite->GetValue() != white->GetDefault() && white->SetValue(oldWhite->GetValue()))
+      changed = true;
+    const auto oldGamma =
+        std::dynamic_pointer_cast<CSettingNumber>(manager.GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVSDRGAMMA));
+    const auto gamma =
+        std::dynamic_pointer_cast<CSettingNumber>(manager.GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDTMSDRGAMMA));
+    if (oldGamma && gamma && gamma->GetValue() == gamma->GetDefault() &&
+        oldGamma->GetValue() != gamma->GetDefault() && gamma->SetValue(oldGamma->GetValue()))
+      changed = true;
+    for (const auto& carry :
+         {std::pair<const char*, const char*>{"videoscreen.hadesdvsdrgamut",
+                                              CSettings::SETTING_VIDEOSCREEN_HADESDTMSDRGAMUT},
+          {"videoscreen.hadesdvsdrcurve", CSettings::SETTING_VIDEOSCREEN_HADESDTMSDRCURVE},
+          {"videoscreen.hadesdtmrecovery", CSettings::SETTING_VIDEOSCREEN_HADESDTMSDRRECOVERY}})
+    {
+      const std::string value = OldSettingXmlValue(root, carry.first);
+      if (value.empty() || value.find_first_not_of("0123456789") != std::string::npos)
+        continue;
+      const auto to = std::dynamic_pointer_cast<CSettingInt>(manager.GetSetting(carry.second));
+      if (to && to->GetValue() == to->GetDefault() && std::stoi(value) != to->GetDefault() &&
+          to->SetValue(std::stoi(value)))
+        changed = true;
+    }
+    // (the choice of the earlier build is spent, whatever the branch is set to later: it is not
+    // taken over again at the next start)
+    if (target->GetValue() != 0 && target->SetValue(0))
+      changed = true;
+    CLog::Log(LOGINFO,
+              "CSettings: \"{}\" takes over \"{}\" ({}), which an earlier build saved",
+              CSettings::SETTING_VIDEOSCREEN_HADESDTMSDR, CSettings::SETTING_VIDEOSCREEN_HADESDVSDRTARGET,
+              oldTarget);
+  }
+  const auto oldCurve =
+      std::dynamic_pointer_cast<CSettingInt>(manager.GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDVHDR10CURVE));
+  const auto curve =
+      std::dynamic_pointer_cast<CSettingInt>(manager.GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDTMHDRCURVE));
+  if (oldCurve && curve && curve->GetValue() == curve->GetDefault() &&
+      oldCurve->GetValue() != curve->GetDefault() && curve->SetValue(oldCurve->GetValue()))
+    changed = true;
+  return changed;
+}
