+// Hades: the quality preset (videoscreen.hadesqualitypreset) writes what it stands for through to
+// the four settings of the engine that hold it; a manual change of one of them is only said in the
+// log: the last one written wins
+class CQualityPresetSync : public ISettingCallback
+{
+public:
+  void OnSettingChanged(const std::shared_ptr<const CSetting>& setting) override
+  {
+    if (!setting)
+      return;
+    const auto component = CServiceBroker::GetSettingsComponent();
+    const auto settings = component ? component->GetSettings() : nullptr;
+    if (!settings)
+      return;
+    if (setting->GetId() == CSettings::SETTING_VIDEOSCREEN_HADESQUALITYPRESET)
+    {
+      const auto preset = std::dynamic_pointer_cast<const CSettingInt>(setting);
+      if (preset)
+        WriteThrough(*settings, preset->GetValue());
+      return;
+    }
+    if (m_writing)
+      return;
+    for (const char* const id :
+         {CSettings::SETTING_VIDEOSCREEN_HADESDVASHDR10FEL,
+          CSettings::SETTING_VIDEOSCREEN_HADESDVCOMPOSER,
+          CSettings::SETTING_VIDEOSCREEN_HADESDVGAMUTFINE,
+          CSettings::SETTING_VIDEOSCREEN_HADESDVSTEPMODE})
+      if (setting->GetId() == id)
+      {
+        CLog::Log(LOGINFO, "quality preset: {} overridden by manual change of {}",
+                  settings->GetInt(CSettings::SETTING_VIDEOSCREEN_HADESQUALITYPRESET), id);
+        break;
+      }
+  }
+
+private:
+  void WriteThrough(CSettings& settings, int preset)
+  {
+    // (the two higher presets turn the FEL reconstruction and the finer gamut table on, and the
+    // composition stays with ETSI GS CCM 001; the highest locks the fidelity, so that no picture
+    // is drawn with less than the film has)
+    const bool high = preset >= 1;
+    m_writing = true;
+    settings.SetBool(CSettings::SETTING_VIDEOSCREEN_HADESDVASHDR10FEL, high);
+    settings.SetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVCOMPOSER, 0);
+    settings.SetBool(CSettings::SETTING_VIDEOSCREEN_HADESDVGAMUTFINE, high);
+    settings.SetInt(CSettings::SETTING_VIDEOSCREEN_HADESDVSTEPMODE, preset == 2 ? 1 : 0);
+    m_writing = false;
+    CLog::Log(LOGINFO, "quality preset: {} (FEL reconstruction {}, gamut table {}, fidelity {})",
+              preset == 2   ? "ultra"
+              : preset == 1 ? "high"
+                            : "standard",
+              high ? "on" : "off", high ? "fine" : "coarse",
+              preset == 2 ? "locked" : "automatic");
+  }
+
+  bool m_writing = false;
+};
+CQualityPresetSync g_qualityPresetSync;
 } // namespace
 #endif
 
