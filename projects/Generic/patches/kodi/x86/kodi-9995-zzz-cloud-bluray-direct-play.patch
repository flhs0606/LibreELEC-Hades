+namespace
+{
+class BdCloseWorker
+{
+public:
+  static BdCloseWorker& Instance()
+  {
+    static BdCloseWorker instance;
+    return instance;
+  }
+
+  void Submit(BLURAY* bd)
+  {
+    if (!bd)
+      return;
+    {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      m_queue.push(bd);
+    }
+    m_cv.notify_one();
+  }
+
+  void WaitForIdle()
+  {
+    std::unique_lock<std::mutex> lock(m_mutex);
+    if (m_queue.empty() && !m_busy)
+      return;
+    const auto t_start = std::chrono::steady_clock::now();
+    const bool ok = m_idleCv.wait_for(lock, std::chrono::seconds(15),
+                                      [this] { return m_queue.empty() && !m_busy; });
+    const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                        std::chrono::steady_clock::now() - t_start).count();
+    if (ok)
+      CLog::Log(LOGDEBUG, "BdCloseWorker::WaitForIdle - waited {}ms for prior bd_close", ms);
+    else
+      CLog::Log(LOGWARNING,
+                "BdCloseWorker::WaitForIdle - 15s timeout, proceeding (worker may be stuck)");
+  }
+
+  ~BdCloseWorker()
+  {
+    {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      m_stopping = true;
+    }
+    m_cv.notify_one();
+    if (m_thread.joinable())
+      m_thread.join();
+  }
+
+private:
+  BdCloseWorker() : m_thread(&BdCloseWorker::Run, this) {}
+
+  void Run()
+  {
+    while (true)
+    {
+      BLURAY* bd = nullptr;
+      {
+        std::unique_lock<std::mutex> lock(m_mutex);
+        m_cv.wait(lock, [this] { return m_stopping || !m_queue.empty(); });
+        if (m_queue.empty())
+          return;
+        bd = m_queue.front();
+        m_queue.pop();
+        m_busy = true;
+      }
+
+      const auto t_start = std::chrono::steady_clock::now();
+      try
+      {
+        bd_close(bd);
+      }
+      catch (...)
+      {
+        CLog::Log(LOGERROR, "BdCloseWorker::Run - bd_close threw");
+      }
+      const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                          std::chrono::steady_clock::now() - t_start).count();
+      CLog::Log(LOGDEBUG, "BdCloseWorker::Run - bd_close completed in {}ms", ms);
+
+      {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_busy = false;
+      }
+      m_idleCv.notify_all();
+    }
+  }
+
+  std::mutex m_mutex;
+  std::condition_variable m_cv;
+  std::condition_variable m_idleCv;
+  std::queue<BLURAY*> m_queue;
+  bool m_busy{false};
+  bool m_stopping{false};
+  std::thread m_thread;
+};
+}
