+bool DVBRIDGE::DtmFast()
+{
+  // Hades: the fast mode of the mapping (videoscreen.hadesdtmfast): while one of its
+  // branches takes the output, what the quality preset manages is not asked: the engine, the
+  // bridge and the codec take the matrix of the fast mode in its place (the composition of
+  // libplacebo, the coarser gamut mapping table, the fidelity step-down left to choose
+  // itself, the residual of a full enhancement layer left undecoded, the measurement of
+  // every other picture); with the mapping off it is nothing
+  const auto settings = SettingsNow();
+  return DtmTakesOutput() && settings &&
+         settings->GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDTMFAST) &&
+         settings->GetBool(CSettings::SETTING_VIDEOSCREEN_HADESDTMFAST);
 }
 
