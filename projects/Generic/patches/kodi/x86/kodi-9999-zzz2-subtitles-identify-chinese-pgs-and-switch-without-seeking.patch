diff --git a/cmake/modules/FindONNXRuntime.cmake b/cmake/modules/FindONNXRuntime.cmake
new file mode 100644
index 0000000..0fbb53d
--- /dev/null
+++ b/cmake/modules/FindONNXRuntime.cmake
@@ -0,0 +1,33 @@
+#.rst:
+# FindONNXRuntime
+# ---------------
+# Finds the ONNX Runtime C/C++ library for optional CPU PGS subtitle OCR.
+#
+# This will define the following target:
+#
+#   ${APP_NAME_LC}::ONNXRuntime - The ONNX Runtime library
+
+if(NOT TARGET ${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME})
+  find_path(ONNXRUNTIME_INCLUDE_DIR onnxruntime_cxx_api.h
+                                    PATH_SUFFIXES onnxruntime
+                                    HINTS ${DEPENDS_PATH}/include)
+  find_library(ONNXRUNTIME_LIBRARY NAMES onnxruntime
+                                   HINTS ${DEPENDS_PATH}/lib)
+
+  if(NOT VERBOSE_FIND)
+    set(${CMAKE_FIND_PACKAGE_NAME}_FIND_QUIETLY TRUE)
+  endif()
+
+  include(FindPackageHandleStandardArgs)
+  find_package_handle_standard_args(ONNXRuntime
+                                    REQUIRED_VARS ONNXRUNTIME_LIBRARY ONNXRUNTIME_INCLUDE_DIR)
+
+  if(ONNXRUNTIME_FOUND)
+    add_library(${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME} UNKNOWN IMPORTED)
+    set_target_properties(${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME} PROPERTIES
+                          IMPORTED_LOCATION "${ONNXRUNTIME_LIBRARY}"
+                          INTERFACE_INCLUDE_DIRECTORIES "${ONNXRUNTIME_INCLUDE_DIR}"
+                          INTERFACE_COMPILE_DEFINITIONS HAS_PGS_OCR=1)
+  endif()
+  mark_as_advanced(ONNXRUNTIME_INCLUDE_DIR ONNXRUNTIME_LIBRARY)
+endif()
