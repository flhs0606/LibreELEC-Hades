+static bool contains_cp(const char* text, int cp)
+{
+  std::string_view s(text);
+  while (!s.empty())
+  {
+    int c = next_utf8(s);
+    if (c == cp)
+      return true;
+  }
+  return false;
+}
+
+void pgs_sub_script_feed(struct pgs_sub_script_evidence* e, const char* text, int confidence)
+{
+  if (!text || confidence < 55 || e->confirmed != PGS_SUB_SCRIPT_UNKNOWN)
+    return;
+  uint64_t hash = 14695981039346656037ULL;
+  for (const unsigned char* s = (const unsigned char*)text; *s; s++)
+    hash = (hash ^ *s) * 1099511628211ULL;
+  for (int n = 0; n < 8; n++)
+  {
+    if (e->recent[n] == hash)
+      return;
+  }
+  e->recent[e->next_recent++ % 8] = hash;
+  e->captions++;
+  uint32_t caption_seen[128];
+  int num_caption_seen = 0, caption_sim = 0, caption_tra = 0;
+  std::string_view s(text);
+  while (!s.empty())
+  {
+    int cp = next_utf8(s);
+    if (cp < 0)
+    {
+      continue;
+    }
+    bool sim = contains_cp(simplified, cp);
+    bool tra = contains_cp(traditional, cp);
+    if (sim == tra)
+      continue;
+    // Count in OCR reading order, across deduplicated captions. Shared
+    // characters do not interrupt a run; the opposite script restarts it.
+    // Once confirmed, later bilingual sampling must not change the script.
+    if (e->confirmed == PGS_SUB_SCRIPT_UNKNOWN)
+    {
+      enum pgs_sub_script script = sim ? PGS_SUB_SCRIPT_SIMPLIFIED : PGS_SUB_SCRIPT_TRADITIONAL;
+      e->run_chars = e->run_script == script ? e->run_chars + 1 : 1;
+      e->run_script = script;
+      if (e->run_chars >= PGS_SUB_SCRIPT_CONFIRM_CHARS)
+        e->confirmed = script;
+    }
+    // Retain unique-glyph and per-caption counts for diagnostics only.
+    // Classification depends solely on the ordered character run above.
+    bool caption_repeat = false;
+    for (int n = 0; n < num_caption_seen; n++)
+      caption_repeat |= caption_seen[n] == static_cast<uint32_t>(cp);
+    if (!caption_repeat && num_caption_seen < 128)
+    {
+      caption_seen[num_caption_seen++] = cp;
+      caption_sim += sim;
+      caption_tra += tra;
+    }
+    bool seen = false;
+    for (int n = 0; n < e->num_seen; n++)
+      seen |= e->seen[n] == static_cast<uint32_t>(cp);
+    if (seen || e->num_seen >= 128)
+      continue;
+    e->seen[e->num_seen++] = cp;
+    e->simplified += sim;
+    e->traditional += tra;
+  }
+  e->simplified_captions += caption_sim > 0 && caption_sim >= 2 * caption_tra;
+  e->traditional_captions += caption_tra > 0 && caption_tra >= 2 * caption_sim;
+  e->last_caption = caption_sim > 0 && caption_sim >= 2 * caption_tra   ? PGS_SUB_SCRIPT_SIMPLIFIED
+                    : caption_tra > 0 && caption_tra >= 2 * caption_sim ? PGS_SUB_SCRIPT_TRADITIONAL
+                                                                        : PGS_SUB_SCRIPT_UNKNOWN;
+}
+
+enum pgs_sub_script pgs_sub_script_result(const struct pgs_sub_script_evidence* e)
+{
+  return e->confirmed;
+}
+
+bool pgs_sub_script_confirm(struct pgs_sub_script_confirmation* s,
+                            const struct pgs_sub_script_evidence* e)
+{
+  s->observed_captions = e->captions;
+  s->candidate = e->run_script;
+  s->streak = e->run_chars;
+  return e->confirmed != PGS_SUB_SCRIPT_UNKNOWN;
+}
+
+static bool has_ci(const char* text, const char* needle)
+{
+  if (!text)
+    return false;
+  std::string_view s(text), n(needle);
+  for (size_t i = 0; i + n.size() <= s.size(); ++i)
+  {
+    if (equal_ci(s.substr(i, n.size()), n))
+      return true;
+  }
+  return false;
+}
+
+static bool ascii_word(unsigned char c)
+{
+  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
+}
+
+static bool token_ci(const char* text, const char* needle)
+{
+  if (!text)
+    return false;
+  size_t len = strlen(needle), total = strlen(text);
+  for (size_t n = 0; n + len <= total; n++)
+  {
+    if ((!n || !ascii_word(text[n - 1])) && (n + len == total || !ascii_word(text[n + len])) &&
+        equal_ci(std::string_view(text).substr(n, len), needle))
+      return true;
+  }
+  return false;
+}
+
+void pgs_subtitle_info_from_metadata(struct pgs_subtitle_info* i,
+                                     const char* lang,
+                                     const char* title,
+                                     bool forced)
+{
+  *i = {};
+  i->active = true;
+  i->forced = forced;
+  // Track titles often abbreviate the script and language pair (e.g.
+  // 简英双字特效 / 繁英雙字特效). Read this before metadata-only
+  // completion; generic "双语" does not establish English as the second language.
+  bool sim_en = has_ci(title, "简英") || has_ci(title, "簡英");
+  bool tra_en = has_ci(title, "繁英");
+  i->bilingual = sim_en || tra_en || has_ci(title, "中英");
+  bool hans = has_ci(lang, "hans"), hant = has_ci(lang, "hant");
+  bool explicit_script = hans || hant;
+  bool title_sim = sim_en || has_ci(title, "简体") || has_ci(title, "簡體") ||
+                   has_ci(title, "simplified") || token_ci(title, "chs");
+  bool title_tra = tra_en || has_ci(title, "繁体") || has_ci(title, "繁體") ||
+                   has_ci(title, "traditional") || token_ci(title, "cht");
+  bool sim =
+      hans || title_sim || (!explicit_script && (has_ci(lang, "zh-cn") || has_ci(lang, "zh-sg")));
+  bool tra =
+      hant || title_tra || (!explicit_script && (has_ci(lang, "zh-tw") || has_ci(lang, "zh-hk")));
+  i->script = sim && tra ? PGS_SUB_SCRIPT_UNKNOWN
+              : sim      ? PGS_SUB_SCRIPT_SIMPLIFIED
+              : tra      ? PGS_SUB_SCRIPT_TRADITIONAL
+                         : PGS_SUB_SCRIPT_UNKNOWN;
+  i->script_from_title = sim != tra;
+  // A useful explicit track name is authoritative. Keep it verbatim and
+  // do not spend OCR work guessing additional traits that it does not claim.
+  // A language tag alone or a generic "Chinese" title is not such a name.
+  i->descriptive_title = i->script_from_title && (title_sim || title_tra || i->bilingual);
+  i->forced |=
+      (token_ci(title, "forced") && !has_ci(title, "non-forced") && !has_ci(title, "not forced")) ||
+      has_ci(title, "强制") || has_ci(title, "強制");
+  i->signs_from_title = token_ci(title, "signs") || has_ci(title, "局部翻译") ||
+                        has_ci(title, "局部翻譯") || has_ci(title, "标牌") || has_ci(title, "標牌");
+}
+
+const char* pgs_sub_script_name(enum pgs_sub_script s)
+{
+  switch (s)
+  {
+    case PGS_SUB_SCRIPT_SIMPLIFIED:
+      return "simplified";
+    case PGS_SUB_SCRIPT_TRADITIONAL:
+      return "traditional";
+    case PGS_SUB_SCRIPT_MIXED:
+      return "mixed";
+    default:
+      return "unknown";
+  }
+}
+
+// A Latin word alone (a name, logo or OCR noise) is not an English caption.
+int pgs_sub_word_language(const char* text, struct pgs_sub_caption_language* caption)
+{
+  int han = 0, latin = 0;
+  std::string_view s(text);
+  while (!s.empty())
+  {
+    int cp = next_utf8(s);
+    if (cp < 0)
+    {
+      continue;
+    }
+    han += (cp >= 0x3400 && cp <= 0x9fff) || (cp >= 0x20000 && cp <= 0x2fa1f);
+    latin += (cp >= 'A' && cp <= 'Z') || (cp >= 'a' && cp <= 'z');
+  }
+  if (han && !latin)
+  {
+    caption->han_chars += han;
+    return 0;
+  }
+  if (!han && latin >= 2)
+  {
+    caption->latin_letters += latin;
+    caption->latin_words++;
+    return 1;
+  }
+  return -1;
+}
+
+void pgs_sub_line_language(const char* text, int line, int minimumConfidence,
+                           struct pgs_sub_caption_language* caption)
+{
+  if (line != 1 || minimumConfidence < 70)
+    return;
+  int letters = 0;
+  std::string_view s(text);
+  while (!s.empty())
+  {
+    const int cp = next_utf8(s);
+    if ((cp >= 'A' && cp <= 'Z') || (cp >= 'a' && cp <= 'z'))
+      ++letters;
+    else if (!((cp >= 0x20 && cp <= 0x40) || (cp >= 0x5b && cp <= 0x60) ||
+               (cp >= 0x7b && cp <= 0x7e) || (cp >= 0x2010 && cp <= 0x2026)))
+      return; // Includes Han, other scripts and invalid UTF-8.
+  }
+  // A single letter is too little evidence; short words such as "No!" count.
+  caption->english_second_line |= letters >= 2;
+}
+
+int pgs_sub_candidate_language(const std::string& language, const std::string& title)
+{
+  std::string primary = language.substr(0, language.find_first_of("-_"));
+  for (char& c : primary)
+    if (c >= 'A' && c <= 'Z')
+      c += 'a' - 'A';
+  constexpr const char* chinese[] = {"zh",  "chi", "zho", "cmn", "yue",
+                                     "wuu", "nan", "hak", "hsn", "gan"};
+  for (const auto* code : chinese)
+    if (primary == code)
+      return 1;
+  if (title.find("中文") != std::string::npos || title.find("中字") != std::string::npos)
+    return 1;
+  if (primary.empty() || primary == "und" || primary == "unk" || primary == "unknown")
+    return 2;
+  return 0;
+}
+
+bool pgs_sub_matches_preference(const pgs_subtitle_info& info, int preference)
+{
+  if (!info.active || preference < 0 || preference > 3)
+    return false;
+  const auto script = preference % 2 == 0 ? PGS_SUB_SCRIPT_SIMPLIFIED : PGS_SUB_SCRIPT_TRADITIONAL;
+  return info.script == script && (preference >= 2 ? info.bilingual :
+      (!info.bilingual && (info.descriptive_title || info.sampled)));
+}
+
+int pgs_sub_select_preference(const std::vector<pgs_subtitle_info>& candidates,
+                              int preference, int current)
+{
+  if (preference < 0 || preference > 3) return -1;
+  const auto find = [&](int type)
+  {
+    if (current >= 0 && current < static_cast<int>(candidates.size()) &&
+        pgs_sub_matches_preference(candidates[current], type))
+      return current;
+    for (size_t i = 0; i < candidates.size(); ++i)
+      if (pgs_sub_matches_preference(candidates[i], type)) return static_cast<int>(i);
+    return -1;
+  };
+  const int exact = find(preference);
+  if (exact >= 0) return exact;
+  const auto script = preference % 2 == 0 ? PGS_SUB_SCRIPT_SIMPLIFIED : PGS_SUB_SCRIPT_TRADITIONAL;
+  for (const auto& info : candidates)
+  {
+    if (!info.active || info.sampled || info.descriptive_title) continue;
+    if (info.script != PGS_SUB_SCRIPT_UNKNOWN && info.script != script) continue;
+    // Confirmed English cannot become a monolingual candidate later.
+    if (preference < 2 && info.bilingual) continue;
+    return -1;
+  }
+  return find(preference ^ 2); // Simplified <-> Simplified/English; same for Traditional.
+}
+
+int pgs_sub_priority(const pgs_subtitle_info& info, bool chinese, bool multiline, int preference)
+{
+  const auto wanted = preference % 2 == 0 ? PGS_SUB_SCRIPT_SIMPLIFIED : PGS_SUB_SCRIPT_TRADITIONAL;
+  const int layout = (preference >= 2 ? !multiline : multiline) ? 8 : 0;
+  const int script = info.script == wanted ? 0 : info.script == PGS_SUB_SCRIPT_UNKNOWN ? 2 : 4;
+  return layout + script + (chinese ? 0 : 1);
+}
+
+void pgs_sub_bilingual_feed(struct pgs_sub_bilingual_evidence* e,
+                            const struct pgs_sub_caption_language* c,
+                            struct pgs_subtitle_info* info)
+{
+  e->english_line |= c->english_second_line;
+  e->chinese |= c->han_chars >= 2;
+  info->bilingual |= e->english_line && (e->chinese || info->script_from_title ||
+                                       info->script != PGS_SUB_SCRIPT_UNKNOWN);
+  if (c->han_chars < 4 || c->latin_letters < 8 || c->latin_words < 2)
+    return;
+  e->bilingual++;
+  info->bilingual |= e->bilingual >= 3;
+}
+
+// A useful explicit description is preserved verbatim, as in mpv.
+bool pgs_metadata_describes(const char* lang, const char* title)
+{
+  pgs_subtitle_info info{};
+  pgs_subtitle_info_from_metadata(&info, lang, title, false);
+  return info.descriptive_title;
+}
+
+std::string pgs_subtitle_info_label(const pgs_subtitle_info& info,
+                                    std::string (*translate)(uint32_t))
+{
+  uint32_t script = info.script == PGS_SUB_SCRIPT_SIMPLIFIED    ? 44400
+                    : info.script == PGS_SUB_SCRIPT_TRADITIONAL ? 44401
+                    : info.script == PGS_SUB_SCRIPT_MIXED       ? 44407
+                                                                : 44408;
+  if (info.bilingual)
+  {
+    script = info.script == PGS_SUB_SCRIPT_SIMPLIFIED    ? 44402
+             : info.script == PGS_SUB_SCRIPT_TRADITIONAL ? 44403
+                                                         : 44404;
+  }
+  std::string label = translate(script);
+  if (info.signs_from_title)
+    label += " · " + translate(44412);
+  if (info.forced)
+    label += " · " + translate(44413);
+  return label;
+}
+
+// Continue inspecting forced-object PCS bits after expensive analysis settles.
+// This does not change the container's forced disposition or track selection.
+bool pgs_packet_has_forced(const uint8_t* data, size_t size)
+{
+  size_t pos = 0;
+  while (size - pos >= 3)
+  {
+    const int type = data[pos];
+    const size_t len = (static_cast<size_t>(data[pos + 1]) << 8) | data[pos + 2];
+    pos += 3;
+    if (len > size - pos)
+      break;
+    const uint8_t* s = data + pos;
+    if (type == 0x16 && len >= 11)
+    {
+      size_t n = 11;
+      for (int i = 0; i < s[10] && len - n >= 8; ++i)
+      {
+        const int flags = s[n + 3];
+        if (flags & 0x40)
+          return true;
+        const size_t bytes = flags & 0x80 ? 16 : 8;
+        if (bytes > len - n)
+          break;
+        n += bytes;
+      }
+    }
+    pos += len;
+  }
+  return false;
+}
+
+bool pgs_packet_has_objects(const uint8_t* data, size_t size)
+{
+  size_t pos = 0;
+  while (size - pos >= 3)
+  {
+    const int type = data[pos];
+    const size_t length = (static_cast<size_t>(data[pos + 1]) << 8) | data[pos + 2];
+    pos += 3;
+    if (length > size - pos)
+      return false;
+    if (type == 0x16 && length >= 11)
+    {
+      const unsigned count = data[pos + 10];
+      if (count && length >= 11 + count * 8)
+        return true;
+    }
+    pos += length;
+  }
+  return false;
+}
diff --git a/xbmc/cores/VideoPlayer/DVDSubtitles/PGSIdentify.h b/xbmc/cores/VideoPlayer/DVDSubtitles/PGSIdentify.h
new file mode 100644
index 0000000..3757cb1
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/PGSIdentify.h
@@ -0,0 +1,103 @@
+/*
+ * This file is part of mpv.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#ifndef KODI_PGS_IDENTIFY_H
+#define KODI_PGS_IDENTIFY_H
+
+#include <cstddef>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+enum pgs_sub_script
+{
+  PGS_SUB_SCRIPT_UNKNOWN,
+  PGS_SUB_SCRIPT_SIMPLIFIED,
+  PGS_SUB_SCRIPT_TRADITIONAL,
+  PGS_SUB_SCRIPT_MIXED,
+};
+
+#define PGS_SUB_SCRIPT_CONFIRM_CHARS 5
+
+struct pgs_sub_script_evidence
+{
+  uint32_t seen[128];
+  int num_seen, simplified, traditional, captions;
+  int simplified_captions, traditional_captions;
+  enum pgs_sub_script last_caption;
+  enum pgs_sub_script run_script, confirmed;
+  int run_chars;
+  uint64_t recent[8];
+  unsigned next_recent;
+};
+
+struct pgs_sub_script_confirmation
+{
+  enum pgs_sub_script candidate;
+  int observed_captions, streak;
+};
+
+// Five consecutive script-specific characters; shared characters do not vote.
+bool pgs_sub_script_confirm(struct pgs_sub_script_confirmation* state,
+                            const struct pgs_sub_script_evidence* evidence);
+
+struct pgs_subtitle_info
+{
+  bool active;
+  enum pgs_sub_script script;
+  bool script_from_title;
+  bool descriptive_title;
+  bool bilingual; // separate English line or repeated mixed-caption evidence
+  bool forced; // container/title or at least one PGS forced object
+  bool signs_from_title;
+  bool ocr_available;
+  bool sampled; // Sampling finished (confirmed or budget); not a full scan
+  int samples;
+};
+
+// Per-caption language counts from confident OCR tokens.
+struct pgs_sub_caption_language
+{
+  int han_chars, latin_letters, latin_words;
+  bool english_second_line;
+};
+struct pgs_sub_bilingual_evidence
+{
+  int bilingual;
+  bool english_line, chinese;
+};
+int pgs_sub_word_language(const char* text, struct pgs_sub_caption_language* caption);
+// Second physical text line: confident ASCII English, allowing punctuation/digits.
+void pgs_sub_line_language(const char* text, int line, int minimumConfidence,
+                           struct pgs_sub_caption_language* caption);
+// 0: not a candidate; 1: Chinese; 2: unknown language. Shared by registration and selection.
+int pgs_sub_candidate_language(const std::string& language, const std::string& title);
+bool pgs_sub_matches_preference(const pgs_subtitle_info& info, int preference);
+// Exact type first; paired mono/bilingual fallback only after potential exact
+// candidates finish. The indices correspond to the player's subtitle list.
+int pgs_sub_select_preference(const std::vector<pgs_subtitle_info>& candidates,
+                              int preference, int current);
+int pgs_sub_priority(const pgs_subtitle_info& info, bool chinese, bool multiline, int preference);
+void pgs_sub_bilingual_feed(struct pgs_sub_bilingual_evidence* e,
+                            const struct pgs_sub_caption_language* caption,
+                            struct pgs_subtitle_info* info);
+
+void pgs_sub_script_feed(struct pgs_sub_script_evidence* e, const char* text, int confidence);
+enum pgs_sub_script pgs_sub_script_result(const struct pgs_sub_script_evidence* e);
+void pgs_subtitle_info_from_metadata(struct pgs_subtitle_info* info,
+                                     const char* lang,
+                                     const char* title,
+                                     bool forced);
+const char* pgs_sub_script_name(enum pgs_sub_script script);
+
+// Same label composition as mpv; localization is supplied by the caller.
+std::string pgs_subtitle_info_label(const pgs_subtitle_info& info,
+                                    std::string (*translate)(uint32_t));
+bool pgs_metadata_describes(const char* lang, const char* title);
+bool pgs_packet_has_forced(const uint8_t* data, size_t size);
+// A nonempty PCS is data activity even when no usable OCR characters result.
+bool pgs_packet_has_objects(const uint8_t* data, size_t size);
+#endif
diff --git a/xbmc/cores/VideoPlayer/DVDSubtitles/PGSLayout.h b/xbmc/cores/VideoPlayer/DVDSubtitles/PGSLayout.h
new file mode 100644
index 0000000..4dfbf06
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/PGSLayout.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+struct PGSTextBand
+{
+  int x0, y0, x1, y1;
+};
+// Horizontal PGS captions already specify where their text is located.
+inline std::vector<PGSTextBand> PGSFindLines(const uint8_t* img, int w, int h)
+{
+  std::vector<PGSTextBand> found;
+  int last = -100;
+  for (int y = 0; y < h; y++)
+  {
+    int count = 0;
+    for (int x = 0; x < w; x++)
+      count += img[y * w + x] < 230;
+    if (count < 2)
+      continue;
+    if (y - last > 4)
+      found.push_back({w, y, 0, y + 1});
+    else
+      found.back().y1 = y + 1;
+    last = y;
+  }
+  std::vector<PGSTextBand> result;
+  for (auto b : found)
+  {
+    if (b.y1 - b.y0 < 8)
+      continue;
+    for (int y = b.y0; y < b.y1; y++)
+      for (int x = 0; x < w; x++)
+        if (img[y * w + x] < 230)
+        {
+          b.x0 = std::min(b.x0, x);
+          b.x1 = std::max(b.x1, x + 1);
+        }
+    if (b.x0 < b.x1)
+      result.push_back(b);
+  }
+  return result;
+}
diff --git a/xbmc/cores/VideoPlayer/DVDSubtitles/PGSOcr.cpp b/xbmc/cores/VideoPlayer/DVDSubtitles/PGSOcr.cpp
new file mode 100644
index 0000000..d968b58
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDSubtitles/PGSOcr.cpp
@@ -0,0 +1,299 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// PP-OCRv5 mobile CTC inference on an already decoded PGS bitmap. No network,
+// detector, Python, platform OCR API or colour conversion is involved.
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#if defined(__MINGW32__) && !defined(_stdcall)
+// The official Windows ORT headers use the MSVC spelling in strict C++ mode.
+#define _stdcall __stdcall
+#define MP_UNDEF_ORT_STDCALL
+#endif
+#include <onnxruntime_cxx_api.h>
+#ifdef MP_UNDEF_ORT_STDCALL
+#undef _stdcall
+#undef MP_UNDEF_ORT_STDCALL
+#endif
+#include "PGSOcr.h"
+#include "PGSLayout.h"
+
+extern "C" FILE* pgs_ocr_open_file(const char* path)
+{
+  return std::fopen(path, "rb");
+}
+
+namespace
+{
+constexpr int max_width = 4096;
+struct file_closer
+{
+  void operator()(FILE* file) const { std::fclose(file); }
+};
+struct engine
+{
+  Ort::Env env{ORT_LOGGING_LEVEL_WARNING, "kodi-pgs-ocr"};
+  Ort::Session session{nullptr};
+  Ort::RunOptions run_options;
+  std::vector<std::string> chars;
+  std::string input, output;
+  explicit engine(const char* dir)
+  {
+    std::string path = std::string(dir) + "/ppocrv5-mobile-rec-int8.onnx";
+    std::unique_ptr<FILE, file_closer> file(pgs_ocr_open_file(path.c_str()));
+    if (!file || fseek(file.get(), 0, SEEK_END))
+      throw std::runtime_error("OCR model unavailable");
+    long size = ftell(file.get());
+    if (size <= 0 || size > 32 * 1024 * 1024 || fseek(file.get(), 0, SEEK_SET))
+      throw std::runtime_error("Invalid OCR model size");
+    std::vector<uint8_t> model(size);
+    if (fread(model.data(), 1, size, file.get()) != static_cast<size_t>(size))
+      throw std::runtime_error("Short OCR model read");
+    env.DisableTelemetryEvents();
+    Ort::SessionOptions opts;
+    // Two threads within one inference, sharing a single model/session. Keep
+    // inter-op sequential so the two levels cannot multiply the CPU budget.
+    opts.SetIntraOpNumThreads(2);
+    opts.SetInterOpNumThreads(1);
+    opts.SetExecutionMode(ExecutionMode::ORT_SEQUENTIAL);
+    opts.AddConfigEntry("session.intra_op.allow_spinning", "0");
+    opts.AddConfigEntry("session.inter_op.allow_spinning", "0");
+    // PGS line widths change constantly. Do not retain every temporary
+    // tensor allocation until the full track sampling is complete.
+    opts.DisableCpuMemArena();
+    opts.DisableMemPattern();
+    session = Ort::Session(env, model.data(), model.size(), opts);
+    Ort::AllocatorWithDefaultOptions alloc;
+    auto dict = session.GetModelMetadata().LookupCustomMetadataMapAllocated("character", alloc);
+    if (!dict)
+      throw std::runtime_error("OCR character dictionary missing");
+    chars.emplace_back(); // CTC blank
+    std::string all(dict.get());
+    size_t begin = 0;
+    while (begin < all.size())
+    {
+      size_t end = all.find('\n', begin);
+      if (end == std::string::npos)
+        end = all.size();
+      chars.push_back(all.substr(begin, end - begin));
+      begin = end + 1;
+    }
+    chars.emplace_back(" ");
+    if (session.GetInputCount() != 1 || session.GetOutputCount() != 1)
+      throw std::runtime_error("Unexpected OCR model interface");
+    input = session.GetInputNameAllocated(0, alloc).get();
+    output = session.GetOutputNameAllocated(0, alloc).get();
+  }
+};
+struct glyph
+{
+  int id;
+  float score;
+};
+int language(const std::string& s)
+{
+  const auto* p = reinterpret_cast<const unsigned char*>(s.c_str());
+  unsigned cp = p[0];
+  if (p[0] >= 0xe0 && p[0] < 0xf0 && s.size() == 3)
+    cp = ((p[0] & 15) << 12) | ((p[1] & 63) << 6) | (p[2] & 63);
+  else if (p[0] >= 0xf0 && p[0] < 0xf8 && s.size() == 4)
+    cp = ((p[0] & 7) << 18) | ((p[1] & 63) << 12) | ((p[2] & 63) << 6) | (p[3] & 63);
+  if ((cp >= 0x3400 && cp <= 0x9fff) || (cp >= 0x20000 && cp <= 0x2fa1f))
+    return 0;
+  if ((cp >= 'A' && cp <= 'Z') || (cp >= 'a' && cp <= 'z'))
+    return 1;
+  return -1;
+}
+} // namespace
+
+extern "C" void* pgs_ocr_create(const char* path)
+{
+  if (!path)
+    return nullptr;
+  try
+  {
+    return new engine(path);
+  }
+  catch (...)
+  {
+    return nullptr;
+  }
+}
+extern "C" void pgs_ocr_destroy(void* p)
+{
+  delete static_cast<engine*>(p);
+}
+extern "C" void pgs_ocr_cancel(void* p)
+{
+  if (p)
+  {
+    try
+    {
+      static_cast<engine*>(p)->run_options.SetTerminate();
+    }
+    catch (...)
+    {
+    }
+  }
+}
+extern "C" void pgs_ocr_free_text(char* p)
+{
+  delete[] p;
+}
+
+extern "C" char* pgs_ocr_recognise(void* ptr,
+                                   const uint8_t* img,
+                                   int w,
+                                   int h,
+                                   int* confidence,
+                                   bool (*cancel)(void*),
+                                   void* ctx,
+                                   pgs_ocr_word_cb callback,
+                                   void* word_ctx,
+                                   pgs_ocr_line_cb lineCallback,
+                                   void* lineContext)
+{
+  *confidence = 0;
+  if (!ptr || !img || w <= 0 || h <= 0 || w > 2080 || h > 544)
+    return nullptr;
+  try
+  {
+    auto& e = *static_cast<engine*>(ptr);
+    e.run_options.UnsetTerminate();
+    auto bands = PGSFindLines(img, w, h);
+    if (bands.size() > 16)
+      return nullptr;
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(4000);
+    std::string text;
+    double sum = 0;
+    int count = 0;
+    int lineIndex = 0;
+    for (auto b : bands)
+    {
+      if ((cancel && cancel(ctx)) || std::chrono::steady_clock::now() > deadline)
+        return nullptr;
+      const int currentLine = lineIndex++;
+      int cw = b.x1 - b.x0 + 12, ch = b.y1 - b.y0 + 6;
+      int resized = (32 * cw + ch - 1) / ch;
+      if (resized > max_width)
+        continue; // do not squash extreme layouts
+      int width = std::max(320, resized);
+      std::vector<float> tensor(3 * 48 * width, 0.0f);
+      auto pixel = [&](int x, int y) -> double
+      {
+        if (x < 6 || x >= cw - 6 || y < 3 || y >= ch - 3)
+          return 255;
+        return img[(b.y0 + y - 3) * w + b.x0 + x - 6];
+      };
+      // Keep the recognizer's 48-high tensor, but scale each text line to
+      // 32 high and centre it on white. Right padding stays normalized zero.
+      for (int c = 0; c < 3; ++c)
+        for (int y = 0; y < 48; ++y)
+          std::fill_n(tensor.data() + c * 48 * width + y * width, resized, 1.0f);
+      for (int y = 0; y < 32; y++)
+      {
+        double fy = std::max(0.0, (y + 0.5) * ch / 32.0 - 0.5);
+        int y0 = static_cast<int>(fy), y1 = std::min(y0 + 1, ch - 1);
+        fy -= y0;
+        for (int x = 0; x < resized; x++)
+        {
+          double fx = std::max(0.0, (x + 0.5) * cw / resized - 0.5);
+          int x0 = static_cast<int>(fx), x1 = std::min(x0 + 1, cw - 1);
+          fx -= x0;
+          float val = std::round((1 - fy) * ((1 - fx) * pixel(x0, y0) + fx * pixel(x1, y0)) +
+                                 fy * ((1 - fx) * pixel(x0, y1) + fx * pixel(x1, y1)));
+          val = val / 127.5f - 1;
+          for (int c = 0; c < 3; c++)
+            tensor[c * 48 * width + (y + 8) * width + x] = val;
+        }
+      }
+      int64_t shape[] = {1, 3, 48, width};
+      auto mem = Ort::MemoryInfo::CreateCpu(OrtArenaAllocator, OrtMemTypeDefault);
+      auto in = Ort::Value::CreateTensor<float>(mem, tensor.data(), tensor.size(), shape, 4);
+      const char *input = e.input.c_str(), *output = e.output.c_str();
+      auto values = e.session.Run(e.run_options, &input, &in, 1, &output, 1);
+      if (cancel && cancel(ctx))
+        return nullptr;
+      auto dims = values[0].GetTensorTypeAndShapeInfo().GetShape();
+      if (dims.size() != 3 || dims[0] != 1 || dims[1] <= 0 || dims[1] > 4096 ||
+          dims[2] != static_cast<int64_t>(e.chars.size()))
+        return nullptr;
+      const float* data = values[0].GetTensorData<float>();
+      std::vector<glyph> decoded;
+      int previous = 0;
+      for (int t = 0; t < dims[1]; t++)
+      {
+        const float* row = data + t * dims[2];
+        int id = std::max_element(row, row + dims[2]) - row;
+        if (id && id != previous)
+          decoded.push_back({id, row[id]});
+        previous = id;
+      }
+      if (lineCallback)
+      {
+        std::string raw;
+        float minimum = 1.0f;
+        for (auto g : decoded)
+        {
+          raw += e.chars[g.id];
+          minimum = std::min(minimum, g.score);
+        }
+        // Preserve physical line index and unfiltered text. Low-confidence
+        // Chinese must not disappear and turn a mixed line into "English".
+        lineCallback(lineContext, currentLine, raw.c_str(),
+                     decoded.empty() ? 0 : static_cast<int>(minimum * 100));
+      }
+      double mean = 0;
+      for (auto g : decoded)
+        mean += static_cast<double>(g.score);
+      if (decoded.empty() || mean / decoded.size() < 0.70)
+        continue;
+      for (auto g : decoded)
+      {
+        // Individual dubious characters must not win a five-glyph vote
+        // just because a long English line raised its mean confidence.
+        if (static_cast<double>(g.score) < 0.70)
+        {
+          text += ' ';
+          continue;
+        }
+        text += e.chars[g.id];
+        sum += static_cast<double>(g.score);
+        count++;
+      }
+      text += '\n';
+      // Keep language-homogeneous confident words for bilingual evidence.
+      for (size_t i = 0; callback && i < decoded.size();)
+      {
+        int lang = language(e.chars[decoded[i].id]);
+        if (lang < 0 || static_cast<double>(decoded[i].score) < 0.70)
+        {
+          i++;
+          continue;
+        }
+        size_t j = i + 1;
+        while (j < decoded.size() && language(e.chars[decoded[j].id]) == lang &&
+               static_cast<double>(decoded[j].score) >= 0.70)
+          j++;
+        std::string word;
+        for (size_t k = i; k < j; k++)
+          word += e.chars[decoded[k].id];
+        callback(word_ctx, word.c_str());
+        i = j;
+      }
+    }
+    *confidence = count ? static_cast<int>(100 * sum / count) : 0;
+    char* result = new char[text.size() + 1];
+    std::memcpy(result, text.c_str(), text.size() + 1);
+    return result;
+  }
+  catch (...)
+  {
+    return nullptr;
+  }
+}
