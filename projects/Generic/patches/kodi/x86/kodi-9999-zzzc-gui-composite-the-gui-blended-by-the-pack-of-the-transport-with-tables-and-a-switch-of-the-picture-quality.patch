diff --git a/system/shaders/GLES/2.0/gles_gui_composite.frag b/system/shaders/GLES/2.0/gles_gui_composite.frag
index c5a7f90..27165cc 100644
--- a/system/shaders/GLES/2.0/gles_gui_composite.frag
+++ b/system/shaders/GLES/2.0/gles_gui_composite.frag
@@ -32,6 +32,12 @@ uniform float u_ootfGamma;      // HLG: OOTF gamma (1.2 for BT.2100 1000-nit ref
 // against the reference white (what the degamma LUT has baked in)
 uniform float u_pqPeak;
 uniform float u_hlgWhite;
+// Hades: grey - nearly all of the GUI: its text, bars and shades - by one lookup of a table the
+// CPU filled with the arithmetic below (the matrix of BT.709 -> BT.2020 leaves grey grey), where
+// that table was made; a pixel a code of grey off reads it as well, for the matrix would move it
+// by less than the rounding of the packing
+uniform sampler2D u_lutGray; // the sRGB code of grey -> its PQ signal (256 entries, exact a code)
+uniform int u_grayFast; // 1 where that table exists; 0: the arithmetic below for every pixel
 #endif
 
 // BT.709 -> BT.2020 color space conversion matrix (applied in linear light)
@@ -82,6 +88,19 @@ void main()
     discard;
 
 #if defined(KODI_GUI_EXACT)
+  // Hades: grey by one lookup (u_lutGray): an achromatic pixel returns the signal of its code,
+  // and the powers are not run for it; white antialiased text is grey this way, for the alpha of
+  // the edge carries the coverage, and the colour under the edge is grey itself
+  if (u_grayFast != 0 && u_ootfGamma <= 0.0)
+  {
+    vec3 g = gui.rgb;
+    if (max(max(g.r, g.g), g.b) - min(min(g.r, g.g), g.b) < 0.75 / 255.0)
+    {
+      float y = texture2D(u_lutGray, vec2(g.r, 0.5)).r;
+      gl_FragColor = vec4(vec3(y), gui.a * gui.a);
+      return;
+    }
+  }
   vec3 linear = srgbToLinear(clamp(gui.rgb, 0.0, 1.0));
   if (u_ootfGamma > 0.0)
     linear *= u_hlgWhite;
