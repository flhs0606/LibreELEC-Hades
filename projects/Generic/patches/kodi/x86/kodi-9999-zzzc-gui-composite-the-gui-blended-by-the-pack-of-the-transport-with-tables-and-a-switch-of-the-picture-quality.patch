+/* Hades: IEC 61966-2-1 sRGB EOTF and SMPTE ST 2084, as the composite's shader has them
+ * (gles_gui_composite.frag), for the GUI's tables of a code */
+static float gui_srgb_to_linear(float v)
+{
+    return v <= 0.04045f ? v / 12.92f : powf((v + 0.055f) / 1.055f, 2.4f);
+}
+
+static float gui_forward_pq(float L)
+{
+    const float Lm1 = powf(L, 0.1593017578125f);
+    return powf((0.8359375f + 18.8515625f * Lm1) / (1.0f + 18.6875f * Lm1), 78.84375f);
+}
+
+/* Hades: a table of 256 entries, one a code of the GUI's 8 bits, in 32-bit floats where the GPU
+ * takes them (half floats as it does not): read exact, a texel of the index, which no filtering
+ * of the texture takes part in. Filled by gui_fill_gray(). */
+static GLuint gui_make_lut(void)
+{
+    GLuint tex = 0;
+    glGenTextures(1, &tex);
+    if (!tex)
+        return 0;
+    static const float zero[256];
+    glBindTexture(GL_TEXTURE_2D, tex);
+    dvbridge_gl_drain_errors();
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_R32F, 256, 1, 0, GL_RED, GL_FLOAT, zero);
+    if (glGetError() != GL_NO_ERROR) {
+        dvbridge_gl_drain_errors();
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_R16F, 256, 1, 0, GL_RED, GL_FLOAT, zero);
+        if (glGetError() != GL_NO_ERROR) {
+            dvbridge_gl_drain_errors();
+            glDeleteTextures(1, &tex);
+            return 0;
+        }
+    }
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    return tex;
+}
+
+/* Hades: the signal of grey, code for code, the peak the GUI's white goes by (the matrix of
+ * BT.709 -> BT.2020 leaves grey grey: its rows add to 1) */
+static void gui_fill_gray(GLuint tex, float peak)
+{
+    float y[256];
+    for (int i = 0; i < 256; ++i)
+        y[i] = gui_forward_pq(gui_srgb_to_linear(i / 255.0f) * peak);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 256, 1, GL_RED, GL_FLOAT, y);
+}
