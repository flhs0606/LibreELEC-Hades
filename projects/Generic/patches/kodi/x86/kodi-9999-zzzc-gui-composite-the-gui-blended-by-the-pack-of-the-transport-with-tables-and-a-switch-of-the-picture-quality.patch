+#ifdef HAVE_DVBRIDGE
+bool CRendererDRMPRIMEGLES::LibplaceboKneeWanted() const
+{
+  // Hades: while frame-by-frame dynamic tone mapping is on, its curve decides the knee question,
+  // not the method of the video (DVBRIDGE::ToneMapMethodOf()); with it off, the video's own method
+  // is the authority again
+  return static_cast<ETONEMAPMETHOD>(DVBRIDGE::ToneMapMethodOf(m_videoSettings.m_ToneMapMethod)) ==
+         VS_TONEMAPMETHOD_BT2390_LIBPLACEBO;
+}
+
+bool CRendererDRMPRIMEGLES::CanPlainMap(const VideoPicture& picture) const
+{
+  // The two planes of the dma-buf imported per plane, as the limited-range path takes them: the
+  // layout the bridge imports (dvbridge_gl_frame_import()) and a size it takes; the place and the
+  // size on the screen are free (the bridge scales to where Kodi puts the picture)
+  if (m_renderOrientation != 0 || picture.iWidth < 1 || picture.iHeight < 1)
+    return false;
+  switch (m_sourceFourcc)
+  {
+    case DRM_FORMAT_NV12:
+    case DRM_FORMAT_P010:
+    case DRM_FORMAT_P012:
+    case DRM_FORMAT_P016:
+      break;
+    default:
+      return false;
+  }
+  return DVBRIDGE::SourceFitsRaster(static_cast<int>(picture.iWidth),
+                                    static_cast<int>(picture.iHeight));
+}
+
+bool CRendererDRMPRIMEGLES::WantsPlainMapping(const VideoPicture& picture) const
+{
+  // (not a picture that another renderer reconstructs: the DRM PRIME renderer has no
+  // reconstruction; such a video plays as Kodi plays it, as before)
+  return DVBRIDGE::WantsPlainMapping(&picture, m_videoSettings.m_ToneMapMethod) &&
+         !DVBRIDGE::WantsConversion(&picture, m_videoSettings.m_ToneMapMethod) &&
+         CanPlainMap(picture);
+}
+
+bool CRendererDRMPRIMEGLES::WantsHdr10Adapt(const VideoPicture& picture) const
+{
+  return DVBRIDGE::WantsHdr10Adapt(&picture) &&
+         !DVBRIDGE::WantsConversion(&picture, m_videoSettings.m_ToneMapMethod) &&
+         !WantsPlainMapping(picture) && CanPlainMap(picture);
+}
+
+int CRendererDRMPRIMEGLES::RenderPlainMapping(int index)
+{
+  // Hades: its two planes imported per plane (the limited-range way), its colour (transfer, range
+  // and the HDR10 and HDR10+ metadata of the picture) and the metadata of the stream where it has
+  // them: what CRendererVAAPIGLES::RenderPlainMapping() gives the window of a VAAPI surface
+  if (index < 0 || index >= NUM_BUFFERS || m_renderOrientation != 0)
+    return -1;
+  auto* window =
+      dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  if (!window)
+    return -1;
+  BUFFER& buf = m_buffers[index];
+  auto* buffer = dynamic_cast<CVideoBufferDRMPRIME*>(buf.videoBuffer);
+  if (!buffer || !buffer->IsValid())
+    return -1;
+  CDRMPRIMETextureYUV* yuv = m_texturePool.GetYUV(buffer);
+  if (!yuv)
+    return -1;
+  CDVBridgeGLES::Layer layer{};
+  switch (yuv->GetSourceFormat())
+  {
+    case DRM_FORMAT_NV12:
+      layer.layout = DVBRIDGE_NV12;
+      break;
+    case DRM_FORMAT_P010:
+      layer.layout = DVBRIDGE_P010;
+      break;
+    case DRM_FORMAT_P012:
+      layer.layout = DVBRIDGE_P012;
+      break;
+    case DRM_FORMAT_P016:
+      layer.layout = DVBRIDGE_P016;
+      break;
+    default:
+      return -1;
+  }
+  const CSizeInt texSize = yuv->GetTextureSize();
+  layer.width = m_sourceWidth;
+  layer.height = m_sourceHeight;
+  layer.chroma = buf.doviChroma;
+  layer.pts = (buf.doviPts != DVD_NOPTS_VALUE) ? buf.doviPts : 0.0;
+  layer.duration = buf.doviDuration;
+  layer.video = buf.doviVideo;
+  layer.planes[0] = {yuv->GetTexture(0), texSize.Width(), texSize.Height()};
+  layer.planes[1] = {yuv->GetTexture(1), (texSize.Width() + 1) / 2, (texSize.Height() + 1) / 2};
+  // (the colour of the picture: its transfer, its range and its HDR10 metadata, 0 where not known)
+  dvbridge_plain plain{};
+  plain.hlg = buf.srcColTransfer == AVCOL_TRC_ARIB_STD_B67;
+  plain.full_range = buf.srcFullRange;
+  if (buf.hasDisplayMetadata && buf.displayMetadata.has_luminance &&
+      buf.displayMetadata.max_luminance.den && buf.displayMetadata.min_luminance.den)
+  {
+    plain.max_luma = static_cast<float>(av_q2d(buf.displayMetadata.max_luminance));
+    plain.min_luma = static_cast<float>(av_q2d(buf.displayMetadata.min_luminance));
+  }
+  if (buf.hasLightMetadata)
+  {
+    plain.max_cll = static_cast<float>(buf.lightMetadata.MaxCLL);
+    plain.max_fall = static_cast<float>(buf.lightMetadata.MaxFALL);
+  }
+  // ... and its HDR10+ metadata, which guide the mapping where it has them (a PQ picture only)
+  if (buf.hdr10PlusDynamic && buf.srcColTransfer == AVCOL_TRC_SMPTE2084)
+    dvbridge_hdr10plus_plain(buf.hdr10PlusDynamic.get(), &plain.hdr10plus, nullptr, nullptr);
+  return window->RenderPlainMapping(layer, plain, m_sourceRect, m_destRect, buf.doviSerial,
+                                    buf.doviMetadata);
+}
