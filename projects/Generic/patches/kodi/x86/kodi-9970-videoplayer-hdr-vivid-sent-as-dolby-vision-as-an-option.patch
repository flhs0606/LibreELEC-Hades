 // A stream's own Dolby Vision is never touched.
+
+void CDVDDemuxFFmpeg::UnmakeFromHdrVivid(CDemuxStream* stream, int streamIdx, const char* why)
+{
+  m_dvFromHdrVivid.erase(streamIdx);
+  m_dvPromoted.erase(streamIdx);
+  const auto before = m_dvHdrBefore.find(streamIdx);
+  const StreamHdrType type =
+      before != m_dvHdrBefore.end() ? before->second : StreamHdrType::HDR_TYPE_HDR10;
+  m_dvHdrBefore.erase(streamIdx);
+  auto* video = dynamic_cast<CDemuxStreamVideo*>(stream);
+  if (!video)
+    return;
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: stream {} is not made Dolby Vision from its HDR Vivid metadata any "
+            "more: {}; it plays as it is",
+            streamIdx, why);
+  video->doviFromHdrVivid = false;
+  video->dovi = {};
+  video->hdr_type = type;
+  video->changes++;
+}
