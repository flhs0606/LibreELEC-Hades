+void CDVDVideoCodecFFmpeg::MakeHdrVividMetadata(VideoPicture* picture)
+{
+  const AVFrameSideData* sd = av_frame_get_side_data(m_pFrame, AV_FRAME_DATA_DYNAMIC_HDR_VIVID);
+  const auto* vivid = sd && sd->size >= sizeof(AVDynamicHDRVivid)
+                          ? reinterpret_cast<const AVDynamicHDRVivid*>(sd->data)
+                          : nullptr;
+  size_t size = 0;
+  bool repeated = false;
+  const AVDOVIMetadata* made = dvbridge_hdrvivid_next(
+      m_dvHdrVividScene, vivid, nullptr, 0,
+      picture->hasDisplayMetadata ? &picture->displayMetadata : nullptr,
+      picture->hasLightMetadata ? &picture->lightMetadata : nullptr, &size, &repeated);
+  picture->doviMeasured = false;
+  picture->doviHdr10Plus = 0;
+  if (made && picture->doviMetadata.Assign(reinterpret_cast<const uint8_t*>(made), size))
+    picture->doviRpuRepeated = repeated;
+}
+
 // Hades: the metadata of a picture of HDR10 measured as Dolby Vision as it leaves the decoder: profile
 // 8.1 over the picture, the mastering display as the source range, level 1 from the static metadata
 // (dvbridge_measured_placeholder()). The window system makes its level 1, level 5 and scene refresh
@@ -2238,6 +2268,7 @@ void CDVDVideoCodecFFmpeg::Reset()
   m_dvLateInRow = 0;
   // (Hades: the first picture after it refreshes the scene, and none gets metadata from before)
   dvbridge_hdr10plus_scene_reset(m_dvHdr10PlusScene);
+  dvbridge_hdrvivid_scene_reset(m_dvHdrVividScene);
 #endif
   m_hdr10PlusGap.Flush(); // Hades
   m_started = false;
@@ -2581,6 +2612,8 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
     // Hades: made from the picture's own HDR10+ metadata (FFmpeg makes none of an RPU there is not)
     else if (m_dvFromHdr10Plus)
       MakeHdr10PlusMetadata(pVideoPicture);
+    else if (m_dvFromHdrVivid)
+      MakeHdrVividMetadata(pVideoPicture);
     else if (m_dvMeasured)
       MakeMeasuredMetadata(pVideoPicture);
 #endif
