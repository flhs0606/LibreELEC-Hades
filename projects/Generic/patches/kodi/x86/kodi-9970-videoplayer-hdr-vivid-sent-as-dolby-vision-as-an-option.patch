+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of LibreELEC Hades. It is not in Kodi as Team Kodi publishes it.
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+extern "C"
+{
+#include <libavcodec/codec_par.h>
+#include <libavutil/dovi_meta.h>
+#include <libavutil/rational.h>
+}
+
+class CDVHdrVivid
+{
+public:
+  struct AccessUnit
+  {
+    bool picture = false;     //!< a unit of a coded picture (VCL, nuh_layer_id 0)
+    bool dolbyVision = false; //!< a unit of type 62 or 63 (an RPU, or the enhancement layer)
+    bool mastering = false;   //!< an SEI of the mastering display colour volume (payload type 137)
+    std::vector<uint8_t> t35; //!< payload of HDR Vivid SEI, from country code on
+  };
+
+  static AccessUnit Read(const uint8_t* data, size_t size, int lengthSize);
+
+  enum class Verdict
+  {
+    HDR_VIVID,    //!< can be sent as Dolby Vision from HDR Vivid
+    NOT_YET,      //!< nothing in this access unit says
+    DOLBY_VISION, //!< has native Dolby Vision RPU
+    NOT_PQ,       //!< colour is not BT.2020 PQ
+  };
+
+  static Verdict Judge(const AccessUnit& unit, const AVCodecParameters* parameters, bool containerMastering);
+  static const char* Why(const AccessUnit& unit, const AVCodecParameters* parameters, bool containerMastering);
+
+  static bool Record(const AVCodecParameters* parameters,
+                     AVRational rate,
+                     AVDOVIDecoderConfigurationRecord& record);
+
+  static bool MakesLevel1(const std::vector<uint8_t>& t35);
+};
