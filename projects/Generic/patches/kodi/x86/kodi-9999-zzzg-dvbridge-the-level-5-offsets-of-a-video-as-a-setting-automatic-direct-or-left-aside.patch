diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index 3f74edb..90d1bc5 100644
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -4209,6 +4209,35 @@
         <default>false</default>
         <control type="toggle" />
       </setting>
+      <!-- Hades: how the level 5 offsets (the active area) of a video's metadata reach the display:
+           automatic reads them and describes the picture as it is placed on the screen, the player
+           blanking the bars and taking the edges drawn over out of them (the default); direct sends
+           them as the RPU gives them and blanks nothing, right where the screen shows the video
+           pixel for pixel, wrong wherever it is scaled or zoomed, and subtitles drawn over the bars
+           are masked by the display; left aside sends the area of the picture's place, as a video
+           without them -->
+      <setting id="videoscreen.hadesdvl5" type="integer" label="41890" help="41891">
+        <requirement>
+          <and>
+            <condition>HAVE_GBM</condition>
+            <condition>HAS_GLES</condition>
+          </and>
+        </requirement>
+        <level>3</level>
+        <default>0</default>
+        <dependencies>
+          <dependency type="visible" on="property" name="supportsdv"/>
+          <dependency type="enable" setting="videoscreen.hadesdvnative">true</dependency>
+        </dependencies>
+        <constraints>
+          <options>
+            <option label="41892">0</option> <!-- automatic: read and mapped -->
+            <option label="41893">1</option> <!-- direct: as the RPU gives them -->
+            <option label="41894">2</option> <!-- left aside: the picture's area -->
+          </options>
+        </constraints>
+        <control type="spinner" format="string" />
+      </setting>
       <!-- Hades: the trim pass (level 2) of the player where it maps Dolby Vision to the display itself (HDR10 adapted to
            it, SDR, Low-Latency): off by default, because the only published way to apply it (the informative example of
            SMPTE ST 2094-10 Annex B.3) takes the picture away from a studio's own grade (tools/dvbridge/dvbridge_trims.h);
