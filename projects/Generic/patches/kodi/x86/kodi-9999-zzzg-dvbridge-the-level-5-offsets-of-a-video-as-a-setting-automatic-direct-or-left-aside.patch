diff --git a/tools/dvbridge/dvbridge_core.h b/tools/dvbridge/dvbridge_core.h
index 428b867..596d8d5 100644
--- a/tools/dvbridge/dvbridge_core.h
+++ b/tools/dvbridge/dvbridge_core.h
@@ -77,6 +77,16 @@ void dvbridge_set_display_management(struct dvbridge_context *context, unsigned
  * of level 8); true until said otherwise. Set before the frames of a stream (a frame prepared before
  * it was made with what held then), and kept by dvbridge_reset(). */
 void dvbridge_set_trims(struct dvbridge_context *context, bool send);
+/* Hades: how the level 5 offsets of a video's metadata reach the display (videoscreen.hadesdvl5):
+ * read and mapped to the place of the picture, the player blanking the bars and taking the edges
+ * drawn over out of them (the default, as before); sent as the RPU gives them, with nothing of the
+ * picture blanked and no edge taken out (right where the screen shows the video pixel for pixel,
+ * wrong wherever it is scaled or zoomed); or left aside, the area of the picture's place sent, as
+ * for metadata without a level 5 block. Kept as dvbridge_set_trims() is. */
+#define DVBRIDGE_L5_AUTO 0
+#define DVBRIDGE_L5_DIRECT 1
+#define DVBRIDGE_L5_IGNORE 2
+void dvbridge_set_l5(struct dvbridge_context *context, int mode);
 /* Hades: whether a frame whose RPU has no content mapping v4.0 part is sent with dovi_tool's default one
  * (dvbridge_dv::cm40_default in dvbridge_metadata.h); false until said otherwise. Set and kept as
  * dvbridge_set_trims(). */
@@ -186,6 +196,9 @@ struct dvbridge_reading {
     /* Hades: the level 5 offsets were left aside for the video, and why (dvbridge_dv_l5() in dvbridge_metadata.h);
      * NULL when they were not */
     const char *l5_ignored;
+    /* Hades: the level 5 offsets are sent as the RPU gives them (videoscreen.hadesdvl5, direct);
+     * false when they were read, or left aside */
+    bool l5_direct;
     /* Extension blocks of reserved levels, left out (a display ignores them): how many, and the
      * level of the first one */
     unsigned skipped, skipped_level;
diff --git a/tools/dvbridge/dvbridge_metadata.h b/tools/dvbridge/dvbridge_metadata.h
