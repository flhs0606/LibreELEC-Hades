     /* Hades: the level 5 offsets were left aside for the video, and why (dvbridge_dv_l5()); NULL when not */
     const char *l5_ignored;
+    /* Hades: the level 5 offsets are sent as the RPU gives them (videoscreen.hadesdvl5, direct) */
+    bool l5_direct;
     /* Extension blocks of a level that CCM 001 reserves, which a display ignores: left out. */
     unsigned skipped, skipped_level;
     /* Hades: blocks of the content mapping v4.0 part of the metadata (levels 3, 8 to 11 and 254),
@@ -117,6 +120,12 @@ struct dvbridge_dv {
      * left out, and those of level 10, which only describe the targets of level 8 blocks. Kept from
      * one stream to the next (dvbridge_dv_restart()): it is the display's, not the stream's. */
     bool no_trims;
+    /* Hades: how the level 5 offsets reach the display (videoscreen.hadesdvl5, DVBRIDGE_L5_* in
+     * dvbridge_core.h): the automatic reading maps them to the place of the picture; direct sends
+     * them as the RPU gives them and blanks nothing; ignore leaves them aside, as for metadata
+     * without a level 5 block. Kept from one stream to the next (dvbridge_dv_restart()), as
+     * no_trims. */
+    int l5_mode;
     /* Hades: cm40_default, a frame whose RPU has no content mapping v4.0 part at all is sent with the one
      * that dovi_tool adds as its "safe" default (add_cmv4_default_metadata, CmV40DmData::default_safe():
      * level 3 with no offsets, level 9 DCI-P3 D65, level 11 cinema with a D65 white point and no
@@ -384,6 +393,19 @@ static inline bool dvbridge_dv_l5(struct dvbridge_dv *d, unsigned l, unsigned r,
 {
     d->reading.l5_ignored = NULL;
     const unsigned offsets[4] = {l, r, t, b};
+    /* Hades: the setting leaves the offsets aside (videoscreen.hadesdvl5): whatever they are, this
+     * video's frames go out as metadata without a level 5 block. The decision is the setting's,
+     * not the video's (dvbridge_dv_ignore_l5_of() is not made), so a change of the setting back
+     * takes the offsets as they are. */
+    if (d->l5_mode == DVBRIDGE_L5_IGNORE) {
+        if (!dvbridge_dv_margins(d, 0, 0, 0, 0, v))
+            return false; /* (d->refused says why) */
+        memcpy(d->reading.l5, offsets, sizeof(offsets));
+        d->reading.l5_master = false;
+        d->reading.l5_ignored = "the setting videoscreen.hadesdvl5 leaves the level 5 offsets aside";
+        d->refused = NULL;
+        return true;
+    }
     if (!dvbridge_dv_l5_ignored(d, offsets)) {
         if (dvbridge_dv_margins(d, l, r, t, b, v))
             return true;
@@ -473,6 +495,7 @@ static inline void dvbridge_dv_restart(struct dvbridge_dv *d)
     const unsigned id = d->id;
     const bool no_trims = d->no_trims, cm40_default = d->cm40_default, cm40_auto = d->cm40_auto,
                cm40_auto_no_trims = d->cm40_auto_no_trims;
+    const int l5_mode = d->l5_mode;
     const unsigned cm40_auto_peak_pq = d->cm40_auto_peak_pq;
     /* (Hades: the decision of the automatic choice is of the video, not of the stream of native output) */
     const bool cm40_auto_decided = d->cm40_auto_decided, cm40_auto_on = d->cm40_auto_on,
@@ -497,6 +520,7 @@ static inline void dvbridge_dv_restart(struct dvbridge_dv *d)
     d->cm40_menus = cm40_menus;
     d->id = id;
     d->no_trims = no_trims;
+    d->l5_mode = l5_mode;
     d->cm40_default = cm40_default;
     d->cm40_auto = cm40_auto;
     d->cm40_auto_no_trims = cm40_auto_no_trims;
@@ -641,6 +665,7 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
     }
     d->reading.skipped = d->reading.skipped_level = 0;
     d->reading.l5_ignored = NULL;
+    d->reading.l5_direct = false;
     d->reading.cm40_left_out = d->reading.cm40_dropped = d->reading.cm40_added = 0;
     /* 6.2.1 table 3: dm_metadata() */
     d->size = 0;
@@ -782,6 +807,22 @@ static inline bool dvbridge_dv_metadata(struct dvbridge_dv *d, const AVDOVIMetad
             DV_REFUSE(area == 1, "two level 5 blocks");
             DV_REFUSE(l1 == 1,
                       l1 ? "two level 1 blocks" : "a level 5 block without a level 1 block");
+            /* Hades: the offsets sent as the RPU gives them (videoscreen.hadesdvl5, direct): the
+             * margins are the picture's place (nothing of the picture is blanked), no edge is
+             * taken out, and the offsets are not read: they describe the canvas the RPU was made
+             * for, which the output is only where it shows the video pixel for pixel. */
+            if (d->l5_mode == DVBRIDGE_L5_DIRECT) {
+                if (!dvbridge_dv_margins(d, 0, 0, 0, 0, v))
+                    return false; /* (d->refused says why) */
+                memcpy(d->margins, v, sizeof(d->margins));
+                v[0] = e->l5.left_offset; v[1] = e->l5.right_offset;
+                v[2] = e->l5.top_offset; v[3] = e->l5.bottom_offset;
+                memcpy(d->reading.l5, v, sizeof(d->reading.l5));
+                memset(d->reading.as_given, 0, sizeof(d->reading.as_given));
+                d->reading.l5_master = false;
+                d->reading.l5_direct = true;
+                break;
+            }
             if (!dvbridge_dv_l5(d, e->l5.left_offset, e->l5.right_offset, e->l5.top_offset,
                                 e->l5.bottom_offset, v))
                 return false; /* (d->refused says why) */
