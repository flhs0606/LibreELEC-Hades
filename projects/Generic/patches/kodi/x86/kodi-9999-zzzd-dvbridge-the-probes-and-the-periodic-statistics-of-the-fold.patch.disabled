diff --git a/tools/dvbridge/dvbridge_measure.h b/tools/dvbridge/dvbridge_measure.h
index 3b7f166..fb3551c 100644
--- a/tools/dvbridge/dvbridge_measure.h
+++ b/tools/dvbridge/dvbridge_measure.h
@@ -43,6 +43,13 @@ bool dvbridge_measure_submit(struct dvbridge_measure *m, unsigned luma, unsigned
  *  */
 bool dvbridge_measure_submit_ex(struct dvbridge_measure *m, unsigned luma, unsigned chroma, int width, int height,
                                 const int window[2], double pts, uint64_t tag, bool hlg);
+/* Hades: the same for a picture of three planes (DVBRIDGE_YUV420P10 of dvbridge_gl_frame.h, the
+ * picture that the processor decoded): its 10 bits are the bottom of the 16 of each texel, and U
+ * and V are each a texture of their own (chroma_u, chroma_v, R16, half size) in place of the
+ * interleaved chroma of P010. */
+bool dvbridge_measure_submit_planar(struct dvbridge_measure *m, unsigned luma, unsigned chroma_u,
+                                    unsigned chroma_v, int width, int height, const int window[2],
+                                    double pts, uint64_t tag, bool hlg);
 /* The measurements that the GPU has finished, in the order they were queued, each to done(); one not finished stops
  * it (so that they come in order). Returns how many are still in flight. */
 unsigned dvbridge_measure_collect(struct dvbridge_measure *m,
