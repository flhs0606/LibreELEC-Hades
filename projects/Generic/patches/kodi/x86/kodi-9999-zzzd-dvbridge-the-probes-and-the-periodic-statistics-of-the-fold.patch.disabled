     pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 32, 32,
                              PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE);
+    /* Hades: told once (to the journal): whether the picture that Kodi draws the GUI over could be
+     * a 16-bit normalized one instead of the 32-bit floats (the same 12-bit codes, half the bytes
+     * written and read) */
+    {
+        pl_fmt u16 = pl_find_fmt(gpu, PL_FMT_UNORM, 4, 16, 16,
+                                 PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE);
+        fprintf(stderr, "DV render: the formats of the picture drawn over (rgba32f %d, unorm16 %d)\n",
+                fmt ? 1 : 0, u16 ? 1 : 0);
+    }
     /* Hades: the picture that Kodi draws over in 16-bit codes, the same codes at half the bytes:
      * where this GPU renders to one, and until the source transport is asked for, whose passes
      * read the alpha of the picture as their 2.0 (PICTURE_ALPHA), which the 16 bits cannot hold
diff --git a/tools/dvbridge/dvbridge_source.c b/tools/dvbridge/dvbridge_source.c
