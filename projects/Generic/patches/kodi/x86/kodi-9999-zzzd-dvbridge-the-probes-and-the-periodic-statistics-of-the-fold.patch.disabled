     if (inplace > 0.0f && gui && params->affine && !cached && p->pack_gui && !p->inplace_failed) {
         if (!end(&state, true))
             return false;
@@ -3719,6 +3732,17 @@ bool dvbridge_source_pack(struct dvbridge_source_packer *p,
         glUniform1f(p->g.peak, p->inplace_peak);
         glUniform1i(p->g.has_layer, 1);
         const int how = p->tiles_mode ? 3 : 0;
+        /* Hades: the draw traced (to the journal): the form of the program (a fragment a pair of
