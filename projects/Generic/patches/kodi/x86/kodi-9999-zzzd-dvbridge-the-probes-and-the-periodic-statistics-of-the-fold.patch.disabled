+void CWinSystemGbmGLESContext::GuiPassTimerMark(bool begin)
+{
+  if (!m_guiPassTimersMade)
+  {
+    m_guiPassTimersMade = true;
+    if (IsExtSupported("GL_EXT_disjoint_timer_query"))
+    {
+      if (!m_glGenQueriesEXT)
+        m_glGenQueriesEXT =
+            reinterpret_cast<PFNGLGENQUERIESEXTPROC>(eglGetProcAddress("glGenQueriesEXT"));
+      if (!m_glDeleteQueriesEXT)
+        m_glDeleteQueriesEXT =
+            reinterpret_cast<PFNGLDELETEQUERIESEXTPROC>(eglGetProcAddress("glDeleteQueriesEXT"));
+      if (!m_glQueryCounterEXT)
+        m_glQueryCounterEXT =
+            reinterpret_cast<PFNGLQUERYCOUNTEREXTPROC>(eglGetProcAddress("glQueryCounterEXT"));
+      if (!m_glGetQueryObjectuivEXT)
+        m_glGetQueryObjectuivEXT =
+            reinterpret_cast<PFNGLGETQUERYOBJECTUIVEXTPROC>(eglGetProcAddress("glGetQueryObjectuivEXT"));
+      if (!m_glGetQueryObjectui64vEXT)
+        m_glGetQueryObjectui64vEXT =
+            reinterpret_cast<PFNGLGETQUERYOBJECTUI64VEXTPROC>(
+                eglGetProcAddress("glGetQueryObjectui64vEXT"));
+    }
+    if (m_glGenQueriesEXT && m_glDeleteQueriesEXT && m_glQueryCounterEXT &&
+        m_glGetQueryObjectuivEXT && m_glGetQueryObjectui64vEXT)
+      for (auto& timer : m_guiPassTimers)
+      {
+        m_glGenQueriesEXT(1, &timer.begin);
+        m_glGenQueriesEXT(1, &timer.end);
+      }
+  }
+  auto& timer = m_guiPassTimers[m_guiPassTimerIndex];
+  if (!timer.begin || !timer.end)
+    return;
+  if (begin)
+  {
+    if (timer.pending)
+      return; // (its result is not back yet: this GUI pass is not timed)
+    m_glQueryCounterEXT(timer.begin, GL_TIMESTAMP_EXT);
+    timer.begun = true;
+  }
+  else if (timer.begun)
+  {
+    m_glQueryCounterEXT(timer.end, GL_TIMESTAMP_EXT);
+    timer.begun = false;
+    timer.pending = true;
+    m_guiPassTimerIndex = (m_guiPassTimerIndex + 1) % m_guiPassTimers.size();
+  }
+}
+
+void CWinSystemGbmGLESContext::GuiPassTimerCollect()
+{
+  if (!m_glGetQueryObjectuivEXT || !m_guiPassTimers[0].begin)
+    return;
+  // (reading the disjoint state clears it; a disjoint period makes the results in flight useless)
+  GLint disjoint = 0;
+  glGetIntegerv(GL_GPU_DISJOINT_EXT, &disjoint);
+  for (size_t n = 0; n < m_guiPassTimers.size(); ++n)
+  {
+    auto& timer = m_guiPassTimers[(m_guiPassTimerIndex + n) % m_guiPassTimers.size()];
+    if (!timer.pending)
+      continue;
+    GLuint available = 0;
+    m_glGetQueryObjectuivEXT(timer.end, GL_QUERY_RESULT_AVAILABLE_EXT, &available);
+    if (!available)
+      break;
+    timer.pending = false;
+    if (disjoint)
+      continue;
+    GLuint64 start = 0, finish = 0;
+    m_glGetQueryObjectui64vEXT(timer.begin, GL_QUERY_RESULT_EXT, &start);
+    m_glGetQueryObjectui64vEXT(timer.end, GL_QUERY_RESULT_EXT, &finish);
+    if (finish <= start)
+      continue;
+    const double ms = static_cast<double>(finish - start) / 1e6;
+    ++m_dvStats.guiPassDrawn;
+    m_dvStats.guiPassSumMs += ms;
+    m_dvStats.guiPassMaxMs = std::max(m_dvStats.guiPassMaxMs, ms);
+  }
+}
+
+void CWinSystemGbmGLESContext::CompQuadTimerMark(bool begin)
+{
+  if (!m_compQuadTimersMade)
+  {
+    m_compQuadTimersMade = true;
+    if (IsExtSupported("GL_EXT_disjoint_timer_query"))
+    {
+      if (!m_glGenQueriesEXT)
+        m_glGenQueriesEXT =
+            reinterpret_cast<PFNGLGENQUERIESEXTPROC>(eglGetProcAddress("glGenQueriesEXT"));
+      if (!m_glDeleteQueriesEXT)
+        m_glDeleteQueriesEXT =
+            reinterpret_cast<PFNGLDELETEQUERIESEXTPROC>(eglGetProcAddress("glDeleteQueriesEXT"));
+      if (!m_glQueryCounterEXT)
+        m_glQueryCounterEXT =
+            reinterpret_cast<PFNGLQUERYCOUNTEREXTPROC>(eglGetProcAddress("glQueryCounterEXT"));
+      if (!m_glGetQueryObjectuivEXT)
+        m_glGetQueryObjectuivEXT =
+            reinterpret_cast<PFNGLGETQUERYOBJECTUIVEXTPROC>(eglGetProcAddress("glGetQueryObjectuivEXT"));
+      if (!m_glGetQueryObjectui64vEXT)
+        m_glGetQueryObjectui64vEXT =
+            reinterpret_cast<PFNGLGETQUERYOBJECTUI64VEXTPROC>(
+                eglGetProcAddress("glGetQueryObjectui64vEXT"));
+    }
+    if (m_glGenQueriesEXT && m_glDeleteQueriesEXT && m_glQueryCounterEXT &&
+        m_glGetQueryObjectuivEXT && m_glGetQueryObjectui64vEXT)
+      for (auto& timer : m_compQuadTimers)
+      {
+        m_glGenQueriesEXT(1, &timer.begin);
+        m_glGenQueriesEXT(1, &timer.end);
+      }
+  }
+  auto& timer = m_compQuadTimers[m_compQuadTimerIndex];
+  if (!timer.begin || !timer.end)
+    return;
+  if (begin)
+  {
+    if (timer.pending)
+      return; // (its result is not back yet: this composite is not timed)
+    m_glQueryCounterEXT(timer.begin, GL_TIMESTAMP_EXT);
+    timer.begun = true;
+  }
+  else if (timer.begun)
+  {
+    m_glQueryCounterEXT(timer.end, GL_TIMESTAMP_EXT);
+    timer.begun = false;
+    timer.pending = true;
+    m_compQuadTimerIndex = (m_compQuadTimerIndex + 1) % m_compQuadTimers.size();
+  }
+}
+
+void CWinSystemGbmGLESContext::CompQuadTimerCollect()
+{
+  if (!m_glGetQueryObjectuivEXT || !m_compQuadTimers[0].begin)
+    return;
+  GLint disjoint = 0;
+  glGetIntegerv(GL_GPU_DISJOINT_EXT, &disjoint);
+  for (size_t n = 0; n < m_compQuadTimers.size(); ++n)
+  {
+    auto& timer = m_compQuadTimers[(m_compQuadTimerIndex + n) % m_compQuadTimers.size()];
+    if (!timer.pending)
+      continue;
+    GLuint available = 0;
+    m_glGetQueryObjectuivEXT(timer.end, GL_QUERY_RESULT_AVAILABLE_EXT, &available);
+    if (!available)
+      break;
+    timer.pending = false;
+    if (disjoint)
+      continue;
+    GLuint64 start = 0, finish = 0;
+    m_glGetQueryObjectui64vEXT(timer.begin, GL_QUERY_RESULT_EXT, &start);
+    m_glGetQueryObjectui64vEXT(timer.end, GL_QUERY_RESULT_EXT, &finish);
+    if (finish <= start)
+      continue;
+    const double ms = static_cast<double>(finish - start) / 1e6;
+    ++m_dvStats.compQuadDrawn;
+    m_dvStats.compQuadSumMs += ms;
+    m_dvStats.compQuadMaxMs = std::max(m_dvStats.compQuadMaxMs, ms);
+  }
+}
