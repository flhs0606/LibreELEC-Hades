+// Hades: the fast mode of the mapping grew into a choice of two ways
+// (videoscreen.hadesdtmfastmode), once, when the settings are loaded: the switch of an earlier
+// build (videoscreen.hadesdtmfast) turned on is carried to the way without the enhancement
+// layer and turned off again, so that it is carried only once; the way is only written while
+// it is at its default, so what was chosen in this build stays.
+bool MigrateDtmFast(CSettingsManager& manager)
+{
+  const auto fast = std::dynamic_pointer_cast<CSettingBool>(
+      manager.GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDTMFAST));
+  const auto mode = std::dynamic_pointer_cast<CSettingInt>(
+      manager.GetSetting(CSettings::SETTING_VIDEOSCREEN_HADESDTMFASTMODE));
+  if (fast && mode && fast->GetValue() && mode->GetValue() == mode->GetDefault() &&
+      mode->SetValue(1))
+  {
+    CLog::Log(LOGINFO,
+              "CSettings: \"{}\" takes over \"{}\" (on), which an earlier build saved",
+              CSettings::SETTING_VIDEOSCREEN_HADESDTMFASTMODE,
+              CSettings::SETTING_VIDEOSCREEN_HADESDTMFAST);
+    // (the switch is spent, whatever the way is set to later: it is not taken over again at
+    // the next start)
+    fast->SetValue(false);
+    return true;
+  }
+  return false;
+}
+
