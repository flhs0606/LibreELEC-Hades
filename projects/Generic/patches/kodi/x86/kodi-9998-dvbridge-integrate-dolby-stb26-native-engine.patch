diff --git a/tools/dvbridge/dv_stb26/decoder_lifecycle.c b/tools/dvbridge/dv_stb26/decoder_lifecycle.c
new file mode 100644
index 0000000..75b947e
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/decoder_lifecycle.c
@@ -0,0 +1,120 @@
+/* Initialize decoder storage and install callbacks. */
+#include "decoder_lifecycle.h"
+#include "fixed_access.h"
+#include "parser_access.h"
+#include "parser_layout.h"
+#include "parser_api.h"
+
+typedef char decoder_lifecycle_uint32[(sizeof(unsigned int) == 4) ? 1 : -1];
+typedef char decoder_lifecycle_uint64[(sizeof(unsigned long long) == 8) ? 1 : -1];
+typedef char decoder_lifecycle_pointer64[(sizeof(void *) == 8) ? 1 : -1];
+typedef char decoder_lifecycle_callbacks64
+    [(sizeof(rpu_msg_log_func_t) == 8 && sizeof(dec_event_callback_t) == 8) ? 1 : -1];
+typedef char decoder_lifecycle_severity32[(sizeof(rpu_print_severity_t) == 4) ? 1 : -1];
+
+static const unsigned int level_limits[16][5] = {
+    {1u, 1u, 9u, 2u, 0u}, {4u, 4u, 11u, 2u, 3u},
+    {8u, 8u, 17u, 2u, 7u}, {0u, 0u, 0u, 0u, 0u},
+    {0u, 0u, 0u, 0u, 0u}, {0u, 0u, 0u, 0u, 0u},
+    {0u, 0u, 0u, 0u, 0u}, {0u, 0u, 0u, 0u, 0u},
+    {0u, 0u, 0u, 0u, 0u}, {0u, 0u, 0u, 0u, 0u},
+    {0u, 0u, 0u, 0u, 0u}, {0u, 0u, 0u, 0u, 0u},
+    {0u, 0u, 0u, 0u, 0u}, {0u, 0u, 0u, 0u, 0u},
+    {0u, 0u, 0u, 0u, 0u}, {0u, 0u, 0u, 0u, 0u}
+};
+
+int dovi_rpu_decoder_init(void *decoder, const unsigned char *config)
+{
+    unsigned char *arena = (unsigned char *)decoder;
+    unsigned int payload_only, input_slots, i, max_prev, partitions, level;
+    const unsigned int *limits;
+    unsigned char *input_buffer, *slot_levels, *rpu_context, *rpu_data, *rpu_header, *dm_payload,
+        *partition_payload;
+
+    parser_zero_bytes(arena, 0x316e8u);
+    payload_only = fixed_load_le32(config + 0xc);
+    fixed_store_le32(arena + DECODER_DIRECT_MODE, payload_only);
+    fixed_store_le32(arena + DECODER_DISABLE_MEL, fixed_load_le32(config + 0x14));
+    fixed_store_le32(arena + DECODER_DISABLE_CRC, fixed_load_le32(config + 0x8));
+    input_slots = payload_only == 0 ? 64u : 1u;
+    fixed_store_le32(arena + DECODER_SLOT_COUNT, input_slots);
+
+    input_buffer = arena + 0x316e8;
+    slot_levels = input_buffer + input_slots * 0x1000u;
+    parser_store_pointer(arena + DECODER_INPUT_STORAGE, input_buffer);
+    parser_store_pointer(arena + DECODER_SLOT_LENGTHS, slot_levels);
+    /* Clear precisely 4100 bytes, even with 64 input slots. */
+    parser_zero_bytes(input_buffer, 0x1004u);
+    rpu_context = slot_levels + input_slots * 4u;
+    parser_store_pointer(arena + DECODER_CONFIG, rpu_context);
+    parser_zero_bytes(rpu_context, 0x87cu);
+    fixed_store_le32(arena + DECODER_SEQUENCE_AVAILABLE, 0);
+    fixed_store_le32(arena + 0x7c, 0);
+    fixed_store_le32(arena + 0x80, 0);
+
+    level = fixed_load_le32(config + 4);
+#if PARSER_FATAL_ARRAY_LIMITS
+    if (level >= 16u)
+        parser_limit_trap();
+#endif
+    limits = level_limits[level];
+    partitions = limits[0] * limits[1];
+    max_prev = limits[4];
+    fixed_store_le32(rpu_context + 0x66c, partitions);
+    fixed_store_le32(rpu_context + 0x670, limits[2]);
+    fixed_store_le32(rpu_context + 0x674, limits[3]);
+    fixed_store_le32(rpu_context + 0x678, max_prev);
+
+    rpu_data = rpu_context + 0x87c;
+    parser_store_pointer(arena, rpu_data);
+    parser_zero_bytes(rpu_data, 0x18u);
+    rpu_header = rpu_data + 0x18;
+    parser_store_pointer(rpu_data, rpu_header);
+    parser_zero_bytes(rpu_header, 0x136u);
+    dm_payload = rpu_header + 0x136;
+    parser_store_pointer(rpu_data + 0x10, dm_payload);
+    parser_zero_bytes(dm_payload, 0x10744u);
+    partition_payload = dm_payload + 0x10744;
+    parser_store_pointer(arena + DECODER_PAYLOAD_STORAGE, partition_payload);
+    /* Fixed two-payload clear; larger partition arenas retain caller bytes. */
+    parser_zero_bytes(partition_payload, 0xe070u);
+
+    for (i = 1; i < max_prev + 2u; ++i) {
+        unsigned int partition_offset = i * partitions;
+        parser_store_pointer(arena + DECODER_PAYLOAD_STORAGE + i * 8u,
+                             partition_payload + (unsigned long long)partition_offset * 0x7038u);
+    }
+    for (i = 0; i < max_prev + 1u; ++i) {
+        unsigned int partition_offset = i * partitions;
+        parser_store_pointer(arena + DECODER_PAYLOAD_SLOTS + i * 8u,
+                             partition_payload + (unsigned long long)partition_offset * 0x7038u);
+    }
+    parser_store_pointer(arena + DECODER_CURRENT_PAYLOAD,
+                         partition_payload +
+                             (unsigned long long)((max_prev + 1u) * partitions) * 0x7038u);
+
+    fixed_store_le32(arena + DECODER_FRAMING_STATE, payload_only == 0 ? 0u : 4u);
+    fixed_store_le32(arena + DECODER_INPUT_SLOT, payload_only == 0 ? input_slots - 1u : 0u);
+    fixed_store_le32(arena + DECODER_OUTPUT_SLOT, 0);
+    for (i = 0; i < input_slots; ++i)
+        fixed_store_le32(slot_levels + i * 4u, 0);
+    return 0;
+}
+
+int dovi_rpu_decoder_cleanup(void *decoder)
+{
+    (void)decoder;
+    return 0;
+}
+
+void dovi_rpu_decoder_set_msg_log(void *decoder, rpu_msg_log_func_t msg_log,
+                                  unsigned int print_severity)
+{
+    parser_copy8((unsigned char *)decoder + DECODER_LOGGER, &msg_log);
+    fixed_store_le32((unsigned char *)decoder + DECODER_SEVERITY, print_severity);
+}
+
+void dovi_register_dec_event_callback(void *decoder, dec_event_callback_t callback)
+{
+    parser_copy8((unsigned char *)decoder + DECODER_EVENT_CALLBACK, &callback);
+}
diff --git a/tools/dvbridge/dv_stb26/decoder_lifecycle.h b/tools/dvbridge/dv_stb26/decoder_lifecycle.h
new file mode 100644
index 0000000..cd1a251
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/decoder_lifecycle.h
@@ -0,0 +1,77 @@
+#ifndef DOVI_DECODER_LIFECYCLE_H
+#define DOVI_DECODER_LIFECYCLE_H
+
+#define DOVI_DECODER_BASE_SIZE 0x316e8u
+#define DOVI_DECODER_INIT_CONFIG_MIN_SIZE 0x18u
+
+/* Initialize caller-owned decoder storage using 64-bit little-endian layouts.
+ * Decoder and config storage must be disjoint and externally serialized.
+ * No allocation happens here.
+ * Setters store callback addresses and severity through byte accesses without
+ * requiring aligned decoder storage. Decoding invokes callbacks through their
+ * declared function types; logger return values are ignored.
+ */
+
+/*
+ * config provides at least DOVI_DECODER_INIT_CONFIG_MIN_SIZE readable bytes
+ * of the disjoint rpu_init_flags_t layout.
+ * Reads LE u32 level (+4), disable_crc_check (+8), payload_only (+0xc), and
+ * disable_MEL_detection (+0x14). Supported level indices are 0..15.
+ * decoder must be writable for the arena described in ../docs/parser.md.
+ * STB 2.4 requires a valid level; STB 2.6 traps for level >=16 after
+ * partial initialization. Otherwise the function returns zero.
+ * Levels 3..15 retain the fixed 0xe070-byte payload clear beyond the
+ * memory query; their callers must provide that additional backing.
+ */
+
+typedef enum {
+    S_RPU_EMERGENCY = 0,
+    S_RPU_ALERT = 1,
+    S_RPU_CRITICAL = 2,
+    S_RPU_ERROR = 3,
+    S_RPU_WARNING = 4,
+    S_RPU_NOTICE = 5,
+    S_RPU_INFORMATIONAL = 6,
+    S_RPU_DEBUG = 7,
+    S_RPU_NEVERPRINT = 8,
+} rpu_print_severity_t;
+
+typedef int (*rpu_msg_log_func_t)(const char *format, ...);
+typedef void (*dec_event_callback_t)(rpu_print_severity_t severity, unsigned int code,
+                                     char *message);
+
+/* Layout used by the decoder flush interface. */
+struct rpu_setter_view {
+    unsigned char before_last[0x28];
+    int last; /* +0x28 */
+    unsigned char before_msg_log[0x3159c];
+    rpu_msg_log_func_t msg_log;          /* +0x315c8 */
+    rpu_print_severity_t print_severity; /* +0x315d0 */
+    unsigned char before_event_callback[0x104];
+    dec_event_callback_t event_callback; /* +0x316d8 */
+    unsigned char after_event_callback[8];
+};
+
+typedef char setters_pointer_is_eight_bytes[(sizeof(void *) == 8) ? 1 : -1];
+typedef char setters_int_is_four_bytes[(sizeof(int) == 4) ? 1 : -1];
+typedef char setters_severity_is_four_bytes[(sizeof(rpu_print_severity_t) == 4) ? 1 : -1];
+typedef char setters_view_is_202472_bytes[(sizeof(struct rpu_setter_view) == 0x316e8) ? 1 : -1];
+#if defined(__GNUC__) || defined(__clang__)
+typedef char
+    setters_last_offset[(__builtin_offsetof(struct rpu_setter_view, last) == 0x28) ? 1 : -1];
+typedef char setters_msg_log_offset[(__builtin_offsetof(struct rpu_setter_view, msg_log) == 0x315c8)
+                                        ? 1
+                                        : -1];
+typedef char setters_severity_offset
+    [(__builtin_offsetof(struct rpu_setter_view, print_severity) == 0x315d0) ? 1 : -1];
+typedef char setters_event_offset
+    [(__builtin_offsetof(struct rpu_setter_view, event_callback) == 0x316d8) ? 1 : -1];
+#endif
+
+int dovi_rpu_decoder_init(void *decoder, const unsigned char *config);
+int dovi_rpu_decoder_cleanup(void *decoder);
+void dovi_rpu_decoder_set_msg_log(void *decoder, rpu_msg_log_func_t msg_log,
+                                  unsigned int print_severity);
+void dovi_register_dec_event_callback(void *decoder, dec_event_callback_t callback);
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/detect_mel.c b/tools/dvbridge/dv_stb26/detect_mel.c
new file mode 100644
index 0000000..6caa41c
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/detect_mel.c
@@ -0,0 +1,49 @@
+#include "detect_mel.h"
+
+#define MEL_PAYLOAD_SCOPE
+/* Merged from detect_mel_impl.inc */
+/* Identify minimal enhancement layer payloads from their NLQ parameters. */
+#include "nlq_layout.h"
+typedef char require_32bit_uint[(sizeof(unsigned int) == 4) ? 1 : -1];
+
+static unsigned int read_le16(const unsigned char *p)
+{
+    return (unsigned int)p[0] | ((unsigned int)p[1] << 8);
+}
+
+static unsigned int read_le32(const unsigned char *p)
+{
+    return (unsigned int)p[0] | ((unsigned int)p[1] << 8) | ((unsigned int)p[2] << 16) |
+           ((unsigned int)p[3] << 24);
+}
+
+MEL_PAYLOAD_SCOPE int dovi_detect_mel_payload(const unsigned char *payload)
+{
+    unsigned int component;
+
+    for (component = 0; component < 3; ++component) {
+        const unsigned char *entry =
+            payload + DOVI_NLQ_PARAMETERS_OFFSET + component * DOVI_NLQ_PARAMETER_BYTES;
+
+        /*
+         * Bytes +2/+3 are ignored when reading the 16-bit field.
+         * Read each field at its encoded width in comparison order.
+         */
+        if (read_le16(entry + DOVI_NLQ_OFFSET) != 0 ||
+            read_le32(entry + DOVI_NLQ_LINEAR_SLOPE_INT) != 0 ||
+            read_le32(entry + DOVI_NLQ_LINEAR_SLOPE_FRACTION) != 0 ||
+            read_le32(entry + DOVI_NLQ_VDR_IN_MAX_INT) != 1 ||
+            read_le32(entry + DOVI_NLQ_VDR_IN_MAX_FRACTION) != 0 ||
+            read_le32(entry + DOVI_NLQ_LINEAR_THRESHOLD_INT) != 0 ||
+            read_le32(entry + DOVI_NLQ_LINEAR_THRESHOLD_FRACTION) != 0)
+            return 0;
+    }
+    return 1;
+}
+
+#undef MEL_PAYLOAD_SCOPE
+
+int dovi_detect_mel(const struct dovi_decoder_prefix *decoder)
+{
+    return dovi_detect_mel_payload(decoder->root->payload);
+}
