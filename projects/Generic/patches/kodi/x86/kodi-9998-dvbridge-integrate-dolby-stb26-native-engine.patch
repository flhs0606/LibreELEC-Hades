diff --git a/tools/dvbridge/dv_stb26/dm_extensions.c b/tools/dvbridge/dv_stb26/dm_extensions.c
new file mode 100644
index 0000000..3068834
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_extensions.c
@@ -0,0 +1,115 @@
+/* Display-metadata extension record updates. */
+#include "dm_extensions.h"
+
+/* Merged from dm_extensions_impl.inc */
+/* Sort, replace and remove extension records without copying padding. */
+typedef unsigned char byte;
+typedef unsigned int u32;
+typedef char require_uint32[(sizeof(u32) == 4) ? 1 : -1];
+typedef char require_pointer64[(sizeof(void *) == 8) ? 1 : -1];
+
+static void copy_record(byte *dest, const byte *source)
+{
+    u32 i;
+    for (i = 0; i < 4u; ++i)
+        dest[i] = source[i];
+    dest[4] = source[4];
+    for (i = 6; i < 0x106u; ++i)
+        dest[i] = source[i];
+}
+
+/* Read the sentinel, including when position == count. */
+static byte scratch_type(const byte *scratch, u32 position)
+{
+    return ((const volatile byte *)scratch)[position * 0x108u + 4u];
+}
+
+static u32 sort_existing(byte *dm, byte *scratch)
+{
+    u32 copied = 0, type;
+    for (type = 1; type < 256u; ++type) {
+        u32 i;
+        for (i = 0; i < dm[0x4a]; ++i) {
+            const byte *record = dm + 0x4c + i * 0x108u;
+            if (record[4] == type) {
+                copy_record(scratch + copied * 0x108u, record);
+                ++copied;
+            }
+        }
+        if (copied == dm[0x4a])
+            break;
+    }
+    return copied;
+}
+
+void dovi_remove_dm_extensions(void *dm, const unsigned char *remove, void *scratch)
+{
+    byte *d = (byte *)dm;
+    byte *s = (byte *)scratch;
+    u32 count = sort_existing(d, s);
+    u32 position = 0, written = 0, type;
+
+    for (type = 1; type < 256u; ++type) {
+        if (scratch_type(s, position) == type && position < count) {
+            do {
+                if (remove[type] == 0) {
+                    copy_record(d + 0x4c + (written & 255u) * 0x108u, s + position * 0x108u);
+                    ++written;
+                }
+                ++position;
+            } while (scratch_type(s, position) == type && position < count);
+        }
+        if ((position & 255u) == count)
+            break;
+    }
+    d[0x4a] = (byte)written;
+}
+
+void dovi_update_dm_extensions(void *dm, const void *blocks, unsigned int count, void *scratch)
+{
+    byte *d = (byte *)dm;
+    const byte *input = (const byte *)blocks;
+    byte *s = (byte *)scratch;
+    u32 old_count = sort_existing(d, s);
+    u32 old_position = 0, written = 0, used_new = 0, type;
+
+    for (type = 1; type < 256u; ++type) {
+        u32 i;
+        int replaced = 0;
+        if (count != 0 && count < 0x80000000u) {
+            for (i = 0; i < count; ++i) {
+                const byte *record = input + (unsigned long long)i * 0x108u;
+                if (record[4] != type)
+                    continue;
+                /* The type is read before the boundary condition. */
+                while (scratch_type(s, old_position) == type && old_position < old_count)
+                    ++old_position;
+                copy_record(d + 0x4c + (written & 255u) * 0x108u, record);
+                ++written;
+                ++used_new;
+                replaced = 1;
+            }
+        }
+        if (!replaced && scratch_type(s, old_position) == type && old_position < old_count) {
+            do {
+                copy_record(d + 0x4c + (written & 255u) * 0x108u, s + old_position * 0x108u);
+                ++written;
+                ++old_position;
+            } while (scratch_type(s, old_position) == type && old_position < old_count);
+        }
+        if (used_new == count && old_position == old_count)
+            break;
+    }
+    d[0x4a] = (byte)written;
+}
+
+
+void dovi_append_dm_extensions(void *dm, const void *blocks, unsigned char count)
+{
+    byte *d = (byte *)dm;
+    const byte *input = (const byte *)blocks;
+    u32 original_count = d[0x4a], i;
+    for (i = 0; i < count; ++i)
+        copy_record(d + 0x4c + (original_count + i) * 0x108u, input + i * 0x108u);
+    d[0x4a] = (byte)(d[0x4a] + count);
+}
diff --git a/tools/dvbridge/dv_stb26/dm_extensions.h b/tools/dvbridge/dv_stb26/dm_extensions.h
new file mode 100644
index 0000000..cb83d24
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_extensions.h
@@ -0,0 +1,34 @@
+/* Sort, replace, remove and append display-metadata extension records. */
+#ifndef DOVI_DM_EXTENSIONS_H
+#define DOVI_DM_EXTENSIONS_H
+
+#include "parser_contract.h"
+
+#define DOVI_DM_EXTENSION_STRIDE 0x108u
+#define DOVI_DM_EXTENSION_COUNT_OFFSET 0x4au
+#define DOVI_DM_EXTENSION_RECORDS_OFFSET 0x4cu
+
+/*
+ * DM count is a byte at +0x4a; records start at +0x4c with stride 0x108.
+ * Each record contains a four-byte value at +0, byte type at +4 and 256
+ * payload bytes at +6. Copies leave padding +5, +0x106 and +0x107 untouched.
+ * Buffers must be valid, disjoint and stable. Removal masks span 256 bytes.
+ * Scratch needs count+1 accessible records: the original reads a sentinel
+ * type before checking the count, even for an empty list. Scratch writes
+ * preserve padding and all records beyond the number sorted.
+ *
+ * update/remove sort types 1..255, omitting type 0. New records replace all
+ * existing records of their type; duplicate new records retain their order.
+ * update treats count as signed32 for its input-loop enable check, while
+ * its other comparisons preserve the original unsigned value. Output count
+ * and output write indices wrap at 256. Append writes linearly, requiring
+ * space for old count + new count records even though its count wraps.
+ * No buffer bounds checks or fixes are introduced.
+ */
+void dovi_update_dm_extensions(void *dm, const void *blocks, unsigned int count, void *scratch);
+void dovi_remove_dm_extensions(void *dm, const unsigned char *remove, void *scratch);
+#if PARSER_DECODER_EXTENSION_API
+void dovi_append_dm_extensions(void *dm, const void *blocks, unsigned char count);
+#endif
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/dm_frame_format.c b/tools/dvbridge/dv_stb26/dm_frame_format.c
new file mode 100644
index 0000000..f31f17f
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_frame_format.c
@@ -0,0 +1,75 @@
+/* Frame-format layout and parameters. */
+#include "dm_bindings.h"
+#include "dm_layout.h"
+
+void dovi_dm_CommitCdm2KsFrmFmt(long signal, unsigned int flags, unsigned int *frame_words)
+{
+    const struct dm_signal_environment *environment = (const void *)signal;
+    struct dm_frame_format *format = (void *)frame_words;
+    unsigned int data_type;
+    unsigned int weave;
+    unsigned int components;
+
+    format->height = (unsigned int)environment->height;
+    format->width = (unsigned int)environment->width;
+    format->location = environment->location != 0;
+    format->row_pitch = (unsigned int)environment->row_pitch;
+    format->chroma_row_pitch = (unsigned int)environment->chroma_row_pitch;
+    if ((flags & 2u) != 0) {
+        return;
+    }
+    data_type = (unsigned int)environment->data_type;
+    format->data_type = data_type == 0u ? 0 : data_type == 1u ? 1 : 2;
+    weave = (unsigned int)environment->weave;
+    format->weave = weave == 0u ? 0 : weave == 1u ? 1 : 2;
+    format->bit_depth = (char)(unsigned int)environment->bit_depth;
+    components = 1u;
+    if (environment->weave != 0) {
+        if (environment->color_space == DM_FRAME_COLOR_RGBA)
+            components = 4u;
+        else if (environment->color_space != DM_FRAME_COLOR_GRAY)
+            components = environment->chroma_format == DM_FRAME_CHROMA_422 ? 2u : 3u;
+    }
+    /* Reload after the preceding writes: overlapping views remain observable. */
+    data_type = (unsigned int)environment->data_type;
+    format->column_pitch = dm_frame_sample_bytes(data_type) * components;
+}
+
+void dovi_dm_CommitMds2KsFrmFmt(unsigned char *metadata, long frame)
+{
+    const struct dm_metadata_format *source = (const void *)metadata;
+    struct dm_frame_format *format = (void *)frame;
+    char weave;
+    unsigned char bit_depth;
+    int bytes_per_sample;
+    int column_pitch;
+
+    if ((metadata != 0) && ((source->flags & 1) != 0)) {
+        bit_depth = source->bit_depth;
+        format->data_type = bit_depth < 9;
+        weave = '\0';
+        if (source->chroma_format != 0) {
+            weave = (source->chroma_format == 1) << 1;
+        }
+        format->weave = weave;
+        format->bit_depth = source->bit_depth;
+        if (weave == '\0') {
+            column_pitch = 1;
+            if (8 < bit_depth) {
+                column_pitch = 2;
+            }
+        } else {
+            column_pitch = 2;
+            if (source->chroma_format != 1) {
+                column_pitch = 3;
+            }
+            bytes_per_sample = 1;
+            if (8 < bit_depth) {
+                bytes_per_sample = 2;
+            }
+            column_pitch = column_pitch * bytes_per_sample;
+        }
+        format->column_pitch = column_pitch;
+    }
+    return;
+}
