diff --git a/tools/dvbridge/dv_stb26/color_basis.c b/tools/dvbridge/dv_stb26/color_basis.c
new file mode 100644
index 0000000..1384e2a
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/color_basis.c
@@ -0,0 +1,120 @@
+/* Fixed-point color bases and forward element-wise copies. */
+#include "color_basis.h"
+#include "color_basis_impl.h"
+
+void dovi_AssignV3I2I(const void *source, void *destination)
+{
+    color_assign_vector(source, destination);
+}
+
+void dovi_AssignM33I322I(const void *source, void *destination)
+{
+    color_assign_matrix32_to16(source, destination);
+}
+
+void dovi_AssignM33I2I(const void *source, void *destination)
+{
+    color_assign_matrix16(source, destination);
+}
+
+void dovi_GetRgb2LmsWpV3(const void *matrix, void *destination)
+{
+    color_rgb_to_lms_white(matrix, destination);
+}
+
+unsigned int dovi_GetIpt2LmsM33Fxp(void *output)
+{
+    color_assign_matrix16(color_ipt2_lms, output);
+    return 15;
+}
+
+unsigned int dovi_GetLms2IptM33Fxp(void *output)
+{
+    color_assign_matrix16(color_lms2_ipt, output);
+    return 12;
+}
+
+void dovi_GetCtM33(unsigned int value, void *destination, unsigned int scale)
+{
+    unsigned char *d = destination;
+    unsigned int diagonal = (1u << (scale & 31)) - 2u * value;
+    fixed_store_le32(d + 8, value);
+    fixed_store_le32(d + 12, value);
+    fixed_store_le32(d + 24, value);
+    fixed_store_le32(d + 28, value);
+    fixed_store_le32(d, diagonal);
+    fixed_store_le32(d + 4, value);
+    fixed_store_le32(d + 16, diagonal);
+    fixed_store_le32(d + 20, value);
+    fixed_store_le32(d + 32, diagonal);
+}
+
+void dovi_GetInvCtM33(unsigned int value, void *destination, unsigned int scale)
+{
+    unsigned char *d = destination;
+    unsigned int base = 1u << (scale & 31), raw_denominator = base - 3u * value;
+    long long denominator = (raw_denominator & 0x80000000u)
+                                ? -(long long)(0x100000000ull - raw_denominator)
+                                : (long long)raw_denominator;
+    /* The even masked shift is at most 62: the numerator is always positive.
+     * AArch64 SDIV returns zero for a zero divisor. Multiplication then wraps. */
+    long long numerator = (long long)(1ull << ((2u * scale) & 63));
+    unsigned int quotient = denominator ? (unsigned int)(numerator / denominator) : 0;
+    unsigned int diagonal = fixed_asr32((base - value) * quotient, scale);
+    unsigned int off = 0u - fixed_asr32(quotient * value, scale);
+    fixed_store_le32(d + 32, diagonal);
+    fixed_store_le32(d, diagonal);
+    fixed_store_le32(d + 4, off);
+    fixed_store_le32(d + 8, off);
+    fixed_store_le32(d + 12, off);
+    fixed_store_le32(d + 16, diagonal);
+    fixed_store_le32(d + 20, off);
+    fixed_store_le32(d + 24, off);
+    fixed_store_le32(d + 28, off);
+}
+
+unsigned int dovi_GetXyz2LmsM33(void *destination)
+{
+    unsigned char *d = destination;
+    fixed_store_le64(d, 0x0b524d3306676031ull);
+    fixed_store_le64(d + 8, 0xfc61153efeb50535ull);
+    fixed_store_le16(d + 20, 0x30bcu);
+    fixed_store_le32(d + 16, 0x12a521f6u);
+    d[22] = 0xbb;
+    fixed_store_le64(d + 23, 0);
+    fixed_store_le32(d + 32, 0x0eb10ca5u);
+    d[31] = 0;
+    return 28;
+}
+
+static void matrix16(void *destination, unsigned long long a, unsigned long long b, unsigned int c)
+{
+    unsigned char *d = destination;
+    fixed_store_le64(d, a);
+    fixed_store_le64(d + 8, b);
+    fixed_store_le16(d + 16, c);
+}
+
+unsigned int dovi_GetLms2IctcpIoM33(void *d)
+{
+    matrix16(d, 0x19d2000008000800ull, 0xbc12460d1b5bcad3ull, 0xfde1);
+    return 12;
+}
+
+unsigned int dovi_GetIctcpIo2LmsM33(void *d)
+{
+    matrix16(d, 0x7fff0e36011a7fffull, 0x47af7ffff1cafee6ull, 0xd6f6);
+    return 15;
+}
+
+unsigned int dovi_GetLms2IctcpDmM33(void *d)
+{
+    matrix16(d, 0x0ce9000008000800ull, 0xbc12460d0dade56aull, 0xfde1);
+    return 12;
+}
+
+unsigned int dovi_GetIctcpDm2LmsM33(void *d)
+{
+    matrix16(d, 0x4000071b011a4000ull, 0x47af4000f8e5fee6ull, 0xeb7b);
+    return 14;
+}
diff --git a/tools/dvbridge/dv_stb26/color_basis.h b/tools/dvbridge/dv_stb26/color_basis.h
new file mode 100644
index 0000000..76faf66
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/color_basis.h
@@ -0,0 +1,23 @@
+#ifndef DOVI_COLOR_BASIS_H
+#define DOVI_COLOR_BASIS_H
+
+/* Byte-addressed color data requires no alignment. Copies load each element
+ * before storing it; row sums load a whole row before storing the result. */
+/* Copy three 32-bit little-endian elements in forward order. */
+void dovi_AssignV3I2I(const void *source, void *destination);
+void dovi_AssignM33I322I(const void *source, void *destination);
+void dovi_AssignM33I2I(const void *source, void *destination);
+void dovi_GetRgb2LmsWpV3(const void *matrix, void *destination);
+unsigned int dovi_GetIpt2LmsM33Fxp(void *output);
+unsigned int dovi_GetLms2IptM33Fxp(void *output);
+
+/* Scalar integers expose the original two's-complement register bits. */
+void dovi_GetCtM33(unsigned int value, void *destination, unsigned int scale);
+void dovi_GetInvCtM33(unsigned int value, void *destination, unsigned int scale);
+unsigned int dovi_GetXyz2LmsM33(void *destination);
+unsigned int dovi_GetLms2IctcpIoM33(void *destination);
+unsigned int dovi_GetIctcpIo2LmsM33(void *destination);
+unsigned int dovi_GetLms2IctcpDmM33(void *destination);
+unsigned int dovi_GetIctcpDm2LmsM33(void *destination);
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/color_basis_impl.h b/tools/dvbridge/dv_stb26/color_basis_impl.h
new file mode 100644
index 0000000..066d9dc
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/color_basis_impl.h
@@ -0,0 +1,53 @@
+/* Shared LMS/IPT coefficients and forward element-wise color copies. */
+#ifndef DOVI_COLOR_BASIS_IMPL_H
+#define DOVI_COLOR_BASIS_IMPL_H
+#include "fixed_access.h"
+
+static const short color_lms2_ipt[9] = {
+    1638, 1638, 819, 18248, -19870, 1622, 3300, 1463, -4763
+};
+static const short color_ipt2_lms[9] = {
+    32767, 3196, 6725, 32767, -3731, 4365, 32767, 1069, -22180
+};
+
+static inline void color_assign_vector(const void *source, void *destination)
+{
+    const unsigned char *s = source;
+    unsigned char *d = destination;
+    unsigned int i;
+    for (i = 0; i < 3; ++i)
+        fixed_store_le32(d + i * 4u, fixed_load_le32(s + i * 4u));
+}
+
+static inline void color_assign_matrix16(const void *source, void *destination)
+{
+    const unsigned char *s = source;
+    unsigned char *d = destination;
+    unsigned int i;
+    for (i = 0; i < 9; ++i)
+        fixed_store_le16(d + i * 2u, fixed_load_le16(s + i * 2u));
+}
+
+static inline void color_assign_matrix32_to16(const void *source, void *destination)
+{
+    const unsigned char *s = source;
+    unsigned char *d = destination;
+    unsigned int i;
+    for (i = 0; i < 9; ++i)
+        fixed_store_le16(d + i * 2u, fixed_load_le32(s + i * 4u));
+}
+
+static inline void color_rgb_to_lms_white(const void *matrix, void *destination)
+{
+    const unsigned char *s = matrix;
+    unsigned char *d = destination;
+    unsigned int row;
+    for (row = 0; row < 3; ++row) {
+        unsigned int a = fixed_sign16(fixed_load_le16(s + row * 6u));
+        unsigned int b = fixed_sign16(fixed_load_le16(s + row * 6u + 2u));
+        unsigned int c = fixed_sign16(fixed_load_le16(s + row * 6u + 4u));
+        fixed_store_le32(d + row * 4u, a + b + c);
+    }
+}
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/color_narrow.c b/tools/dvbridge/dv_stb26/color_narrow.c
new file mode 100644
index 0000000..1d8e010
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/color_narrow.c
@@ -0,0 +1,110 @@
+/* Fixed-point conversion between full and narrow color ranges. */
+#include "fixed_access.h"
+#include "color_narrow.h"
+#include "color_basis_impl.h"
+#include "matrix_arithmetic.h"
+
+static unsigned int sdiv32(unsigned int a, unsigned int b)
+{
+    return fixed_raw_divide32(a, b);
+}
+
+static unsigned long long product(unsigned int value, int coefficient)
+{
+    return fixed_sign32(value) * (unsigned long long)(long long)coefficient;
+}
+
+static unsigned int ratio(unsigned int depth, unsigned int width, unsigned int inverse)
+{
+    unsigned int mask = ~(0xffffffffu << (depth & 31));
+    unsigned int shift = (depth - 8u) & 31;
+    return inverse ? sdiv32(mask << 16, width << shift) : sdiv32((width << 16) << shift, mask);
+}
+
+void dovi_GetYuvRgbOffFxp(unsigned int range, unsigned int bits, void *output)
+{
+    unsigned char *out = output;
+    unsigned int chroma = 1u << ((bits - 1u) & 31u);
+    fixed_store_le32(out, range ? 0u : 1u << ((bits - 4u) & 31u));
+    fixed_store_le32(out + 4u, chroma);
+    fixed_store_le32(out + 8u, chroma);
+}
+
+unsigned int dovi_GetLms2IptM33NarrowFxp(unsigned int bits, void *output)
+{
+    unsigned int factor = ratio(fixed_sign16(bits), 219, 0), i;
+    unsigned long long temporary[9];
+    for (i = 0; i < 9; ++i)
+        temporary[i] = product(factor, color_lms2_ipt[i]);
+    return dovi_Adjust64M33ScaleTo16M33(temporary, 28, output);
+}
+
+unsigned int dovi_GetIpt2LmsM33NarrowFxp(unsigned int bits, void *output)
+{
+    unsigned int factor = ratio(fixed_sign16(bits), 219, 1), i;
+    unsigned long long temporary[9];
+    for (i = 0; i < 9; ++i)
+        temporary[i] = product(factor, color_ipt2_lms[i]);
+    return dovi_Adjust64M33ScaleTo16M33(temporary, 31, output);
+}
+
+void dovi_GetYuv2RgbFromKrKgKbM33(unsigned int kr, unsigned int kg, unsigned int kb, void *output)
+{
+    unsigned char *out = output;
+    unsigned int red = (unsigned int)kr, green = (unsigned int)kg, blue = (unsigned int)kb;
+    fixed_store_le64(out, 0x4000000);
+    fixed_store_le64(out + 8u, 0);
+    fixed_store_le64(out + 16u, fixed_sign32((0x4000000u - red) * 2u));
+    fixed_store_le64(out + 24u, 0x4000000);
+    if (green != 0u) {
+        unsigned long long red_product = fixed_sign32(red) * fixed_sign32(0x4000000u - red) * 2ull;
+        unsigned long long blue_product =
+            fixed_sign32(blue) * fixed_sign32(0x4000000u - blue) * 2ull;
+        fixed_store_le64(out + 32u, fixed_raw_divide64(0ull - blue_product, fixed_sign32(green)));
+        fixed_store_le64(out + 40u, fixed_raw_divide64(0ull - red_product, fixed_sign32(green)));
+    }
+    fixed_store_le64(out + 48u, 0x4000000);
+    fixed_store_le64(out + 56u, fixed_sign32(0x8000000u - 2u * blue));
+    fixed_store_le64(out + 64u, 0);
+}
+
+unsigned int dovi_GetLms2IctcpIoM33Narrow(unsigned int depth, void *matrix)
+{
+    unsigned int y, c;
+    unsigned long long values[9];
+    if ((depth >> 31) || depth < 9)
+        depth = 8;
+    y = ratio(depth, 219, 0);
+    c = ratio(depth, 224, 0);
+    values[0] = product(y, 2048);
+    values[1] = values[0];
+    values[2] = 0;
+    values[3] = product(c, 6610);
+    values[4] = product(c, -13613);
+    values[5] = product(c, 7003);
+    values[6] = product(c, 17933);
+    values[7] = product(c, -17390);
+    values[8] = product(c, -543);
+    return dovi_Adjust64M33ScaleTo16M33(values, 28, matrix);
+}
+
+unsigned int dovi_GetIctcpIo2LmsM33Narrow(unsigned int depth, void *matrix)
+{
+    unsigned int y, c;
+    unsigned long long values[9];
+    depth = fixed_sign16(depth);
+    if ((depth >> 31) || depth < 9)
+        depth = 8;
+    y = ratio(depth, 219, 1);
+    c = ratio(depth, 224, 1);
+    values[0] = product(y, 32767);
+    values[1] = product(c, 282);
+    values[2] = product(c, 3638);
+    values[3] = values[0];
+    values[4] = product(c, -282);
+    values[5] = product(c, -3638);
+    values[6] = values[0];
+    values[7] = product(c, 18351);
+    values[8] = product(c, -10506);
+    return dovi_Adjust64M33ScaleTo16M33(values, 31, matrix);
+}
diff --git a/tools/dvbridge/dv_stb26/color_narrow.h b/tools/dvbridge/dv_stb26/color_narrow.h
new file mode 100644
index 0000000..6cef877
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/color_narrow.h
@@ -0,0 +1,18 @@
+#ifndef DOVI_COLOR_NARROW_H
+#define DOVI_COLOR_NARROW_H
+
+/* Matrix and vector buffers use unaligned little-endian storage.
+ * Scalar parameter and result widths retain the native integer contracts. */
+/* Narrow matrix functions write nine little-endian signed 16-bit values.
+ * Masked shifts and signed divide retain the native behavior at unusual bit depths. */
+
+void dovi_GetYuvRgbOffFxp(unsigned int range, unsigned int bits, void *output);
+unsigned int dovi_GetLms2IptM33NarrowFxp(unsigned int bits, void *output);
+unsigned int dovi_GetIpt2LmsM33NarrowFxp(unsigned int bits, void *output);
+/* Writes nine little-endian int64s. If kg is zero, entries four and five retain their bytes. */
+void dovi_GetYuv2RgbFromKrKgKbM33(unsigned int kr, unsigned int kg, unsigned int kb, void *output);
+
+unsigned int dovi_GetLms2IctcpIoM33Narrow(unsigned int depth, void *matrix);
+unsigned int dovi_GetIctcpIo2LmsM33Narrow(unsigned int depth, void *matrix);
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/color_primaries.c b/tools/dvbridge/dv_stb26/color_primaries.c
new file mode 100644
index 0000000..a81dc7d
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/color_primaries.c
@@ -0,0 +1,256 @@
+/* Fixed-point color primaries. */
+#include "fixed_access.h"
+#include "color_primaries.h"
+#include "matrix_arithmetic.h"
+#include "fixed_arithmetic.h"
+typedef unsigned int u32;
+typedef unsigned long long u64;
+#include "color_primaries_tables.h"
+
+static unsigned long long mul32(unsigned int a, unsigned int b)
+{
+    return fixed_sign32(a) * fixed_sign32(b);
+}
+
+static unsigned long long sdiv64(unsigned long long a, unsigned long long b)
+{
+    return fixed_raw_divide64(a, b);
+}
+
+static unsigned int sdiv32(unsigned int a, unsigned int b)
+{
+    return (unsigned int)sdiv64(fixed_sign32(a), fixed_sign32(b));
+}
+
+static unsigned long long udiv64(unsigned long long a, unsigned long long b)
+{
+    return b == 0 ? 0 : a / b;
+}
+
+unsigned int dovi_GetRgb2YuvM33Fxp(unsigned int definition, void *output)
+{
+    unsigned long long temporary[9];
+    if (definition < 6u) {
+        unsigned int kr = primary_kr[definition], kg = primary_kg[definition],
+                     kb = primary_kb[definition];
+        unsigned long long db = (unsigned int)(0x4000000u - kb), dr = 0x4000000ull - kr;
+        unsigned long long green = (unsigned long long)(kg & 0xfffffffeu) << 25;
+        temporary[0] = kr;
+        temporary[1] = kg;
+        temporary[2] = fixed_sign32(kb);
+        temporary[3] = 0ull - udiv64((unsigned long long)(kr & 0xfffffffeu) << 25, db);
+        temporary[4] = 0ull - udiv64(green, db);
+        temporary[7] = 0ull - udiv64(green, dr);
+        temporary[8] = 0ull - sdiv64(fixed_sign32(fixed_asr32(kb, 1)) << 26, dr);
+    } else {
+        temporary[0] = 0x1322d0eu;
+        temporary[1] = 0x2591687u;
+        temporary[2] = 0x74bc6au;
+        temporary[3] = 0ull - 0xacc919u;
+        temporary[4] = 0ull - 0x15336e5u;
+        temporary[7] = 0ull - 0x1acbc6fu;
+        temporary[8] = 0ull - 0x53438fu;
+    }
+    temporary[5] = 0x2000000;
+    temporary[6] = 0x2000000;
+    return dovi_Adjust64M33ScaleTo16M33(temporary, 26u, output);
+}
+
+unsigned int dovi_GetRgb2YuvM33NarrowFxp(unsigned int definition, unsigned int raw_bits,
+                                         void *output)
+{
+    unsigned int bits = raw_bits;
+    unsigned char full[18];
+    unsigned long long temporary[9];
+    unsigned int scale, luma, chroma, i, mask;
+    scale = dovi_GetRgb2YuvM33Fxp(definition, full);
+    if (!fixed_less32(8u, bits))
+        bits = 8;
+    mask = ~(0xffffffffu << (bits & 31u));
+    luma = sdiv32(0xdb0000u << ((bits - 8u) & 31u), mask);
+    chroma = sdiv32(0xe00000u << ((bits - 8u) & 31u), mask);
+    for (i = 0; i < 9u; ++i)
+        temporary[i] = mul32(fixed_sign16(fixed_load_le16(full + i * 2u)), i < 3u ? luma : chroma);
+    return dovi_Adjust64M33ScaleTo16M33(temporary, scale + 16u, output);
+}
+
+unsigned int dovi_GetYuv2RgbM33Fxp(unsigned int definition, void *output)
+{
+    unsigned long long temporary[9];
+    temporary[0] = temporary[3] = temporary[6] = 0x4000000u;
+    temporary[1] = temporary[8] = 0;
+    if (definition < 6u) {
+        unsigned int kr = primary_kr[definition], kb = primary_kb[definition];
+        unsigned long long kg = primary_kg_wide[definition], r = 0x4000000ull - kr;
+        temporary[2] = r * 2u;
+        temporary[4] = sdiv64(0ull - (fixed_sign32(kb) * (unsigned int)(0x4000000u - kb) * 2u), kg);
+        temporary[5] = 0ull - udiv64((unsigned long long)kr * (unsigned int)r * 2u, kg);
+        temporary[7] = fixed_sign32(0x8000000u - kb * 2u);
+    } else {
+        temporary[2] = 0x59ba5e4u;
+        temporary[4] = 0ull - 0x1606542u;
+        temporary[5] = 0ull - 0x2db468au;
+        temporary[7] = 0x716872cu;
+    }
+    return dovi_Adjust64M33ScaleTo16M33(temporary, 26u, output);
+}
+
+unsigned int dovi_GetYuv2RgbM33NarrowFxp(unsigned int definition, unsigned int raw_bits,
+                                         void *output)
+{
+    unsigned int bits = raw_bits;
+    unsigned char full[18];
+    unsigned long long temporary[9];
+    unsigned int scale, luma, chroma, i, numerator;
+    scale = dovi_GetYuv2RgbM33Fxp(definition, full);
+    bits = fixed_sign16(bits);
+    if (!fixed_less32(8u, bits))
+        bits = 8;
+    numerator = ~(0xffffffffu << (bits & 31u)) << 16;
+    luma = sdiv32(numerator, 0xdbu << ((bits - 8u) & 31u));
+    chroma = sdiv32(numerator, 0xe0u << ((bits - 8u) & 31u));
+    for (i = 0; i < 9u; ++i)
+        temporary[i] =
+            mul32(fixed_sign16(fixed_load_le16(full + i * 2u)), i % 3u == 0 ? luma : chroma);
+    return dovi_Adjust64M33ScaleTo16M33(temporary, scale + 16u, output);
+}
+
+void dovi_SortDescend(void *values, void *indices, unsigned int last_index)
+{
+    unsigned char *v = values, *p = (unsigned char *)indices;
+    unsigned int remaining = last_index;
+    if (remaining == 0 || (remaining >> 31) != 0)
+        return;
+    do {
+        unsigned int i, changed = 0;
+        for (i = 0; i < remaining; ++i) {
+            unsigned char *a = v + (unsigned long long)i * 4u, *b = p + (unsigned long long)i * 4u;
+            unsigned int left = fixed_load_le32(a), right = fixed_load_le32(a + 4);
+            if (fixed_less32(left, right)) {
+                fixed_store_le32(a + 4, left);
+                fixed_store_le32(a, right);
+                left = fixed_load_le32(b);
+                right = fixed_load_le32(b + 4);
+                fixed_store_le32(b, right);
+                fixed_store_le32(b + 4, left);
+                changed = 1;
+            }
+        }
+        if (remaining < 2u || changed == 0)
+            break;
+        --remaining;
+    } while (1);
+}
+
+unsigned long long dovi_Xy2Cct(const void *xy32, void *cct64)
+{
+    const unsigned char *xy = xy32;
+    unsigned int x = fixed_load_le32(xy), y = fixed_load_le32(xy + 4), z = 0x4000000u - x - y;
+    unsigned int denominator =
+        (unsigned int)((mul32(x, 0x02c9dc21u) + mul32(y, 0x1df77c9cu) + mul32(z, 0x0e1ffd2fu)) >>
+                       26);
+    unsigned int ratio = (unsigned int)dovi_sdiv(
+        mul32(x, 0x05bf9fcdu) + mul32(y, 0x0b2963fbu) + mul32(z, 0xff6cfcf0u), denominator);
+    unsigned int reference, difference, divisor;
+    unsigned long long result, cct;
+    (void)dovi_sdiv(mul32(x, 0xfced3ca3u) + mul32(y, 0x119b8d8eu) + mul32(z, 0x0134bc46u),
+                    denominator);
+    reference = (unsigned int)dovi_sdiv(0x00150dfaeb631000ull, 0x0fcab7c4u);
+    (void)dovi_sdiv(0x00150e10c9f07000ull, 0x0fcab7c4u);
+    difference = ratio - reference;
+    divisor = (unsigned int)(mul32(difference + 0x01555555u, 0x275b09c1u) >> 26) - 0x088fe2c1u;
+    if (!fixed_less32(0x4000u, divisor))
+        divisor = 0x4000u;
+    result = dovi_sdiv(fixed_sign32(0x048e75d5u - difference) << 26, divisor);
+    cct = mul32((unsigned int)result, 0x1968u);
+    if (!fixed_less32((unsigned int)result, 0x07b0050au))
+        cct = 0x000000c350000000ull;
+    if (!fixed_less32(0x01899a9bu, (unsigned int)result))
+        cct = 0x0000002710000000ull;
+    fixed_store_le64(cct64, cct);
+    return result;
+}
+
+void dovi_XyY2Xyz(unsigned int x, unsigned int y, unsigned int luminance, void *xyz64)
+{
+    unsigned char *out = xyz64;
+    unsigned long long xx, zz;
+    fixed_store_le64(out + 8, luminance);
+    xx = sdiv64((unsigned long long)luminance * fixed_sign32(x), fixed_sign32(y));
+    zz = sdiv64((unsigned long long)luminance * fixed_sign32(0x8000u - x - y), fixed_sign32(y));
+    fixed_store_le64(out, xx);
+    fixed_store_le64(out + 16, zz);
+}
+
+#if defined(_MSC_VER)
+void __debugbreak(void);
+#pragma intrinsic(__debugbreak)
+
+__declspec(noreturn) static void primary_bounds_trap(void)
+{
+    __debugbreak();
+    __assume(0);
+}
+#else
+__attribute__((noreturn)) static void primary_bounds_trap(void)
+{
+#if defined(__aarch64__)
+    __builtin_trap();
+    __builtin_unreachable();
+#else
+    __builtin_trap();
+#endif
+}
+#endif
+
+unsigned int dovi_GetPrimaries(unsigned int id, void *primaries32)
+{
+    unsigned char *out = primaries32;
+    unsigned int offset = id * 32u, i;
+    if (id > 18u)
+        return 0xffffffffu;
+    for (i = 0; i < 32u; ++i) {
+        if (i != 0 && offset + i >= 641u)
+            primary_bounds_trap();
+        out[i] =
+            (unsigned char)(primary_primaries[(offset + i) / 4u] >> (((offset + i) & 3u) * 8u));
+    }
+    return 26u;
+}
+
+void dovi_GetRgb2XyzM33ByPrims(unsigned int rx, unsigned int ry, unsigned int gx, unsigned int gy,
+                               unsigned int bx, unsigned int by, unsigned int wx, unsigned int wy,
+                               void *matrix32)
+{
+    unsigned int a = rx - bx, b = gy - by, c = ry - by, d = gx - bx;
+    unsigned long long determinant = mul32(b, a) - mul32(c, d), r = 0, g = 0, rs, gs, bs;
+    unsigned long long denominator = fixed_sign32((unsigned int)(determinant >> 26));
+    unsigned int values[9], i;
+    if ((determinant & 0x03fffffffc000000ull) != 0) {
+        r = sdiv64(mul32(b, wx - bx) - mul32(d, wy - by), denominator);
+        g = sdiv64(mul32(a, wy - by) - mul32(c, wx - bx), denominator);
+    }
+    rs = sdiv64(r << 26, fixed_sign32(wy));
+    gs = sdiv64(g << 26, fixed_sign32(wy));
+    bs = sdiv64(0x0010000000000000ull - ((r + g) << 26), fixed_sign32(wy));
+    values[0] = (unsigned int)((rs * fixed_sign32(rx)) >> 26);
+    values[1] = (unsigned int)((gs * fixed_sign32(gx)) >> 26);
+    values[2] = (unsigned int)((bs * fixed_sign32(bx)) >> 26);
+    values[3] = (unsigned int)((rs * fixed_sign32(ry)) >> 26);
+    values[4] = (unsigned int)((gs * fixed_sign32(gy)) >> 26);
+    values[5] = (unsigned int)((bs * fixed_sign32(by)) >> 26);
+    values[6] = (unsigned int)((rs * fixed_sign32(0x4000000u - rx - ry)) >> 26);
+    values[7] = (unsigned int)((gs * fixed_sign32(0x4000000u - gx - gy)) >> 26);
+    values[8] = (unsigned int)((bs * fixed_sign32(0x4000000u - bx - by)) >> 26);
+    for (i = 0; i < 9u; ++i)
+        fixed_store_le32((unsigned char *)matrix32 + i * 4u, values[i]);
+}
+
+void dovi_GetRgb2XyzM33ByV8Prims(const void *primaries32, void *matrix32)
+{
+    const unsigned char *p = primaries32;
+    unsigned int v[8], i;
+    for (i = 0; i < 8u; ++i)
+        v[i] = fixed_load_le32(p + i * 4u);
+    dovi_GetRgb2XyzM33ByPrims(v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], matrix32);
+}
diff --git a/tools/dvbridge/dv_stb26/color_primaries.h b/tools/dvbridge/dv_stb26/color_primaries.h
