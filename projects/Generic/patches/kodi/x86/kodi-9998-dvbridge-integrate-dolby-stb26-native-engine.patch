+static inline unsigned int dm_frame_sample_bytes(unsigned int data_type)
+{
+    if (data_type == DM_FRAME_SAMPLE_U8)
+        return 1;
+    return data_type == DM_FRAME_SAMPLE_F32 ? 4 : 2;
