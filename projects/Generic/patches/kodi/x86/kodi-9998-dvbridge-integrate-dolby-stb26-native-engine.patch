diff --git a/tools/dvbridge/dv_stb26/resampling_filters.c b/tools/dvbridge/dv_stb26/resampling_filters.c
new file mode 100644
index 0000000..09e303e
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/resampling_filters.c
@@ -0,0 +1,96 @@
+/* Read spatial resampling filters and their prediction parameters. */
+#include "fixed_access.h"
+#include "resampling_filters.h"
+#include "parser_access.h"
+#include "bitstream.h"
+
+typedef int (*log_fn)(const char *format, ...);
+typedef char require_uint32[(sizeof(unsigned int) == 4) ? 1 : -1];
+typedef char require_int32[(sizeof(int) == 4) ? 1 : -1];
+typedef char require_offset64[(sizeof(long long) == 8) ? 1 : -1];
+typedef char require_pointer64[(sizeof(void *) == 8 && sizeof(log_fn) == 8) ? 1 : -1];
+
+static log_fn read_log(const unsigned char *source)
+{
+    log_fn value;
+    parser_copy8(&value, source);
+    return value;
+}
+
+int dovi_rpu_data_chroma_resampling_filter_1D_exp_read(void *decoder, int partition,
+                                                       unsigned int raw_component,
+                                                       unsigned int raw_direction)
+{
+    unsigned int component = raw_component;
+    unsigned int direction = raw_direction;
+    unsigned char *decoder_bytes = decoder;
+    unsigned char *root = parser_load_pointer(decoder_bytes);
+    unsigned char *payload = parser_load_pointer(root + 8);
+    unsigned char *rpu_context = parser_load_pointer(decoder_bytes + 8);
+    unsigned char *counter =
+        rpu_context + (unsigned long long)component * 8 + (unsigned long long)direction * 4 + 0x2d8;
+    long long partition_offset = (long long)partition * 0x7038;
+    unsigned long long filter_offset =
+        (unsigned long long)component * 0x50 + (unsigned long long)direction * 0x28;
+    unsigned long long index_offset =
+        (unsigned long long)component * 8 + (unsigned long long)direction * 4 + 0x6f54;
+    unsigned char *flag = payload + partition_offset + filter_offset + 0x649c;
+    struct dovi_bitstream *bits = (struct dovi_bitstream *)(decoder_bytes + 0x40);
+    log_fn log = (log_fn)0;
+    unsigned int log_level = 0, predicted = 0;
+
+    if (fixed_signed32(fixed_load_le32(counter)) <= 0) {
+        *flag = 0;
+    } else {
+        unsigned int prediction = dovi_read_u_1(bits);
+        log = read_log(decoder_bytes + 0x315c8);
+        log_level = fixed_load_le32(decoder_bytes + 0x315d0);
+        *flag = (unsigned char)prediction;
+        if (prediction != 0) {
+            if (fixed_signed32(fixed_load_le32(counter)) >= 2) {
+                unsigned int delta = (dovi_read_ue_v(bits) + 1u) & 255u;
+                unsigned char saved_flag = *flag;
+                predicted = (unsigned int)partition - delta;
+                payload[partition_offset + filter_offset + 0x64c0] = (unsigned char)delta;
+                if (saved_flag != 1)
+                    goto copy_prediction;
+            }
+            if (fixed_signed32(predicted) < 0 || fixed_signed32(predicted) >= partition) {
+                if (log != (log_fn)0 && log_level >= 3u) {
+                    log("ERROR: Partition %d, cmp %d, dir %d:  pred_part_idx_resampling1D shall be in the range [0 .. %d] but is %d\n",
+                        partition, component, direction,
+                        fixed_signed32((unsigned int)partition - 1u), fixed_signed32(predicted));
+                }
+                return -2;
+            }
+        copy_prediction:
+            fixed_store_le32(payload + partition_offset + index_offset,
+                             fixed_load_le32(parser_load_pointer(root + 8) +
+                                             (long long)fixed_signed32(predicted) * 0x7038 +
+                                             index_offset));
+            return 0;
+        }
+    }
+
+    {
+        /* Reload rpu_data/header after reading the prediction. */
+        unsigned char *current_root = parser_load_pointer(decoder_bytes);
+        unsigned char *header = parser_load_pointer(current_root);
+        unsigned int coefficient_count = header[direction == 0 ? 0x20 : 0x1f];
+        if (coefficient_count != 0) {
+            unsigned char *coefficients =
+                parser_load_pointer(current_root + 8) + partition_offset + filter_offset + 0x64a0;
+            do {
+                unsigned int width = header[0x0c];
+                unsigned int value = dovi_read_u_v(width + 1u, bits);
+                value |= 0u - ((1u << (width & 31u)) & value);
+                fixed_store_le32(coefficients, value);
+                coefficients += 4;
+            } while (--coefficient_count != 0);
+        }
+    }
+    fixed_store_le32(payload + partition_offset + index_offset,
+                     direction * 0x28u + component * 0x50u + 0x64a0u);
+    fixed_store_le32(counter, fixed_load_le32(counter) + 1u);
+    return 0;
+}
diff --git a/tools/dvbridge/dv_stb26/resampling_filters.h b/tools/dvbridge/dv_stb26/resampling_filters.h
new file mode 100644
index 0000000..8ec9d7d
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/resampling_filters.h
@@ -0,0 +1,16 @@
+#ifndef DOVI_RESAMPLING_FILTERS_H
+#define DOVI_RESAMPLING_FILTERS_H
+
+/*
+ * The little-endian decoder embeds a bitstream at +0x40. Decoder+0 points to
+ * {header, payload}; decoder+8 points to mutable configuration. Payload
+ * partitions have stride 0x7038. Supply accessible, disjoint objects and
+ * padded bitstream input. Coefficient counts and indices are unchecked.
+ * Chroma decoding returns 0 or -2 for an invalid predicted partition.
+ * Diagnostics use the callback at +0x315c8 and unsigned level at +0x315d0.
+ */
+int dovi_rpu_data_chroma_resampling_filter_1D_exp_read(void *decoder, int partition,
+                                                       unsigned int raw_component,
+                                                       unsigned int raw_direction);
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/rpu_buffering.c b/tools/dvbridge/dv_stb26/rpu_buffering.c
new file mode 100644
index 0000000..d146b01
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/rpu_buffering.c
@@ -0,0 +1,172 @@
+/* Accumulate RPU bytes into decoder slots and report buffer state. */
+#include "rpu_buffering.h"
+#include "fixed_access.h"
+#include "parser_access.h"
+#include "parser_layout.h"
+#include "parser_api.h"
+
+typedef char require_uint32[(sizeof(unsigned int) == 4 && sizeof(int) == 4) ? 1 : -1];
+typedef char require_pointer64[(sizeof(void *) == 8 && sizeof(rpu_msg_log_func_t) == 8) ? 1 : -1];
+
+static rpu_msg_log_func_t read_log(const unsigned char *p)
+{
+    rpu_msg_log_func_t value;
+    parser_copy8(&value, p);
+    return value;
+}
+
+void dovi_dump_rpu_buffer_info(void *decoder)
+{
+    unsigned char *decoder_bytes = decoder;
+    if (read_log(decoder_bytes + DECODER_LOGGER) != 0) {
+        unsigned long long i;
+        unsigned int j;
+        read_log(decoder_bytes + DECODER_LOGGER)("RPU buffer:\n");
+        read_log(decoder_bytes + DECODER_LOGGER)("Level   ");
+        for (i = 0; i < fixed_load_le32(decoder_bytes + DECODER_SLOT_COUNT); ++i)
+            read_log(decoder_bytes + DECODER_LOGGER)(
+                " %4d", fixed_signed32(
+                            fixed_load_le32(parser_load_pointer(decoder_bytes + DECODER_SLOT_LENGTHS) + i * 4u)));
+        read_log(decoder_bytes + DECODER_LOGGER)("\n");
+        read_log(decoder_bytes + DECODER_LOGGER)("Buffer  ");
+        for (j = 0; j < fixed_load_le32(decoder_bytes + DECODER_SLOT_COUNT); ++j)
+            read_log(decoder_bytes + DECODER_LOGGER)(" %4d", fixed_signed32(j));
+        read_log(decoder_bytes + DECODER_LOGGER)("\n");
+    }
+}
+
+static unsigned int current_length(const unsigned char *decoder_bytes)
+{
+    return fixed_load_le32(parser_load_pointer(decoder_bytes + DECODER_SLOT_LENGTHS) +
+                           (unsigned long long)fixed_load_le32(decoder_bytes + DECODER_INPUT_SLOT) * 4u);
+}
+
+static void append_byte(unsigned char *decoder_bytes, unsigned char value)
+{
+    unsigned int slot = fixed_load_le32(decoder_bytes + DECODER_INPUT_SLOT);
+    unsigned char *length =
+        parser_load_pointer(decoder_bytes + DECODER_SLOT_LENGTHS) + (unsigned long long)slot * 4u;
+    unsigned char *buffer = parser_load_pointer(decoder_bytes + DECODER_INPUT_STORAGE);
+    unsigned int previous = fixed_load_le32(length);
+    fixed_store_le32(length, previous + 1u);
+#if PARSER_FATAL_ARRAY_LIMITS
+    if (previous > 0xfffu)
+        parser_limit_trap();
+    buffer[(unsigned long long)slot * 0x1000u + previous] = value;
+#else
+    (buffer + (unsigned long long)slot * 0x1000u)[fixed_signed32(previous)] = value;
+#endif
+}
+
+int dovi_rpu_decoder_push_data(void *decoder, const unsigned char *data, int length,
+                               int flush)
+{
+    unsigned char *decoder_bytes = decoder;
+    unsigned int remaining;
+    if (decoder_bytes == 0 || length < 0 || (data == 0 && length != 0))
+        return -7;
+    if (flush != 0)
+        fixed_store_le32(decoder_bytes + DECODER_FLUSH, 1);
+    if (length != 0) {
+        if (fixed_load_le32(decoder_bytes + DECODER_DIRECT_MODE) != 0) {
+            unsigned int count = (unsigned int)length;
+            while (data[(long long)fixed_signed32(count - 1u)] == 0)
+                --count;
+            parser_copy_bytes(parser_load_pointer(decoder_bytes + DECODER_INPUT_STORAGE) +
+                                  (unsigned long long)fixed_load_le32(decoder_bytes + DECODER_INPUT_SLOT) *
+                                      0x1000u,
+                              data, (unsigned long long)(long long)fixed_signed32(count));
+            fixed_store_le32(parser_load_pointer(decoder_bytes + DECODER_SLOT_LENGTHS) +
+                                 (unsigned long long)fixed_load_le32(decoder_bytes + DECODER_INPUT_SLOT) * 4u,
+                             count);
+        } else {
+            for (remaining = (unsigned int)length; remaining != 0; --remaining, ++data) {
+                unsigned int state = fixed_load_le32(decoder_bytes + DECODER_FRAMING_STATE);
+                unsigned char value = (!PARSER_FATAL_ARRAY_LIMITS || state <= (unsigned int)RBSP_FOUND_0000) ? *data : 0;
+                switch (state) {
+                case RBSP_SEARCH_RPU:
+                    if (value == 0)
+                        fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE, RBSP_FOUND_START_00);
+                    break;
+                case RBSP_FOUND_START_00:
+                    fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE,
+                                     value == 0 ? (unsigned int)RBSP_FOUND_START_0000
+                                                : (unsigned int)RBSP_SEARCH_RPU);
+                    break;
+                case RBSP_FOUND_START_0000:
+                    fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE,
+                                     value == 0   ? (unsigned int)RBSP_FOUND_START_0000
+                                     : value == 1 ? (unsigned int)RBSP_FOUND_START_000001
+                                                  : (unsigned int)RBSP_SEARCH_RPU);
+                    break;
+                case RBSP_FOUND_START_000001:
+                    if (value != 0x19) {
+                        fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE, RBSP_SEARCH_RPU);
+                    } else {
+                        unsigned int slot = (fixed_load_le32(decoder_bytes + DECODER_SLOT_COUNT) - 1u) &
+                                            (fixed_load_le32(decoder_bytes + DECODER_INPUT_SLOT) + 1u);
+                        fixed_store_le32(decoder_bytes + DECODER_INPUT_SLOT, slot);
+                        if (fixed_load_le32(parser_load_pointer(decoder_bytes + DECODER_SLOT_LENGTHS) +
+                                            (unsigned long long)slot * 4u) != 0) {
+                            dovi_dump_rpu_buffer_info(decoder_bytes);
+                            return -22;
+                        }
+                        fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE, RBSP_FOUND_RPU);
+                    }
+                    break;
+                case RBSP_FOUND_RPU:
+                    if (value == 0)
+                        fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE, RBSP_FOUND_00);
+                    else
+                        append_byte(decoder_bytes, value);
+                    break;
+                case RBSP_FOUND_00:
+                    if (value == 0) {
+                        fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE, RBSP_FOUND_0000);
+                    } else {
+                        fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE, RBSP_FOUND_RPU);
+                        append_byte(decoder_bytes, 0);
+                        append_byte(decoder_bytes, value);
+                    }
+                    break;
+                case RBSP_FOUND_0000:
+                    if (value == 0) {
+                        fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE, RBSP_FOUND_START_0000);
+                    } else if (value == 1) {
+                        fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE, RBSP_FOUND_START_000001);
+                    } else if (value == 2) {
+                        return -1;
+                    } else if (value == 3) {
+                        append_byte(decoder_bytes, 0);
+                        append_byte(decoder_bytes, 0);
+                        fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE, RBSP_FOUND_RPU);
+                    } else {
+                        fixed_store_le32(decoder_bytes + DECODER_FRAMING_STATE, RBSP_FOUND_RPU);
+                        append_byte(decoder_bytes, 0);
+                        append_byte(decoder_bytes, 0);
+                        append_byte(decoder_bytes, value);
+                    }
+                    break;
+                default:
+                    break;
+                }
+                if (fixed_signed32(current_length(decoder_bytes)) > 0x1000) {
+                    dovi_dump_rpu_buffer_info(decoder_bytes);
+                    return -22;
+                }
+            }
+        }
+    }
+    if (fixed_load_le32(decoder_bytes + DECODER_SEVERITY) > 6u)
+        dovi_dump_rpu_buffer_info(decoder_bytes);
+    return 0;
+}
+
+int dovi_rpu_decoder_last_rpu_output(const void *decoder)
+{
+    const unsigned char *decoder_bytes = decoder;
+    if (fixed_load_le32(parser_load_pointer(decoder_bytes + DECODER_SLOT_LENGTHS) +
+                        (unsigned long long)fixed_load_le32(decoder_bytes + DECODER_OUTPUT_SLOT) * 4u) != 0)
+        return 0;
+    return fixed_load_le32(decoder_bytes + DECODER_FLUSH) != 0;
+}
diff --git a/tools/dvbridge/dv_stb26/rpu_buffering.h b/tools/dvbridge/dv_stb26/rpu_buffering.h
new file mode 100644
index 0000000..7471a13
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/rpu_buffering.h
@@ -0,0 +1,37 @@
+#ifndef DOVI_RPU_BUFFERING_H
+#define DOVI_RPU_BUFFERING_H
+
+#include "decoder_lifecycle.h"
+
+enum rbsp_ingress_state {
+    RBSP_SEARCH_RPU = 0,
+    RBSP_FOUND_START_00 = 1,
+    RBSP_FOUND_START_0000 = 2,
+    RBSP_FOUND_START_000001 = 3,
+    RBSP_FOUND_RPU = 4,
+    RBSP_FOUND_00 = 5,
+    RBSP_FOUND_0000 = 6
+};
+
+/*
+ * Original decoder layout: byte storage pointer +0x10, uint32 length array
+ * pointer +0x18, write/read indices +0x20/+0x24, flush word +0x28, direct
+ * mode word +0x30, slot count +0x38, log callback/level +0x315c8/+0x315d0,
+ * and framing state word +0x315d4. Slots have 0x1000-byte address spacing.
+ * Valid indices, sufficient disjoint storage and serialized calls required.
+ *
+ * push returns 0, -7 for invalid arguments, -22 for a full queue, or -1 for
+ * the 00 00 02 sequence inside framed payload. Buffered writes increment
+ * the slot length before trapping if the previous length exceeded 0xfff
+ * in STB 2.6. STB 2.4 writes first, then returns -22 if the resulting
+ * signed slot length exceeds 0x1000.
+ * Direct mode has no 0x1000-byte capacity check and scans trailing zeros
+ * backwards without a start bound; caller-provided readable prefix/storage
+ * must cover every accessed byte.
+ */
+int dovi_rpu_decoder_push_data(void *decoder, const unsigned char *data, int length,
+                               int flush);
+void dovi_dump_rpu_buffer_info(void *decoder);
+int dovi_rpu_decoder_last_rpu_output(const void *decoder);
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/rpu_header.c b/tools/dvbridge/dv_stb26/rpu_header.c
