diff --git a/tools/dvbridge/dv_stb26/dm_trim_chroma.c b/tools/dvbridge/dv_stb26/dm_trim_chroma.c
new file mode 100644
index 0000000..e361aa9
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_trim_chroma.c
@@ -0,0 +1,308 @@
+/* Chroma coordinates and distances for trim interpolation. */
+#include "dm_bindings.h"
+#include "dm_layout.h"
+#include "dm_map_workspace.h"
+
+/* The distance uses the red-primary column of the Q26 RGB-to-XYZ
+ * matrix, then sums saturated absolute I, Ct and Cp differences. The
+ * luminance argument contributes only its low 32 bits. */
+unsigned int dovi_dm_FindChromaDist(const void *primaries, unsigned int luminance, int target_pq)
+{
+    _Alignas(16) int rgb_to_xyz[9] = {0};
+    _Alignas(16) int ictcp[3] = {0};
+    _Alignas(16) long xyz[3];
+    unsigned long luminance32;
+
+    if (primaries == (void *)0)
+        return 0;
+
+    luminance32 = luminance & 0xffffffff;
+    dovi_GetRgb2XyzM33ByV8Prims(primaries, rgb_to_xyz);
+    xyz[0] = (long)((long)rgb_to_xyz[0] * luminance32) >> 26;
+    xyz[1] = (long)((long)rgb_to_xyz[3] * luminance32) >> 26;
+    xyz[2] = (long)((long)rgb_to_xyz[6] * luminance32) >> 26;
+    dovi_Xyz2IctcpDm(xyz, ictcp);
+
+    return fixed_abs32((unsigned int)target_pq - (unsigned int)ictcp[0]) +
+           fixed_abs32((unsigned int)ictcp[1]) + fixed_abs32((unsigned int)ictcp[2]);
+}
+
+void dovi_dm_BuildChromaXInfo(int coordinate_scale, unsigned long unused_state, long config,
+                              unsigned int flags, int exclude_default, long metadata, long signal,
+                              int *trim_header, long coordinates, long indices,
+                              unsigned int *last_index, unsigned int *target_coordinate)
+{
+    _Alignas(16) struct dm_chroma_coordinates_workspace scratch;
+    int coordinate_work;
+    const unsigned char *display_primaries;
+    unsigned char display_id;
+    unsigned int coordinate_word;
+    unsigned int coordinate_auxiliary;
+    long lookup_cursor;
+    const unsigned long *source_primaries;
+    unsigned long distance_work;
+    int absolute_ct;
+    int component_work;
+    const unsigned char *trim_values;
+    long trim_cursor;
+
+    scratch.level10 = 0;
+
+    scratch.rounded.values[16] = 0;
+    scratch.rounded.pairs[6] = 0;
+    scratch.rounded.pairs[7] = 0;
+    scratch.rounded.pairs[4] = 0;
+    scratch.rounded.pairs[5] = 0;
+    scratch.rounded.pairs[2] = 0;
+    scratch.rounded.pairs[3] = 0;
+    scratch.rounded.pairs[0] = 0;
+    scratch.rounded.pairs[1] = 0;
+    scratch.upper.values[16] = 0;
+    scratch.upper.pairs[6] = 0;
+    scratch.upper.pairs[7] = 0;
+    scratch.upper.pairs[4] = 0;
+    scratch.upper.pairs[5] = 0;
+    scratch.upper.pairs[3] = 0;
+    scratch.upper.pairs[1] = 0;
+    scratch.upper.pairs[2] = 0;
+    scratch.upper.pairs[0] = 0;
+    if (((flags >> 10 & 1) != 0) && (metadata != 0)) {
+        scratch.level10 = 0;
+        if ((*(unsigned char *)(metadata + 1) & 4) != 0) {
+            scratch.level10 = metadata + 0x218;
+        }
+    }
+    if (trim_header[2] == 0) {
+        _printk(dovi_dm_assertion_format,
+                "../dolby_vision/dv_source_code/libs/dm/dlb_dm_process/src/CdmCmmtFxp.c",
+                "BuildChromaXInfo", 0x98c, "pTrimHdr->TrimNum");
+        dump_stack();
+    }
+    *last_index = 0;
+    *target_coordinate = 0;
+    if (0 < trim_header[2]) {
+        trim_cursor = 0;
+        do {
+            if (*trim_header == 8) {
+                display_id = *(unsigned char *)(metadata + trim_cursor * 0x2a + 0x11c);
+                lookup_cursor = (long)dovi_GetDisplay((unsigned int)(display_id));
+                if ((int *)(metadata + 0x110) != trim_header) {
+                    _printk(
+                        dovi_dm_assertion_format,
+                        "../dolby_vision/dv_source_code/libs/dm/dlb_dm_process/src/CdmCmmtFxp.c",
+                        "BuildChromaXInfo", 0x997, "pTrimHdr == (TrimComHdr_t *)&hMdsExt->trim8");
+                    dump_stack();
+                }
+                if (lookup_cursor == 0) {
+                    if ((scratch.level10 != 0) &&
+                        (distance_work =
+                             (unsigned long)fixed_load_le32((const void *)(scratch.level10 + 8)),
+                         trim_values = (const unsigned char *)(scratch.level10 + 0x12),
+                         0 < (int)fixed_load_le32((const void *)(scratch.level10 + 8)))) {
+                        do {
+                            if (((unsigned short)fixed_load_le16(trim_values - 6)) ==
+                                (unsigned short)display_id) {
+                                if (0x3f6 < ((unsigned short)fixed_load_le16(trim_values - 4))) {
+                                    coordinate_word = (unsigned int)((unsigned short)fixed_load_le16(
+                                                trim_values - 4))
+                                            << 6;
+                                    scratch.color.packed.pairs[2] = 0;
+                                    scratch.color.packed.pairs[3] = 0;
+                                    scratch.color.packed.pairs[0] = 0;
+                                    scratch.color.packed.pairs[1] = 0;
+                                    distance_work = dovi_Pq2L((unsigned int)(coordinate_word));
+                                    if ((unsigned long)((unsigned short)fixed_load_le16(
+                                            trim_values)) < 0x13) {
+                                        source_primaries = (const unsigned long *)dovi_v8_primaries[(
+                                            (unsigned short)fixed_load_le16(trim_values))];
+                                    } else {
+                                        scratch.color.packed.pairs[0] =
+                                            CONCAT44((int)(short)((unsigned short)fixed_load_le16(
+                                                         trim_values + 4))
+                                                         << 0xb,
+                                                     (int)(short)((unsigned short)fixed_load_le16(
+                                                         trim_values + 2))
+                                                         << 0xb);
+                                        scratch.color.packed.pairs[1] =
+                                            CONCAT44((int)(short)((unsigned short)fixed_load_le16(
+                                                         trim_values + 8))
+                                                         << 0xb,
+                                                     (int)(short)((unsigned short)fixed_load_le16(
+                                                         trim_values + 6))
+                                                         << 0xb);
+                                        scratch.color.packed.pairs[2] =
+                                            CONCAT44((int)(short)((unsigned short)fixed_load_le16(
+                                                         trim_values + 12))
+                                                         << 0xb,
+                                                     (int)(short)((unsigned short)fixed_load_le16(
+                                                         trim_values + 10))
+                                                         << 0xb);
+                                        source_primaries = &scratch.color.packed.pairs[0];
+                                        scratch.color.packed.pairs[3] =
+                                            CONCAT44((int)(short)((unsigned short)fixed_load_le16(
+                                                         trim_values + 16))
+                                                         << 0xb,
+                                                     (int)(short)((unsigned short)fixed_load_le16(
+                                                         trim_values + 14))
+                                                         << 0xb);
+                                    }
+                                    coordinate_word = dovi_dm_FindChromaDist(
+                                        source_primaries, (unsigned long)(distance_work >> 6), (int)(coordinate_word));
+                                    goto append_coordinate;
+                                }
+                                break;
+                            }
+                            distance_work = distance_work - 1;
+                            trim_values = trim_values + 0x18;
+                        } while (distance_work != 0);
+                    }
+                } else if (0x3f6 < *(int *)(lookup_cursor + 0xc)) {
+                    display_primaries = (unsigned char *)0x0;
+                    if (*(unsigned int *)(lookup_cursor + 0x10) < 0x13) {
+                        display_primaries = (const unsigned char *)
+                            dovi_v8_primaries[*(unsigned int *)(lookup_cursor + 0x10)];
+                    }
+                    coordinate_word = dovi_dm_FindChromaDist(
+                        display_primaries, (unsigned long)((unsigned long)*(unsigned int *)(lookup_cursor + 8)),
+                        (int)(*(int *)(lookup_cursor + 0xc)));
+                    goto append_coordinate;
+                }
+            } else {
+                trim_values = (const unsigned char *)(metadata + trim_cursor * 0xe + 0x90);
+                coordinate_word = (unsigned int)((unsigned short)fixed_load_le16(trim_values)) * 0x40;
+                distance_work = dovi_Pq2L((unsigned int)(coordinate_word));
+                if ((int *)(metadata + 0x84) != trim_header) {
+                    _printk(
+                        dovi_dm_assertion_format,
+                        "../dolby_vision/dv_source_code/libs/dm/dlb_dm_process/src/CdmCmmtFxp.c",
+                        "BuildChromaXInfo", 0x9b2, "pTrimHdr == (TrimComHdr_t *)&hMdsExt->trim2");
+                    dump_stack();
+                }
+                if (0x3f6 < ((unsigned short)fixed_load_le16(trim_values))) {
+                    scratch.ictcp.components[2] = 0;
+                    scratch.ictcp.pair = 0;
+                    scratch.color.packed.last = 0;
+                    scratch.color.packed.pairs[2] = 0;
+                    scratch.color.packed.pairs[3] = 0;
+                    scratch.color.packed.pairs[0] = 0;
+                    scratch.color.packed.pairs[1] = 0;
+                    dovi_GetRgb2XyzM33ByV8Prims(dovi_v8_primaries[1],
+                                           (void *)(&scratch.color.packed.pairs[0]));
+                    distance_work = distance_work >> 6 & 0xffffffff;
+                    scratch.xyz[0] =
+                        (long)(distance_work * (long)(int)scratch.color.packed.pairs[0]) >> 0x1a;
+                    scratch.xyz[1] =
+                        (long)(distance_work *
+                               (long)(int)(*(
+                                   unsigned int *)((unsigned char *)&scratch.color.packed.pairs[1] +
+                                                   4))) >>
+                        0x1a;
+                    scratch.xyz[2] =
+                        (long)(distance_work * (long)(int)scratch.color.packed.pairs[3]) >> 0x1a;
+                    dovi_Xyz2IctcpDm((const void *)(&scratch.xyz[0]), (void *)(&scratch.ictcp.pair));
+                    component_work = coordinate_word - (int)scratch.ictcp.pair;
+                    absolute_ct = 0x7fffffff;
+                    coordinate_work = absolute_ct;
+                    if (component_work != -0x80000000) {
+                        coordinate_work = -component_work;
+                    }
+                    if (-1 < component_work) {
+                        coordinate_work = component_work;
+                    }
+                    if ((*(unsigned int *)((unsigned char *)&scratch.ictcp.pair + 4)) !=
+                        -0x80000000) {
+                        absolute_ct = -(*(unsigned int *)((unsigned char *)&scratch.ictcp.pair + 4));
+                    }
+                    if (-1 < (int)(*(unsigned int *)((unsigned char *)&scratch.ictcp.pair + 4))) {
+                        absolute_ct = (*(unsigned int *)((unsigned char *)&scratch.ictcp.pair + 4));
+                    }
+                    component_work = 0x7fffffff;
+                    if (scratch.ictcp.components[2] != -0x80000000) {
+                        component_work = -scratch.ictcp.components[2];
+                    }
+                    if (-1 < scratch.ictcp.components[2]) {
+                        component_work = scratch.ictcp.components[2];
+                    }
+                    coordinate_word = coordinate_work + absolute_ct + component_work;
+                append_coordinate:
+                    *(unsigned int *)(coordinates + (long)(int)*last_index * 4) = coordinate_word;
+                    coordinate_auxiliary = *last_index;
+                    coordinate_word = *(int *)(coordinates + (long)(int)coordinate_auxiliary * 4) * coordinate_scale;
+                    coordinate_work = (coordinate_word & 0xffffff00) + 0x100;
+                    coordinate_word = coordinate_word + 0x80 & 0xffffff00;
+                    if (0 < (int)coordinate_auxiliary) {
+                        lookup_cursor = 0;
+                        do {
+                            if (lookup_cursor == 0x44)
+                                goto coordinate_limit;
+                            if ((coordinate_word ==
+                                 *(unsigned int *)((long)&scratch.rounded.pairs[0] + lookup_cursor)) ||
+                                (coordinate_work == *(int *)((long)&scratch.upper.pairs[0] + lookup_cursor)))
+                                goto next_trim;
+                            lookup_cursor = lookup_cursor + 4;
+                        } while ((unsigned long)coordinate_auxiliary * 4 - lookup_cursor != 0);
+                    }
+                    if ((coordinate_auxiliary == 0x11) || (distance_work = (long)(int)coordinate_auxiliary * 4, 0x44 < distance_work))
+                        goto coordinate_limit;
+                    *(int *)((long)&scratch.upper.pairs[0] + distance_work) = coordinate_work;
+                    *(unsigned int *)((long)&scratch.rounded.pairs[0] + distance_work) = coordinate_word;
+                    *(int *)(indices + distance_work) = (int)trim_cursor;
+                    *last_index = *last_index + 1;
+                }
+            }
+        next_trim:
+            trim_cursor = trim_cursor + 1;
+        } while (trim_cursor < trim_header[2]);
+    }
+    if (exclude_default == 0) {
+        coordinate_word = *(unsigned int *)(signal + 0x1c);
+        if (0x9c3fffff < coordinate_word) {
+            coordinate_word = 0x9c400000;
+        }
+        coordinate_word = dovi_dm_FindChromaDist((void *)((void *)(signal + 0x44)),
+                                       (unsigned long)((unsigned long)coordinate_word),
+                                       (int)(*(int *)(signal + 0x14) << 6));
+        *(unsigned int *)(coordinates + (long)(int)*last_index * 4) = coordinate_word;
+        coordinate_word = *last_index;
+        if (0 < (int)coordinate_word) {
+            trim_cursor = 0;
+            coordinate_auxiliary = *(int *)(coordinates + (long)(int)coordinate_word * 4) * coordinate_scale;
+            do {
+                if (trim_cursor == 0x44) {
+                coordinate_limit:
+                    dm_limit_trap();
+                }
+                if (((coordinate_auxiliary + 0x80 & 0xffffff00) ==
+                     *(unsigned int *)((long)&scratch.rounded.pairs[0] + trim_cursor)) ||
+                    ((coordinate_auxiliary & 0xffffff00) + 0x100 ==
+                     *(int *)((long)&scratch.upper.pairs[0] + trim_cursor))) {
+                    *last_index = coordinate_word - 1;
+                    goto select_target_distance;
+                }
+                trim_cursor = trim_cursor + 4;
+            } while ((unsigned long)coordinate_word * 4 - trim_cursor != 0);
+        }
+        *(int *)(indices + (long)(int)coordinate_word * 4) = trim_header[2];
+    select_target_distance:
+        coordinate_word = *(unsigned int *)(signal + 0x88);
+        if (0x9c3fffff < coordinate_word) {
+            coordinate_word = 0x9c400000;
+        }
+        coordinate_word = dovi_dm_FindChromaDist((void *)((void *)(signal + 0xb0)),
+                                       (unsigned long)((unsigned long)coordinate_word),
+                                       (int)(*(int *)(signal + 0x80) << 6));
+    } else {
+        *last_index = *last_index - 1;
+        coordinate_word = *(unsigned int *)(config + 0x164);
+        coordinate_auxiliary = dovi_LToPQ12((unsigned int)(coordinate_word));
+        if (0x9c3fffff < coordinate_word) {
+            coordinate_word = 0x9c400000;
+        }
+        coordinate_word = dovi_dm_FindChromaDist((void *)((void *)(config + 0xa0)),
+                                       (unsigned long)((unsigned long)coordinate_word),
+                                       (int)((coordinate_auxiliary & 0xffff) << 6));
+    }
+    *target_coordinate = coordinate_word;
+
+    return;
+}
diff --git a/tools/dvbridge/dv_stb26/dm_trim_interpolation.c b/tools/dvbridge/dv_stb26/dm_trim_interpolation.c
new file mode 100644
index 0000000..01df130
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_trim_interpolation.c
@@ -0,0 +1,163 @@
+/* Trim interpolation brackets and inverse lookup tables. */
+#include "dm_bindings.h"
+#include "dm_layout.h"
+
+void dovi_dm_FindInterpIdx(int *coordinates, int last_index, int target, int *lower_index,
+                           int *upper_index)
+{
+    int next;
+    int lower;
+
+    *upper_index = 0;
+    *lower_index = 0;
+    if ((last_index != 0) && (*coordinates <= target)) {
+        next = *upper_index;
+        do {
+            lower = next;
+            next = lower + 1;
+            *upper_index = next;
+            if (last_index < next)
+                break;
+        } while (coordinates[next] <= target);
+        *lower_index = lower;
+        if (last_index < *upper_index) {
+            *upper_index = lower;
+        }
+    }
+    return;
+}
+
+unsigned int dovi_dm_BuildInterpInfo(long config, long metadata, int *trim_header, int *coordinates,
+                                     long indices, int last_index, int target,
+                                     unsigned int *weight_q12, long default_trim, long *lower_trim,
+                                     long *upper_trim)
+{
+    int trim_index;
+    unsigned int coordinate_delta;
+    unsigned int weight;
+    unsigned long quotient;
+    int lower_index;
+    long selected_trim;
+    unsigned int uses_default;
+    int upper_index;
+
+    dovi_SortAscend((void *)(coordinates), (void *)(indices), (unsigned int)(last_index));
+    if ((last_index == 0) || (target < *coordinates)) {
+        lower_index = 0;
+        upper_index = 0;
+    } else {
+        trim_index = 0;
+        do {
+            lower_index = trim_index;
+            trim_index = lower_index + 1;
+            upper_index = lower_index;
+            if (last_index < trim_index)
+                break;
+            upper_index = trim_index;
+        } while (coordinates[trim_index] <= target);
+    }
+    if ((*(int *)(indices + (long)lower_index * 4) == trim_header[2]) ||
+        (*(int *)(indices + (long)upper_index * 4) == trim_header[2])) {
+        if (upper_index == lower_index) {
+            uses_default = 1;
+        } else if (*trim_header == 8) {
+            dovi_dm_SetDefaultL8Trim((long)(config + 0x708), (long)(default_trim));
+            uses_default = 1;
+        } else {
+            *(short *)(default_trim + 2) = ((short)*(unsigned int *)(config + 0x78c) -
+                                            (short)*(unsigned int *)(config + 0x7e0)) *
+                                               2 +
+                                           -0x800;
+            *(short *)(default_trim + 4) = ((short)*(unsigned int *)(config + 0x790) -
+                                            (short)*(unsigned int *)(config + 0x7e4)) *
+                                               2 +
+                                           -0x800;
+            *(short *)(default_trim + 6) = ((short)*(unsigned int *)(config + 0x794) -
+                                            (short)*(unsigned int *)(config + 0x7e8)) *
+                                               2 +
+                                           -0x800;
+            *(short *)(default_trim + 8) =
+                (short)*(unsigned int *)(config + 0x798) - (short)*(unsigned int *)(config + 0x7ec);
+            *(short *)(default_trim + 10) =
+                (short)*(unsigned int *)(config + 0x79c) - (short)*(unsigned int *)(config + 0x7f0);
+            uses_default = 1;
+            *(unsigned short *)(default_trim + 0xc) =
+                (unsigned short)((unsigned int)(*(int *)(config + 0x7a0) -
+                                                *(int *)(config + 0x7f4)) >>
+                                 1) &
+                0x7fff;
+        }
+    } else {
+        uses_default = 0;
+    }
+    trim_index = *(int *)(indices + (long)lower_index * 4);
+    selected_trim = default_trim;
+    if (trim_index != trim_header[2]) {
+        if (*trim_header == 8) {
+            selected_trim = metadata + (long)trim_index * 0x2a + 0x11c;
+        } else {
+            selected_trim = metadata + (long)trim_index * 0xe + 0x90;
+        }
+    }
+    *lower_trim = selected_trim;
+    trim_index = *(int *)(indices + (long)upper_index * 4);
+    if (trim_index != trim_header[2]) {
+        if (*trim_header == 8) {
+            default_trim = metadata + (long)trim_index * 0x2a + 0x11c;
+        } else {
+            default_trim = metadata + (long)trim_index * 0xe + 0x90;
+        }
+    }
+    *upper_trim = default_trim;
+    if (lower_index == upper_index) {
+        weight = 0;
+    } else {
+        coordinate_delta = target - coordinates[lower_index];
+        quotient = dovi_sdiv(
+            (unsigned long long)((-(unsigned long)(coordinate_delta >> 0x1f) & 0xfffff00000000000) |
+                                 (unsigned long)coordinate_delta << 0xc),
+            (unsigned int)(coordinates[upper_index] - coordinates[lower_index]));
+        weight = (unsigned int)quotient;
+    }
+    *weight_q12 = weight;
+    return uses_default;
+}
+
+void dovi_dm_MakeTheInverseLutUnique(long input_lut, unsigned int *output_lut, short *inverse_lut,
+                                     int *last_index)
+{
+    short previous_value;
+    int output_index;
+    int input_last;
+    int run_end;
+    int input_index;
+
+    input_last = *last_index;
+    if (0 < input_last) {
+        previous_value = *inverse_lut;
+        input_index = 1;
+        output_index = -1;
+        run_end = -1;
+        do {
+            if (previous_value != inverse_lut[input_index]) {
+                run_end = input_index + -1;
+                output_index = output_index + 1;
+                output_lut[output_index] = *(unsigned int *)(input_lut + (long)run_end * 4);
+                inverse_lut[output_index] = previous_value;
+                previous_value = inverse_lut[input_index];
+                input_last = *last_index;
+            }
+            input_index = input_index + 1;
+        } while (input_index <= input_last);
+        if (-1 < output_index) {
+            output_index = output_index + 1;
+            output_lut[output_index] = *(unsigned int *)(input_lut + (long)(run_end + 1) * 4);
+            inverse_lut[output_index] = previous_value;
+            *last_index = output_index;
+            return;
+        }
+    }
+    *output_lut = *(unsigned int *)(input_lut + (long)input_last * 4);
+    *last_index = 0;
+    return;
+}
diff --git a/tools/dvbridge/dv_stb26/dm_trim_luminance.c b/tools/dvbridge/dv_stb26/dm_trim_luminance.c
new file mode 100644
index 0000000..56edcf0
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_trim_luminance.c
@@ -0,0 +1,164 @@
+/* Luminance coordinates for trim interpolation. */
+#include "dm_bindings.h"
+#include "dm_layout.h"
+#include "dm_map_workspace.h"
+
+void dovi_dm_BuildLumaXInfo(int coordinate_scale, unsigned long unused_state, long config,
+                            unsigned int flags, int exclude_default, long metadata, long signal,
+                            int *trim_header, long coordinates, long indices,
+                            unsigned int *last_index, int *target_coordinate)
+{
+    _Alignas(16) struct dm_luma_coordinates_workspace scratch;
+    unsigned char display_id;
+    unsigned short maximum_pq;
+    unsigned int rounded_coordinate;
+    unsigned int coordinate_word;
+    long coordinate_lookup;
+    int coordinate_value;
+    unsigned long remaining_displays;
+    unsigned short *display_maximum;
+    long duplicate_offset;
+    long trim_cursor;
+
+    scratch.level10 = 0;
+
+    scratch.rounded.values[16] = 0;
+    scratch.rounded.pairs[6] = 0;
+    scratch.rounded.pairs[7] = 0;
+    scratch.rounded.pairs[4] = 0;
+    scratch.rounded.pairs[5] = 0;
+    scratch.rounded.pairs[2] = 0;
+    scratch.rounded.pairs[3] = 0;
+    scratch.rounded.pairs[0] = 0;
+    scratch.rounded.pairs[1] = 0;
+    scratch.upper.values[16] = 0;
+    scratch.upper.pairs[6] = 0;
+    scratch.upper.pairs[7] = 0;
+    scratch.upper.pairs[4] = 0;
+    scratch.upper.pairs[5] = 0;
+    scratch.upper.pairs[3] = 0;
+    scratch.upper.pairs[1] = 0;
+    scratch.upper.pairs[2] = 0;
+    scratch.upper.pairs[0] = 0;
+    if (((flags >> 10 & 1) != 0) && (metadata != 0)) {
+        scratch.level10 = 0;
+        if ((*(unsigned char *)(metadata + 1) & 4) != 0) {
+            scratch.level10 = metadata + 0x218;
+        }
+    }
+    if (trim_header[2] == 0) {
+        _printk(dovi_dm_assertion_format,
+                "../dolby_vision/dv_source_code/libs/dm/dlb_dm_process/src/CdmCmmtFxp.c",
+                "BuildLumaXInfo", 0x923, "pTrimHdr->TrimNum");
+        dump_stack();
+    }
+    *last_index = 0;
+    *target_coordinate = 0;
+    if (0 < trim_header[2]) {
+        trim_cursor = 0;
+        do {
+            if (*trim_header == 8) {
+                display_id = *(unsigned char *)(metadata + trim_cursor * 0x2a + 0x11c);
+                coordinate_lookup = (long)dovi_GetDisplay((unsigned int)(display_id));
+                if ((int *)(metadata + 0x110) != trim_header) {
+                    _printk(
+                        dovi_dm_assertion_format,
+                        "../dolby_vision/dv_source_code/libs/dm/dlb_dm_process/src/CdmCmmtFxp.c",
+                        "BuildLumaXInfo", 0x92f, "pTrimHdr == (TrimComHdr_t *)&hMdsExt->trim8");
+                    dump_stack();
+                }
+                if (coordinate_lookup != 0) {
+                    coordinate_value = *(int *)(coordinate_lookup + 0xc);
+                    goto append_coordinate;
+                }
+                if ((scratch.level10 != 0) &&
+                    (remaining_displays = (unsigned long)*(unsigned int *)(scratch.level10 + 8),
+                     display_maximum = (unsigned short *)(scratch.level10 + 0xe),
+                     0 < (int)*(unsigned int *)(scratch.level10 + 8))) {
+                    do {
+                        if (display_maximum[-1] == (unsigned short)display_id) {
+                            maximum_pq = *display_maximum;
+                            goto scale_maximum_pq;
+                        }
+                        remaining_displays = remaining_displays - 1;
+                        display_maximum = display_maximum + 0xc;
+                    } while (remaining_displays != 0);
+                }
+            } else {
+                if ((int *)(metadata + 0x84) != trim_header) {
+                    _printk(
+                        dovi_dm_assertion_format,
+                        "../dolby_vision/dv_source_code/libs/dm/dlb_dm_process/src/CdmCmmtFxp.c",
+                        "BuildLumaXInfo", 0x940, "pTrimHdr == (TrimComHdr_t *)&hMdsExt->trim2");
+                    dump_stack();
+                }
+                maximum_pq = *(unsigned short *)(metadata + trim_cursor * 0xe + 0x90);
+            scale_maximum_pq:
+                coordinate_value = (unsigned int)maximum_pq << 6;
+            append_coordinate:
+                *(int *)(coordinates + (long)(int)*last_index * 4) = coordinate_value;
+                coordinate_word = *last_index;
+                coordinate_lookup = (long)(int)coordinate_word;
+                coordinate_value = *(int *)(coordinates + coordinate_lookup * 4);
+                if (0xfdbf < coordinate_value) {
+                    rounded_coordinate = coordinate_value * coordinate_scale;
+                    coordinate_value = (rounded_coordinate & 0xffffff00) + 0x100;
+                    rounded_coordinate = (rounded_coordinate + 0x80) & 0xffffff00;
+                    if (0 < (int)coordinate_word) {
+                        duplicate_offset = 0;
+                        do {
+                            if (duplicate_offset == 0x44)
+                                goto coordinate_limit;
+                            if ((rounded_coordinate ==
+                                 *(unsigned int *)((long)&scratch.rounded.pairs[0] + duplicate_offset)) ||
+                                (coordinate_value == *(int *)((long)&scratch.upper.pairs[0] + duplicate_offset)))
+                                goto next_trim;
+                            duplicate_offset = duplicate_offset + 4;
+                        } while ((unsigned long)coordinate_word * 4 - duplicate_offset != 0);
+                    }
+                    if ((coordinate_word == 0x11) || (0x44 < (unsigned long)(coordinate_lookup * 4)))
+                        goto coordinate_limit;
+                    *(int *)((long)&scratch.upper.pairs[0] + coordinate_lookup * 4) = coordinate_value;
+                    *(unsigned int *)((long)&scratch.rounded.pairs[0] + coordinate_lookup * 4) = rounded_coordinate;
+                    *(int *)(indices + coordinate_lookup * 4) = (int)trim_cursor;
+                    *last_index = *last_index + 1;
+                }
+            }
+        next_trim:
+            trim_cursor = trim_cursor + 1;
+        } while (trim_cursor < trim_header[2]);
+    }
+    if (exclude_default == 0) {
+        *(unsigned int *)(coordinates + (long)(int)*last_index * 4) =
+            (unsigned int)*(unsigned short *)(metadata + 0x4e) << 6;
+        coordinate_word = *last_index;
+        if (0 < (int)coordinate_word) {
+            trim_cursor = 0;
+            rounded_coordinate = *(int *)(coordinates + (long)(int)coordinate_word * 4) * coordinate_scale;
+            do {
+                if (trim_cursor == 0x44) {
+                coordinate_limit:
+                    dm_limit_trap();
+                }
+                if ((((rounded_coordinate + 0x80) & 0xffffff00) ==
+                     *(unsigned int *)((long)&scratch.rounded.pairs[0] + trim_cursor)) ||
+                    ((rounded_coordinate & 0xffffff00) + 0x100 ==
+                     *(int *)((long)&scratch.upper.pairs[0] + trim_cursor))) {
+                    *last_index = coordinate_word - 1;
+                    goto select_target_pq;
+                }
+                trim_cursor = trim_cursor + 4;
+            } while ((unsigned long)coordinate_word * 4 - trim_cursor != 0);
+        }
+        *(int *)(indices + (long)(int)coordinate_word * 4) = trim_header[2];
+    select_target_pq:
+        coordinate_word = *(unsigned int *)(signal + 0x80);
+    } else {
+        *last_index = *last_index - 1;
+        coordinate_word = dovi_LToPQ12((unsigned int)(*(unsigned int *)(config + 0x164)));
+        coordinate_word = coordinate_word & 0xffff;
+    }
+    *target_coordinate = coordinate_word << 6;
+
+    return;
+}
diff --git a/tools/dvbridge/dv_stb26/dm_types.h b/tools/dvbridge/dv_stb26/dm_types.h
new file mode 100644
index 0000000..fead2b7
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_types.h
@@ -0,0 +1,27 @@
+/* Scalar widths and fatal bounds checks for the LP64 processing interfaces. */
+#ifndef DOVI_DM_TYPES_H
+#define DOVI_DM_TYPES_H
+typedef unsigned char byte;
+typedef unsigned char uchar;
+typedef unsigned short ushort;
+typedef unsigned int uint;
+typedef unsigned long ulong;
+#ifndef __bool_true_false_are_defined
+typedef _Bool bool;
+#define true 1
+#define false 0
+#endif
+_Static_assert(sizeof(long) == 8 && sizeof(void *) == 8, "AArch64 LP64 required");
+#define CONCAT44(a, b) (((unsigned long)(unsigned int)(a) << 32) | (unsigned int)(b))
+
+/* Bounds and integrity failures do not return. */
+static inline __attribute__((noreturn)) void dm_limit_trap(void)
+{
+    __builtin_trap();
+}
+
+static inline __attribute__((noreturn)) void dm_integrity_trap(void)
+{
+    __builtin_trap();
+}
+#endif
diff --git a/tools/dvbridge/dv_stb26/dm_workspace.h b/tools/dvbridge/dv_stb26/dm_workspace.h
new file mode 100644
index 0000000..b97339a
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_workspace.h
@@ -0,0 +1,91 @@
+/* Local matrix and trim storage shared by the display-management stages. */
+#ifndef DOVI_DM_WORKSPACE_H
+#define DOVI_DM_WORKSPACE_H
+
+union dm_vector_workspace {
+    unsigned long pairs[2];
+    unsigned int words[4];
+};
+
+union dm_short_matrix_workspace {
+    unsigned long pairs[3];
+    short coefficients[12];
+};
+
+union dm_primaries_workspace {
+    unsigned long pairs[4];
+    int coordinates[8];
+    unsigned long *trim;
+};
+
+union dm_matrix_workspace {
+    unsigned long pairs[5];
+    int coefficients[10];
+};
+
+struct dm_consolidation_workspace {
+    unsigned char reserved_000[16];
+    union dm_vector_workspace diagonal;
+    union dm_vector_workspace white_xyz;
+    unsigned long white_xy;
+    union dm_short_matrix_workspace color_matrix;
+    union dm_primaries_workspace target;
+    union dm_primaries_workspace source;
+    union dm_matrix_workspace temperature;
+    unsigned short weight;
+    unsigned char reserved_0ba[6];
+    union dm_matrix_workspace rgb;
+    union dm_matrix_workspace xyz;
+    long mapping;
+    unsigned char reserved_118[104];
+};
+
+struct dm_output_workspace {
+    unsigned char reserved_000[16];
+    unsigned char *count;
+    unsigned char reserved_018[44];
+    unsigned int trim_count;
+
+    union {
+        unsigned long pairs[2];
+
+        struct {
+            unsigned int target;
+            unsigned short minimum;
+            unsigned short maximum;
+            unsigned char parameters[8];
+        } fields;
+    } level10;
+
+    union {
+        unsigned long pairs[8];
+        unsigned int indices[16];
+    } trims;
+
+    unsigned char reserved_098[136];
+};
+
+#define DM_WORKSPACE_OFFSET(type, field, offset) \
+    _Static_assert(__builtin_offsetof(struct type, field) == (offset), #type "." #field)
+DM_WORKSPACE_OFFSET(dm_consolidation_workspace, diagonal, 16);
+DM_WORKSPACE_OFFSET(dm_consolidation_workspace, white_xyz, 32);
+DM_WORKSPACE_OFFSET(dm_consolidation_workspace, white_xy, 48);
+DM_WORKSPACE_OFFSET(dm_consolidation_workspace, color_matrix, 56);
+DM_WORKSPACE_OFFSET(dm_consolidation_workspace, target, 80);
+DM_WORKSPACE_OFFSET(dm_consolidation_workspace, source, 112);
+DM_WORKSPACE_OFFSET(dm_consolidation_workspace, temperature, 144);
+DM_WORKSPACE_OFFSET(dm_consolidation_workspace, weight, 184);
+DM_WORKSPACE_OFFSET(dm_consolidation_workspace, rgb, 192);
+DM_WORKSPACE_OFFSET(dm_consolidation_workspace, xyz, 232);
+DM_WORKSPACE_OFFSET(dm_consolidation_workspace, mapping, 272);
+_Static_assert(sizeof(struct dm_consolidation_workspace) == 384, "consolidation workspace size");
+DM_WORKSPACE_OFFSET(dm_output_workspace, count, 16);
+DM_WORKSPACE_OFFSET(dm_output_workspace, trim_count, 68);
+DM_WORKSPACE_OFFSET(dm_output_workspace, level10, 72);
+DM_WORKSPACE_OFFSET(dm_output_workspace, level10.fields.minimum, 76);
+DM_WORKSPACE_OFFSET(dm_output_workspace, level10.fields.maximum, 78);
+DM_WORKSPACE_OFFSET(dm_output_workspace, level10.fields.parameters, 80);
+DM_WORKSPACE_OFFSET(dm_output_workspace, trims, 88);
+_Static_assert(sizeof(struct dm_output_workspace) == 288, "metadata output workspace size");
+#undef DM_WORKSPACE_OFFSET
+#endif
diff --git a/tools/dvbridge/dv_stb26/dv_stb26_api.c b/tools/dvbridge/dv_stb26/dv_stb26_api.c
new file mode 100644
index 0000000..9a07b08
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dv_stb26_api.c
@@ -0,0 +1,210 @@
+#include "dv_stb26_compat.h"
+#include "dv_stb26_api.h"
+#include "detect_mel.h"
+#include "tone_mapping_math.h"
+#include "color_basis.h"
+#include "control_target.h"
+#include "dm_pipeline.h"
+#include "pq_conversion.h"
+#include "nlq_layout.h"
+
+static bool s_stb26_engine_enabled = true;
+
+void dv_stb26_set_engine_enabled(bool enabled)
+{
+    s_stb26_engine_enabled = enabled;
+}
+
+bool dv_stb26_is_engine_enabled(void)
+{
+    return s_stb26_engine_enabled;
+}
+
+bool dv_stb26_detect_mel(const uint8_t *rpu_buf, size_t rpu_len)
+{
+    if (!rpu_buf)
+        return false;
+
+    if (rpu_len >= (size_t)(DOVI_NLQ_PARAMETERS_OFFSET + 3 * DOVI_NLQ_PARAMETER_BYTES)) {
+        return (dovi_detect_mel_payload(rpu_buf) == 1);
+    }
+
+    if (rpu_len >= (size_t)(3 * DOVI_NLQ_PARAMETER_BYTES)) {
+        for (int comp = 0; comp < 3; ++comp) {
+            const uint8_t *entry = rpu_buf + comp * DOVI_NLQ_PARAMETER_BYTES;
+            uint16_t offset = (uint16_t)entry[0] | ((uint16_t)entry[1] << 8);
+            uint32_t vdr_max_int = (uint32_t)entry[4] | ((uint32_t)entry[5] << 8) |
+                                  ((uint32_t)entry[6] << 16) | ((uint32_t)entry[7] << 24);
+            uint32_t slope_int = (uint32_t)entry[12] | ((uint32_t)entry[13] << 8) |
+                                ((uint32_t)entry[14] << 16) | ((uint32_t)entry[15] << 24);
+            uint32_t thresh_int = (uint32_t)entry[20] | ((uint32_t)entry[21] << 8) |
+                                 ((uint32_t)entry[22] << 16) | ((uint32_t)entry[23] << 24);
+            if (offset != 0 || vdr_max_int != 1 || slope_int != 0 || thresh_int != 0)
+                return false;
+        }
+        return true;
+    }
+
+    return false;
+}
+
+void dv_stb26_consolidate_active_area(uint32_t width, uint32_t height,
+                                      uint32_t crop_left, uint32_t crop_right,
+                                      uint32_t crop_top, uint32_t crop_bottom,
+                                      uint32_t out_active[4])
+{
+    if (!out_active)
+        return;
+
+    if (width == 0 || height == 0) {
+        out_active[0] = 0;
+        out_active[1] = 0;
+        out_active[2] = 0;
+        out_active[3] = 0;
+        return;
+    }
+
+    uint32_t left = crop_left;
+    uint32_t right = crop_right;
+    uint32_t top = crop_top;
+    uint32_t bottom = crop_bottom;
+
+    if (left >= width || top >= height || (left + right >= width) || (top + bottom >= height)) {
+        out_active[0] = 0;
+        out_active[1] = 0;
+        out_active[2] = 0;
+        out_active[3] = 0;
+    } else {
+        out_active[0] = left;
+        out_active[1] = right;
+        out_active[2] = top;
+        out_active[3] = bottom;
+    }
+}
+
+int dv_stb26_parse_target_vsvdb(const uint8_t *vsvdb, size_t len, dv_stb26_target_display_t *target)
+{
+    if (!vsvdb || len < 6 || !target)
+        return -1;
+
+    memset(target, 0, sizeof(*target));
+
+    if (vsvdb[1] != 0x46 || vsvdb[2] != 0xd0 || vsvdb[3] != 0x00) {
+        if (vsvdb[2] != 0x46 || vsvdb[3] != 0xd0 || vsvdb[4] != 0x00)
+            return -2;
+    }
+
+    uint8_t version = (vsvdb[5] >> 5) & 0x07;
+    target->vsvdb_version = version;
+
+    if (version == 2 && len >= 12) {
+        uint32_t min_lum = (uint32_t)(vsvdb[6] >> 3) * 20u;
+        uint32_t max_lum = (uint32_t)(vsvdb[7] >> 3) * 65u + 2055u;
+        target->min_pq = dovi_PQ12ToL(min_lum);
+        target->max_pq = dovi_PQ12ToL(max_lum);
+        return 0;
+    } else if (version == 1 && len >= 10) {
+        uint32_t min_lum = ((uint32_t)(vsvdb[7] >> 1) * (uint32_t)(vsvdb[7] >> 1) * 0x40000) / 0x3f01;
+        uint32_t max_lum = (uint32_t)(vsvdb[6] >> 1) * 0xc80000 + 0x1900000;
+        target->min_pq = dovi_LToPQ12(min_lum);
+        target->max_pq = dovi_LToPQ12(max_lum);
+        return 0;
+    } else if (version == 0 && len >= 8) {
+        target->min_pq = 0;
+        target->max_pq = 3072;
+        return 0;
+    }
+
+    return -3;
+}
+
+int dv_stb26_generate_tone_lut_4k(const dv_stb26_target_display_t *target,
+                                  uint16_t source_min_pq, uint16_t source_max_pq,
+                                  uint16_t source_avg_pq,
+                                  const void *ext_blocks, size_t ext_blocks_size,
+                                  uint16_t out_lut4096[4096])
+{
+    if (!out_lut4096)
+        return -1;
+
+    (void)ext_blocks;
+    (void)ext_blocks_size;
+    (void)source_avg_pq;
+
+    uint32_t t_min = target ? target->min_pq : 0;
+    uint32_t t_max = target ? target->max_pq : 3072;
+    if (t_max <= t_min)
+        t_max = 3072;
+
+    uint32_t s_min = source_min_pq;
+    uint32_t s_max = source_max_pq ? source_max_pq : 4095;
+
+    for (int i = 0; i < 4096; i++) {
+        uint32_t val;
+        if (i <= (int)s_min) {
+            val = t_min;
+        } else if (i >= (int)s_max) {
+            val = t_max;
+        } else {
+            float x = (float)(i - s_min) / (float)(s_max - s_min);
+            float s = x * x * (3.0f - 2.0f * x);
+            val = (uint32_t)(t_min + s * (t_max - t_min) + 0.5f);
+        }
+
+        if (val > 4095)
+            val = 4095;
+        out_lut4096[i] = (uint16_t)val;
+    }
+
+    return 0;
+}
+
+int dv_stb26_build_color_matrix(int input_space, int output_space,
+                                int signal_depth, int32_t matrix3x3[9], int32_t offsets[3])
+{
+    if (!matrix3x3 || !offsets)
+        return -1;
+
+    memset(matrix3x3, 0, 9 * sizeof(int32_t));
+    memset(offsets, 0, 3 * sizeof(int32_t));
+
+    if (input_space == 2 && output_space == 0) {
+        matrix3x3[0] = 16384; matrix3x3[1] =  1625; matrix3x3[2] = 13802;
+        matrix3x3[3] = 16384; matrix3x3[4] = -1540; matrix3x3[5] = -5348;
+        matrix3x3[6] = 16384; matrix3x3[7] = 17610; matrix3x3[8] =     0;
+    } else if (input_space == 1 && output_space == 0) {
+        matrix3x3[0] = 16384; matrix3x3[1] =     0; matrix3x3[2] = 23924;
+        matrix3x3[3] = 16384; matrix3x3[4] = -2695; matrix3x3[5] = -9352;
+        matrix3x3[6] = 16384; matrix3x3[7] = 30404; matrix3x3[8] =     0;
+        offsets[0] = 0;
+        offsets[1] = -(1 << (signal_depth - 1));
+        offsets[2] = -(1 << (signal_depth - 1));
+    } else {
+        matrix3x3[0] = 16384;
+        matrix3x3[4] = 16384;
+        matrix3x3[8] = 16384;
+    }
+
+    return 0;
+}
+
+int dv_stb26_prepare_hdmi_metadata_safe(const void *rpu_data, size_t rpu_size,
+                                        bool scene_refresh,
+                                        uint8_t *out_payload, size_t max_capacity,
+                                        size_t *out_size)
+{
+    if (!rpu_data || !out_payload || max_capacity < 64 || !out_size)
+        return -1;
+
+    (void)scene_refresh;
+
+    size_t copy_len = rpu_size;
+    if (copy_len > max_capacity) {
+        copy_len = max_capacity;
+    }
+
+    if (out_payload != rpu_data)
+        memcpy(out_payload, rpu_data, copy_len);
+    *out_size = copy_len;
+    return 0;
+}
diff --git a/tools/dvbridge/dv_stb26/dv_stb26_api.h b/tools/dvbridge/dv_stb26/dv_stb26_api.h
new file mode 100644
index 0000000..ce1c72b
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dv_stb26_api.h
@@ -0,0 +1,52 @@
+#ifndef DV_STB26_API_H
+#define DV_STB26_API_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void dv_stb26_set_engine_enabled(bool enabled);
+bool dv_stb26_is_engine_enabled(void);
