+    value = adjustments->chroma_weight;
+    scaled = value >> 1;
+    if (0x4000000 < value) {
+        scaled = 0x2000000;
+    }
+    if (value < -0x4000000) {
+        scaled = -0x2000000;
+    }
+    trim->chroma_weight = scaled;
+    value = adjustments->saturation_gain;
+    scaled = value >> 1;
+    if (0x4000000 < value) {
+        scaled = 0x2000000;
+    }
+    if (value < -0x4000000) {
+        scaled = -0x2000000;
+    }
+    trim->saturation_gain = scaled;
+    scaled = adjustments->luminance_gain;
+    if (0x3ffffff < scaled) {
+        scaled = 0x4000000;
+    }
+    if (scaled < 1) {
