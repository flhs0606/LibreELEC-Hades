diff --git a/tools/dvbridge/dv_stb26/dm_serialization.c b/tools/dvbridge/dv_stb26/dm_serialization.c
new file mode 100644
index 0000000..f997e03
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_serialization.c
@@ -0,0 +1,191 @@
+/* Serialize display metadata into a big-endian base and extension sequence. */
+#include "parser_api.h"
+#include "dm_serialization.h"
+#include "parser_contract.h"
+
+typedef char dm_unsigned_is_32[(sizeof(unsigned int) == 4) ? 1 : -1];
+typedef char dm_int_is_32[(sizeof(int) == 4) ? 1 : -1];
+
+static unsigned int dm_load32(const unsigned char *p)
+{
+    return (unsigned int)p[0] | ((unsigned int)p[1] << 8) | ((unsigned int)p[2] << 16) |
+           ((unsigned int)p[3] << 24);
+}
+
+static int dm_signed32(unsigned int value)
+{
+    return value <= 0x7fffffffu ? (int)value : -1 - (int)~value;
+}
+
+static void dm_pairs(unsigned char *dst, const unsigned char *src, unsigned int count)
+{
+    unsigned int index;
+    for (index = 0; index < count; index += 2) {
+        dst[index] = src[index + 1];
+        dst[index + 1] = src[index];
+    }
+}
+
+static void dm_reverse32(unsigned char *dst, const unsigned char *src)
+{
+    dst[0] = src[3];
+    dst[1] = src[2];
+    dst[2] = src[1];
+    dst[3] = src[0];
+}
+
+static void dm_block_header(unsigned char *dst, unsigned int count, unsigned char level)
+{
+    dst[0] = (unsigned char)(count >> 24);
+    dst[1] = (unsigned char)(count >> 16);
+    dst[2] = (unsigned char)(count >> 8);
+    dst[3] = (unsigned char)count;
+    dst[4] = level;
+}
+
+int dovi_dm_rpu_payload_2_byte_sequence(const void *dm, void *output, int *length)
+{
+    const unsigned char *src = (const unsigned char *)dm;
+    unsigned char *dst = (unsigned char *)output;
+    unsigned int index, position = 71;
+    if (*length < 71)
+        return -12;
+    dst[0] = (unsigned char)(src[1] | (src[0] << 4));
+    dst[1] = src[2];
+    dm_pairs(dst + 2, src + 4, 18);
+    for (index = 0; index < 3; ++index)
+        dm_reverse32(dst + 20 + index * 4, src + 24 + index * 4);
+    dm_pairs(dst + 32, src + 36, 24);
+    dm_reverse32(dst + 56, src + 60);
+    for (index = 0; index < 4; ++index)
+        dst[60 + index] = src[64 + index];
+    dm_pairs(dst + 64, src + 68, 6);
+    dst[70] = src[74];
+
+    for (index = 0; index < src[74]; ++index) {
+        const unsigned char *record = src + 76 + index * 264;
+        const unsigned char *payload = record + 6;
+        unsigned char *block = dst + dm_signed32(position);
+        unsigned int input_length = dm_load32(record), count, offset;
+        unsigned char level = record[4];
+        switch (level) {
+        case 1:
+        case 3:
+            count = 6;
+            break;
+        case 2:
+            count = 14;
+            break;
+        case 4:
+            count = 4;
+            break;
+        case 5:
+        case 6:
+            count = 8;
+            break;
+        case 8:
+            if (*length < dm_signed32(position + 18))
+                return -12;
+            block[4] = level;
+            block[5] = payload[0];
+            dm_pairs(block + 6, payload + 2, 12);
+            count = 13;
+            if (input_length >= 11) {
+                if (*length < dm_signed32(position + 20))
+                    return -12;
+                dm_pairs(block + 18, payload + 14, 2);
+                count = 15;
+                if (input_length >= 13) {
+                    if (*length < dm_signed32(position + 22))
+                        return -12;
+                    dm_pairs(block + 20, payload + 16, 2);
+                    count = 17;
+                    if (input_length >= 14) {
+                        if (*length < dm_signed32(position + 28))
+                            return -12;
+                        for (offset = 0; offset < 6; ++offset)
+                            block[22 + offset] = payload[18 + offset];
+                        count = 23;
+                        if (input_length >= 20) {
+                            if (*length < dm_signed32(position + 34))
+                                return -12;
+                            for (offset = 0; offset < 6; ++offset)
+                                block[28 + offset] = payload[24 + offset];
+                            count = 29;
+                        }
+                    }
+                }
+            }
+            dm_block_header(block, count, level);
+            position += count + 5;
+            continue;
+        case 9:
+            if (*length < dm_signed32(position + 6))
+                return -12;
+            block[4] = level;
+            block[5] = payload[0];
+            count = 1;
+            if (payload[0] >= 19) {
+                if (*length < dm_signed32(position + 22))
+                    return -12;
+                dm_pairs(block + 6, payload + 2, 16);
+                count = 17;
+            }
+            dm_block_header(block, count, level);
+            position += count + 5;
+            continue;
+        case 10:
+            if (*length < dm_signed32(position + 11))
+                return -12;
+            block[4] = level;
+            block[5] = payload[0];
+            dm_pairs(block + 6, payload + 2, 4);
+            block[10] = payload[6];
+            count = 6;
+            if (payload[6] >= 19) {
+                if (*length < dm_signed32(position + 27))
+                    return -12;
+                dm_pairs(block + 11, payload + 8, 16);
+                count = 22;
+            }
+            dm_block_header(block, count, level);
+            position += count + 5;
+            continue;
+        case 11:
+            count = 4;
+            break;
+        case 254:
+            count = 2;
+            break;
+        case 255:
+            count = 6;
+            break;
+        default:
+            count = input_length;
+            if (*length < dm_signed32(position + count + 5))
+                return -12;
+            dm_block_header(block, count, level);
+            for (offset = 0; offset < count; ++offset) {
+#if PARSER_WRAPPING_SEQUENCE_OFFSET
+                dst[dm_signed32(position + 5 + offset)] = payload[offset];
+#else
+                block[5 + offset] = payload[offset];
+#endif
+            }
+            position += count + 5;
+            continue;
+        }
+        if (*length < dm_signed32(position + count + 5))
+            return -12;
+        dm_block_header(block, count, level);
+        if (level == 11 || level >= 254) {
+            for (offset = 0; offset < count; ++offset)
+                block[5 + offset] = payload[offset];
+        } else {
+            dm_pairs(block + 5, payload, count);
+        }
+        position += count + 5;
+    }
+    *length = dm_signed32(position);
+    return 0;
+}
diff --git a/tools/dvbridge/dv_stb26/dm_serialization.h b/tools/dvbridge/dv_stb26/dm_serialization.h
new file mode 100644
index 0000000..b332bf2
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_serialization.h
@@ -0,0 +1,25 @@
+#ifndef DOVI_DM_SERIALIZATION_H
+#define DOVI_DM_SERIALIZATION_H
+
+/*
+ * Serialize the 0x10744-byte display-metadata payload into a big-endian base
+ * and extension sequence. *length is signed input capacity and becomes the
+ * written length only on success. Failure is -12 and retains partial writes.
+ * Input, output and length are stable, accessible and disjoint. Unknown
+ * extension lengths are unchecked and can require backing beyond the 256-byte
+ * record payload. Dynamic levels can write before a later capacity check.
+ */
+int dovi_dm_rpu_payload_2_byte_sequence(const void *payload, void *bytes, int *length);
+
+/*
+ * Native records have count at +0x4a and stride 0x108; packed records have
+ * count at +0x46 and stride 0x105. Both objects need complete, disjoint backing.
+ * Payload-to-struct conversion writes unknown lengths and payloads at the
+ * current output index without writing the level or advancing that index.
+ * Its level-10 lengths are 5/21 although the payload writes cover 6/22 bytes.
+ * Unknown lengths are unchecked. These converters are not lossless inverses
+ * for arbitrary records.
+ */
+void dovi_dm_rpu_payload_2_struct(const void *payload, void *packed);
+void dovi_dm_struct_2_rpu_payload(void *payload, const void *packed);
+#endif
diff --git a/tools/dvbridge/dv_stb26/dm_struct_conversion.c b/tools/dvbridge/dv_stb26/dm_struct_conversion.c
new file mode 100644
index 0000000..85584ff
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_struct_conversion.c
@@ -0,0 +1,269 @@
+/* Convert display metadata between native records and fixed packed records. */
+#include "dm_serialization.h"
+
+typedef unsigned char byte;
+typedef unsigned int u32;
+typedef unsigned long long u64;
+typedef char require_uint32[(sizeof(u32) == 4 && sizeof(int) == 4) ? 1 : -1];
+typedef char require_pointer64[(sizeof(void *) == 8) ? 1 : -1];
+
+static void copy_bytes(byte *dest, const byte *source, u32 count)
+{
+    while (count-- != 0)
+        *dest++ = *source++;
+}
+
+static u32 read_le32(const byte *p)
+{
+    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24);
+}
+
+static u32 read_be32(const byte *p)
+{
+    return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3];
+}
+
+static void write_le32(byte *p, u32 value)
+{
+    p[0] = (byte)value;
+    p[1] = (byte)(value >> 8);
+    p[2] = (byte)(value >> 16);
+    p[3] = (byte)(value >> 24);
+}
+
+static void write_be32(byte *p, u32 value)
+{
+    p[0] = (byte)(value >> 24);
+    p[1] = (byte)(value >> 16);
+    p[2] = (byte)(value >> 8);
+    p[3] = (byte)value;
+}
+
+static void swap_words(byte *dest, const byte *source, u32 count, u32 width)
+{
+    u32 i;
+    while (count-- != 0) {
+        for (i = 0; i < width; ++i)
+            dest[i] = source[width - 1u - i];
+        dest += width;
+        source += width;
+    }
+}
+
+static void pack_header(byte *dest, const byte *source)
+{
+    dest[0] = (byte)((u32)source[0] << 4 | source[1]);
+    dest[1] = source[2];
+    swap_words(dest + 0x02, source + 0x04, 9, 2);
+    swap_words(dest + 0x14, source + 0x18, 3, 4);
+    swap_words(dest + 0x20, source + 0x24, 12, 2);
+    swap_words(dest + 0x38, source + 0x3c, 1, 4);
+    copy_bytes(dest + 0x3c, source + 0x40, 4);
+    swap_words(dest + 0x40, source + 0x44, 3, 2);
+    dest[0x46] = source[0x4a];
+}
+
+static void unpack_header(byte *dest, const byte *source)
+{
+    dest[0] = source[0] >> 4;
+    dest[1] = source[0] & 15u;
+    dest[2] = source[1];
+    swap_words(dest + 0x04, source + 0x02, 9, 2);
+    swap_words(dest + 0x18, source + 0x14, 3, 4);
+    swap_words(dest + 0x24, source + 0x20, 12, 2);
+    swap_words(dest + 0x3c, source + 0x38, 1, 4);
+    copy_bytes(dest + 0x40, source + 0x3c, 4);
+    swap_words(dest + 0x44, source + 0x40, 3, 2);
+    dest[0x4a] = source[0x46];
+}
+
+static int known_level(u32 level)
+{
+    return (level >= 1u && level <= 11u && level != 7u) || level >= 254u;
+}
+
+/* Return packed payload length; type and payload are written, not length. */
+static u32 pack_record(byte *dest, const byte *source, int fixed_struct)
+{
+    u32 level = source[4], length = read_le32(source), result;
+    dest[4] = (byte)level;
+    switch (level) {
+    case 1:
+    case 3:
+        swap_words(dest + 5, source + 6, 3, 2);
+        return 6;
+    case 2:
+        swap_words(dest + 5, source + 6, 7, 2);
+        return 14;
+    case 4:
+        swap_words(dest + 5, source + 6, 2, 2);
+        return 4;
+    case 5:
+    case 6:
+        swap_words(dest + 5, source + 6, 4, 2);
+        return 8;
+    case 8:
+        dest[5] = source[6];
+        swap_words(dest + 6, source + 8, 6, 2);
+        result = 13;
+        if (length >= 11u) {
+            swap_words(dest + 18, source + 0x14, 1, 2);
+            result = 15;
+            if (length >= 13u) {
+                swap_words(dest + 20, source + 0x16, 1, 2);
+                result = 17;
+                if (length >= 14u) {
+                    copy_bytes(dest + 22, source + 0x18, 6);
+                    result = 23;
+                    if (length >= 20u) {
+                        copy_bytes(dest + 28, source + 0x1e, 6);
+                        result = 29;
+                    }
+                }
+            }
+        }
+        return result;
+    case 9:
+        dest[5] = source[6];
+        if (source[6] >= 19u) {
+            swap_words(dest + 6, source + 8, 8, 2);
+            return 17;
+        }
+        return 1;
+    case 10:
+        dest[5] = source[6];
+        swap_words(dest + 6, source + 8, 2, 2);
+        dest[10] = source[0x0c];
+        result = fixed_struct ? 5u : 6u;
+        if (source[0x0c] >= 19u) {
+            swap_words(dest + 11, source + 0x0e, 8, 2);
+            result += 16u;
+        }
+        return result;
+    case 11:
+        copy_bytes(dest + 5, source + 6, 4);
+        return 4;
+    case 254:
+        copy_bytes(dest + 5, source + 6, 2);
+        return 2;
+    case 255:
+        copy_bytes(dest + 5, source + 6, 6);
+        return 6;
+    default:
+        copy_bytes(dest + 5, source + 6, length);
+        return length;
+    }
+}
+
+void dovi_dm_rpu_payload_2_struct(const void *payload, void *packed)
+{
+    const byte *source = (const byte *)payload;
+    byte *dest = (byte *)packed;
+    u32 input_index, output_index = 0;
+    pack_header(dest, source);
+    for (input_index = 0; input_index < source[0x4a]; ++input_index) {
+        const byte *record = source + 0x4c + input_index * 0x108u;
+        byte *target = dest + 0x47 + output_index * 0x105u;
+        if (known_level(record[4])) {
+            u32 length = pack_record(target, record, 1);
+            write_be32(target, length);
+            ++output_index;
+        } else {
+            /* Original omits both type write and output-index increment. */
+            u32 length = read_le32(record);
+            write_be32(target, length);
+            copy_bytes(target + 5, record + 6, length);
+        }
+    }
+}
+
+void dovi_dm_struct_2_rpu_payload(void *payload, const void *packed)
+{
+    byte *dest = (byte *)payload;
+    const byte *source = (const byte *)packed;
+    u32 i;
+    unpack_header(dest, source);
+    for (i = 0; i < dest[0x4a]; ++i) {
+        const byte *record = source + 0x47 + i * 0x105u;
+        byte *target = dest + 0x4c + i * 0x108u;
+        u32 level = record[4], length = read_be32(record);
+        target[4] = (byte)level;
+        switch (level) {
+        case 1:
+        case 3:
+            write_le32(target, 5);
+            swap_words(target + 6, record + 5, 3, 2);
+            break;
+        case 2:
+            write_le32(target, 11);
+            swap_words(target + 6, record + 5, 7, 2);
+            break;
+        case 4:
+            write_le32(target, 3);
+            swap_words(target + 6, record + 5, 2, 2);
+            break;
+        case 5:
+        case 6:
+            write_le32(target, level == 5u ? 7u : 8u);
+            swap_words(target + 6, record + 5, 4, 2);
+            break;
+        case 8:
+            write_le32(target, 10);
+            target[6] = record[5];
+            swap_words(target + 8, record + 6, 6, 2);
+            if (length > 13u) {
+                write_le32(target, 12);
+                swap_words(target + 0x14, record + 18, 1, 2);
+                if (length > 15u) {
+                    write_le32(target, 13);
+                    swap_words(target + 0x16, record + 20, 1, 2);
+                    if (length > 17u) {
+                        write_le32(target, 19);
+                        copy_bytes(target + 0x18, record + 22, 6);
+                        if (length > 23u) {
+                            write_le32(target, 25);
+                            copy_bytes(target + 0x1e, record + 28, 6);
+                        }
+                    }
+                }
+            }
+            break;
+        case 9:
+            write_le32(target, 1);
+            target[6] = record[5];
+            if (record[5] >= 19u) {
+                write_le32(target, 17);
+                swap_words(target + 8, record + 6, 8, 2);
+            }
+            break;
+        case 10:
+            write_le32(target, 6);
+            target[6] = record[5];
+            swap_words(target + 8, record + 6, 2, 2);
+            target[0x0c] = record[10];
+            if (record[10] >= 19u) {
+                write_le32(target, 22);
+                swap_words(target + 0x0e, record + 11, 8, 2);
+            }
+            break;
+        case 11:
+            write_le32(target, 4);
+            copy_bytes(target + 6, record + 5, 4);
+            break;
+        case 254:
+            write_le32(target, 2);
+            copy_bytes(target + 6, record + 5, 2);
+            break;
+        case 255:
+            write_le32(target, 6);
+            copy_bytes(target + 6, record + 5, 6);
+            break;
+        default:
+            write_le32(target, length);
+            copy_bytes(target + 6, record + 5, length);
+            break;
+        }
+    }
+    if (i < 255u)
+        dest[0x50 + i * 0x108u] = 0;
+}
diff --git a/tools/dvbridge/dv_stb26/dm_transfer.c b/tools/dvbridge/dv_stb26/dm_transfer.c
new file mode 100644
index 0000000..3c93fa2
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/dm_transfer.c
@@ -0,0 +1,113 @@
+/* Transfer-function selection and fixed-point de-gamma. */
+#include "dm_bindings.h"
+#include "dm_layout.h"
+
+int dovi_dm_GetTcLutDir(const void *handle)
+{
+    const unsigned char *context = handle;
+    unsigned int primary = fixed_load_le32(context + DM_CONTEXT_PRIMARY_SIGNAL_OFFSET);
+    unsigned int signal_index = primary == 0 ? 1 : primary;
+    unsigned int direction;
+
+    if (fixed_load_le32(context + DM_CONTEXT_PREVIOUS_MODE_OFFSET) ==
+            fixed_load_le32(context + DM_CONTEXT_CURRENT_MODE_OFFSET) ||
+        signal_index != primary) {
+        if (signal_index >= DM_SIGNAL_COUNT)
+            dm_limit_trap();
+        context += (unsigned long)signal_index * DM_CONTEXT_INPUT_STATE_STRIDE;
+    }
+    direction = fixed_load_le32(context + DM_CONTEXT_TONE_DIRECTION_OFFSET);
+    return direction == 0 ? 1 : -(int)(direction == 1);
+}
+
+unsigned long dovi_dm_DeGamma(unsigned int gain, unsigned int offset, unsigned int exponent,
+                              unsigned int overflow_scale, unsigned int sample)
+{
+    const unsigned short *log_values = dovi_log10_value;
+    const unsigned int *log_rates = (const unsigned int *)dovi_log10_rate;
+    const unsigned int (*power_values)[1024] = dovi_power10_value;
+    const unsigned char *power_scales = dovi_power10_scale;
+/* Merged from dm_degamma_impl.inc */
+/* Common fixed-point calculation. The enclosing native entry binds its
+ * immutable table views and narrows or preserves the resulting 64-bit value. */
+unsigned int sum = (sample & 0xffffu) + (offset & 0xffffu);
+unsigned int input = sum > 0xffffu ? sum >> 1 : sum;
+unsigned int index = input >> 4;
+unsigned int log_value, power_row, table_value;
+unsigned long long result = 0;
+
+log_value = (log_values[index] -
+             ((log_rates[index] * (input & 0xfu)) >> 8)) *
+            (exponent & 0xffffu);
+power_row = log_value >> 26;
+if (power_row < 10u) {
+    table_value = power_values[power_row][(log_value >> 16) & 0x3ffu];
+    if (sum > 0xffffu)
+        table_value = (unsigned int)(((unsigned long long)table_value *
+                                      overflow_scale) >> 18);
+    result = ((unsigned long long)table_value * (gain & 0xffffu)) >>
+             ((power_scales[power_row] - 16u) & 0x3fu);
+}
+
+    return (unsigned long)result;
+}
