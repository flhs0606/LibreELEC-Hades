+++ b/tools/dvbridge/dv_stb26/rpu_header.c
@@ -0,0 +1,280 @@
+/* Parse RPU header fields and update decoder sequence state. */
+#include "parser_api.h"
+#include "rpu_header.h"
+#include "bitstream.h"
+
+typedef unsigned char byte;
+typedef unsigned int u32;
+typedef char require_uint32[(sizeof(u32) == 4) ? 1 : -1];
+typedef char require_int32[(sizeof(int) == 4) ? 1 : -1];
+typedef char require_pointer64[(sizeof(void *) == 8 && sizeof(dovi_rpu_header_log_fn) == 8 &&
+                                sizeof(dovi_rpu_header_event_fn) == 8)
+                                   ? 1
+                                   : -1];
+
+static void copy_bytes(byte *dest, const byte *src, u32 count)
+{
+    while (count-- != 0)
+        *dest++ = *src++;
+}
+
+static u32 read32(const byte *p)
+{
+    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24);
+}
+
+static void write16(byte *p, u32 value)
+{
+    p[0] = (byte)value;
+    p[1] = (byte)(value >> 8);
+}
+
+static void write32(byte *p, u32 value)
+{
+    p[0] = (byte)value;
+    p[1] = (byte)(value >> 8);
+    p[2] = (byte)(value >> 16);
+    p[3] = (byte)(value >> 24);
+}
+
+static byte *read_pointer(const byte *p)
+{
+    byte *value;
+    copy_bytes((byte *)&value, p, 8);
+    return value;
+}
+
+static dovi_rpu_header_log_fn read_log(const byte *p)
+{
+    dovi_rpu_header_log_fn value;
+    copy_bytes((byte *)&value, p, 8);
+    return value;
+}
+
+static dovi_rpu_header_event_fn read_event(const byte *p)
+{
+    dovi_rpu_header_event_fn value;
+    copy_bytes((byte *)&value, p, 8);
+    return value;
+}
+
+static int signed32(u32 value)
+{
+    return (value & 0x80000000u) ? -1 - (int)~value : (int)value;
+}
+
+/* The diagnostic formats one unsigned-byte argument. */
+/* Merged from rpu_defaults_impl.inc */
+/* Default RPU header fields and unavailable-ID diagnostics. */
+static void unavailable_id_message(char *message, byte id)
+{
+    static const char prefix[] = "RPU ID ";
+    static const char suffix[] = " not available";
+    volatile char *zero = message;
+    u32 i, pos = 0;
+    for (i = 0; i < 256u; ++i)
+        zero[i] = 0;
+    for (i = 0; prefix[i] != 0; ++i)
+        message[pos++] = prefix[i];
+    if (id >= 100u)
+        message[pos++] = (char)('0' + id / 100u);
+    if (id >= 10u)
+        message[pos++] = (char)('0' + (id / 10u) % 10u);
+    message[pos++] = (char)('0' + id % 10u);
+    for (i = 0; suffix[i] != 0; ++i)
+        message[pos++] = suffix[i];
+}
+
+static void default_sequence(byte *header)
+{
+    header[0x14] = 0;
+    header[0x15] = 0;
+    header[0x07] = 0;
+    header[0x08] = 0;
+    header[0x09] = 0;
+    header[0x0a] = 15;
+    header[0x0d] = 1;
+    header[0x0e] = 0;
+    header[0x0f] = 10;
+    header[0x10] = 10;
+    header[0x11] = 14;
+    header[0x12] = 0;
+    header[0x16] = 1;
+}
+
+static void default_mapping(byte *header)
+{
+    u32 bl_depth = header[0x0f], el_depth;
+    u32 limit;
+    write16(header + 0x1c, 0);
+    write16(header + 0x28, 0);
+    header[0x25] = 2;
+    header[0x26] = 2;
+    header[0x27] = 2;
+    if (bl_depth < 8u) {
+        bl_depth = 8;
+        header[0x0f] = 8;
+    }
+    write16(header + 0x48, 0);
+    limit = ~(0xffffffffu << (bl_depth & 31u));
+    el_depth = header[0x10];
+    write16(header + 0x68, 0);
+    header[0xf0] = 0;
+    header[0xf1] = 2;
+    write16(header + 0x2a, limit);
+    write16(header + 0x4a, limit);
+    write16(header + 0x6a, limit);
+    if (el_depth < 8u) {
+        el_depth = 8;
+        header[0x10] = 8;
+    }
+    /* Exactly +0xf2; the next entry at +0xf4 is deliberately untouched. */
+    write16(header + 0xf2, ~(0xffffffffu << (el_depth & 31u)));
+    header[0x133] = 1;
+    header[0x134] = 1;
+}
+
+
+static void read_pivots(byte *header, u32 count_offset, u32 array_offset, u32 depth_offset,
+                        struct dovi_bitstream *bits)
+{
+    u32 i;
+    for (i = 0; i < header[count_offset]; ++i) {
+        u32 value = dovi_read_u_v(header[depth_offset], bits);
+#if PARSER_FATAL_ARRAY_LIMITS
+        /* Consume the seventeenth value before trapping. */
+        if (i == 16u)
+            parser_limit_trap();
+#endif
+        write16(header + array_offset + i * 2u, value);
+    }
+}
+
+int dovi_rpu_header_read(void *ctx)
+{
+    byte *decoder = (byte *)ctx;
+    byte *header = read_pointer(read_pointer(decoder));
+    struct dovi_bitstream *bits = (struct dovi_bitstream *)(decoder + 0x40);
+    u32 initial_bits = bits->bits_read;
+    dovi_rpu_header_log_fn log = read_log(decoder + 0x315c8);
+    u32 log_level = read32(decoder + 0x315d0);
+    dovi_rpu_header_event_fn event;
+    u32 value, component;
+
+    header[0] = (byte)dovi_read_u_v(6, bits);
+    if (header[0] < 2u) {
+        if (log != 0 && log_level > 2u)
+            log("RPU Error: RPU type: %d not supported\n", (int)header[0]);
+        return -3;
+    }
+    write16(header + 2, dovi_read_u_v(11, bits));
+    if (header[0] != 2u)
+        return signed32(bits->bits_read - initial_bits);
+
+    header[4] = (byte)dovi_read_u_v(4, bits);
+    header[5] = (byte)dovi_read_u_v(4, bits);
+    header[6] = (byte)parser_read_flag(bits);
+    if (header[6] != 0) {
+        header[8] = (byte)parser_read_flag(bits);
+        header[9] = (byte)dovi_read_u_v(2, bits);
+        if (header[9] != 0) {
+            if (log != 0 && log_level > 2u)
+                log("RPU Error: Only fixed coefficient data type supported.\n");
+            return -3;
+        }
+        header[0x0a] = (byte)dovi_read_ue_v(bits);
+        if (header[8] != 0)
+            header[0x0c] = (byte)(dovi_read_ue_v(bits) + 6u);
+        header[0x0d] = (byte)dovi_read_u_v(2, bits);
+        header[0x0e] = (byte)parser_read_flag(bits);
+        if ((header[3] & 7u) == 0) {
+            header[0x0f] = (byte)(dovi_read_ue_v(bits) + 8u);
+            header[0x10] = (byte)(dovi_read_ue_v(bits) + 8u);
+            header[0x11] = (byte)(dovi_read_ue_v(bits) + 8u);
+            header[0x12] = (byte)parser_read_flag(bits);
+            if (header[0x12] != 0) {
+                header[0x13] = (byte)parser_read_flag(bits);
+                if (header[9] == 0 && header[0x13] != 0)
+                    header[0x0b] = (byte)(dovi_read_ue_v(bits) + 6u);
+            }
+            header[0x14] = (byte)dovi_read_u_v(3, bits);
+            header[0x15] = (byte)parser_read_flag(bits);
+            header[0x16] = (byte)parser_read_flag(bits);
+            if (header[0x16] == 0 && header[9] == 0 && header[8] != 0)
+                header[0x17] = (byte)(dovi_read_ue_v(bits) + 10u);
+        }
+        copy_bytes(decoder + 0x64, header + 7, 17);
+        write32(decoder + 0x78, 1);
+    } else if (read32(decoder + 0x78) == 0) {
+        event = read_event(decoder + 0x316d8);
+        if (event != 0)
+            event(4, 0x103, "No previous sequence header found, using default values.");
+        default_sequence(header);
+    } else {
+        copy_bytes(header + 7, decoder + 0x64, 17);
+    }
+
+    header[0x18] = (byte)parser_read_flag(bits);
+    header[0x19] = (byte)parser_read_flag(bits);
+    if (header[0x19] != 0) {
+        header[0x1a] = (byte)dovi_read_ue_v(bits);
+        /* The mask uses the retained +0x1b, not the newly read +0x1a. */
+        if (((read32(decoder + 0x7c) >> (header[0x1b] & 31u)) & 1u) == 0) {
+            event = read_event(decoder + 0x316d8);
+            if (event != 0) {
+                char message[256];
+                unavailable_id_message(message, header[0x1b]);
+                event = read_event(decoder + 0x316d8);
+                event(4, 0x104, message);
+            }
+            default_mapping(header);
+        }
+        return signed32(bits->bits_read - initial_bits);
+    }
+
+    header[0x1a] = 0;
+    value = dovi_read_ue_v(bits);
+    header[0x1b] = (byte)value;
+    write32(decoder + 0x7c, read32(decoder + 0x7c) | (1u << (value & 31u)));
+    header[0x1c] = (byte)dovi_read_ue_v(bits);
+    header[0x1d] = (byte)dovi_read_ue_v(bits);
+    if ((header[3] & 7u) == 0 && header[0x1d] != 0) {
+        header[0x1e] = (byte)dovi_read_u_v(4, bits);
+        if (header[0x1e] == 14u && header[0x1d] != 0) {
+            if (header[0x1d] == 2u)
+                header[0x1f] = (byte)(dovi_read_u_v(2, bits) * 2u + 4u);
+            header[0x20] = (byte)(dovi_read_u_v(2, bits) * 2u + 4u);
+        }
+    }
+
+    for (component = 0; component < 3u; ++component) {
+        header[0x25 + component] = (byte)(dovi_read_ue_v(bits) + 2u);
+        read_pivots(header, 0x25u + component, 0x28u + component * 0x20u, 0x0f, bits);
+    }
+    if ((header[3] & 7u) == 0 && header[0x12] != 0) {
+        header[0xe8] = (byte)dovi_read_u_v(3, bits);
+        if (header[0xe8] != 0) {
+            header[0xe9] = (byte)dovi_read_u_v(3, bits);
+            header[0xea] = (byte)dovi_read_u_v(3, bits);
+            header[0xeb] = (byte)dovi_read_u_v(3, bits);
+        }
+        header[0xec] = (byte)dovi_read_u_v(3, bits);
+        if (header[0xec] != 0) {
+            header[0xed] = (byte)dovi_read_u_v(3, bits);
+            header[0xee] = (byte)dovi_read_u_v(3, bits);
+            header[0xef] = (byte)dovi_read_u_v(3, bits);
+        }
+    }
+    if ((header[3] & 7u) == 0 && header[0x16] == 0) {
+        header[0xf0] = (byte)dovi_read_u_v(3, bits);
+        header[0xf1] = header[0x1d] == 2u ? (byte)(dovi_read_ue_v(bits) + 2u) : 2;
+        read_pivots(header, 0xf1, 0xf2, 0x10, bits);
+        if (header[0x1d] != 0)
+            header[0x132] = (byte)dovi_read_u_v(3, bits);
+    }
+    header[0x133] = (byte)(dovi_read_ue_v(bits) + 1u);
+    header[0x134] = (byte)(dovi_read_ue_v(bits) + 1u);
+    if ((int)header[0x133] + (int)header[0x134] - 1 > 1 && header[0] == 2u)
+        header[0x135] = (byte)dovi_read_ue_v(bits);
+    return signed32(bits->bits_read - initial_bits);
+}
diff --git a/tools/dvbridge/dv_stb26/rpu_header.h b/tools/dvbridge/dv_stb26/rpu_header.h
new file mode 100644
index 0000000..a4ccdf0
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/rpu_header.h
@@ -0,0 +1,26 @@
+#ifndef DOVI_RPU_HEADER_H
+#define DOVI_RPU_HEADER_H
+
+#include "decoder_lifecycle.h"
+
+#define DOVI_RPU_HEADER_SIZE 0x136u
+#define DOVI_RPU_HEADER_DECODER_MIN_SIZE 0x316e0u
+
+typedef int (*dovi_rpu_header_log_fn)(const char *format, ...);
+typedef dec_event_callback_t dovi_rpu_header_event_fn;
+
+/*
+ * decoder+0 points to a root whose first pointer is the writable header;
+ * decoder+0x40 holds struct dovi_bitstream. Sequence fields are cached at
+ * +0x64..+0x74, presence at +0x78 and the ID bitmap at +0x7c. Logging callback
+ * and level are at +0x315c8/+0x315d0; the event callback is at +0x316d8.
+ * Callbacks do not retain messages. Supply stable, disjoint writable objects
+ * and padded input as in bitstream.h.
+ *
+ * Returns a wrapping signed bit count or -3. Skipped fields retain contents,
+ * byte fields wrap. With PARSER_FATAL_ARRAY_LIMITS, the pivot reader traps after
+ * consuming a seventeenth pivot; otherwise pivot array indexing is unchecked.
+ */
+int dovi_rpu_header_read(void *decoder);
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/rpu_payload.c b/tools/dvbridge/dv_stb26/rpu_payload.c
new file mode 100644
index 0000000..10bc44e
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/rpu_payload.c
@@ -0,0 +1,515 @@
+/* RPU payload decoding. */
+#include "parser_api.h"
+#include "rpu_payload.h"
+#include "bitstream.h"
+#include "resampling_filters.h"
+#include "pivot_values.h"
+#include "nlq_layout.h"
+
+typedef unsigned char byte;
+typedef unsigned int u32;
+typedef unsigned long long u64;
+typedef int (*log_fn)(const char *, ...);
+typedef char require_uint32[(sizeof(u32) == 4 && sizeof(int) == 4) ? 1 : -1];
+typedef char require_pointer64[(sizeof(void *) == 8 && sizeof(log_fn) == 8 && sizeof(u64) == 8 &&
+                                sizeof(long long) == 8)
+                                   ? 1
+                                   : -1];
+
+static u32 read16(const byte *p)
+{
+    return (u32)p[0] | ((u32)p[1] << 8);
+}
+
+static u32 read32(const byte *p)
+{
+    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24);
+}
+
+static void write16(byte *p, u32 value)
+{
+    p[0] = (byte)value;
+    p[1] = (byte)(value >> 8);
+}
+
+static void write32(byte *p, u32 value)
+{
+    p[0] = (byte)value;
+    p[1] = (byte)(value >> 8);
+    p[2] = (byte)(value >> 16);
+    p[3] = (byte)(value >> 24);
+}
+
+static void copy_pointer(byte *to, const byte *from)
+{
+    u32 i;
+    for (i = 0; i < 8; ++i)
+        to[i] = from[i];
+}
+
+static byte *pointer_at(const byte *p)
+{
+    byte *value;
+    copy_pointer((byte *)&value, p);
+    return value;
+}
+
+static log_fn logger_at(const byte *p)
+{
+    log_fn value;
+    copy_pointer((byte *)&value, p);
+    return value;
+}
+
+static int signed32(u32 value)
+{
+    return (value & 0x80000000u) ? -1 - (int)~value : (int)value;
+}
+
+static byte *partition_at(byte *payload, int partition)
+{
+    /* ARM64 SMADDL: sign-extend the 32-bit index before multiplying. */
+    return (byte *)((u64)payload + (u64)((long long)partition * 0x7038));
+}
+
+static void error_line(log_fn log, u32 level, u32 line, int code)
+{
+    if (log != (log_fn)0 && level >= 3u)
+        log("%s+%d: %s\n", PARSER_DIAGNOSTIC_SOURCE, line, dovi_rpu_error_code_2_str(code));
+}
+
+/* Stores each pair immediately; later fields may fault or trigger a trap. */
+static void coefficient_pair(byte *integer, byte *fraction, byte *header, u32 width_offset,
+                             struct dovi_bitstream *bits)
+{
+    write32(integer, (u32)dovi_read_se_v(bits));
+    write32(fraction, dovi_read_u_v(header[width_offset], bits));
+}
+
+static void polynomial(byte *header, byte *record, u32 component, u32 pivot,
+                       struct dovi_bitstream *bits)
+{
+    byte order_minus_one = (byte)dovi_read_ue_v(bits);
+    u32 coefficient;
+    record[0] = (byte)(order_minus_one + 1u);
+    if (order_minus_one == 0) {
+        record[1] = (byte)parser_read_flag(bits);
+        if (record[0] == 1 && record[1] != 0) {
+            coefficient_pair(record + 4, record + 8, header, 10, bits);
+            if ((u32)header[0x25 + component] - 2u == pivot)
+                coefficient_pair(record + 0x38, record + 0x3c, header, 10, bits);
+            return;
+        }
+    }
+    coefficient_pair(record + 0xc, record + 0x20, header, 10, bits);
+    for (coefficient = 1;
+         coefficient <= record[0] && (!PARSER_FATAL_ARRAY_LIMITS || coefficient <= 4u);
+         ++coefficient)
+        coefficient_pair(record + 0xc + coefficient * 4u, record + 0x20 + coefficient * 4u, header,
+                         10, bits);
+#if PARSER_FATAL_ARRAY_LIMITS
+    if (record[0] > 4) {
+        (void)dovi_read_se_v(bits);
+        parser_limit_trap();
+    }
+#endif
+}
+
+static void multi_regression(byte *header, byte *record, struct dovi_bitstream *bits)
+{
+    u32 order, coefficient;
+    record[0] = (byte)(dovi_read_u_v(2, bits) + 1u);
+    coefficient_pair(record + 4, record + 8, header, 10, bits);
+    for (order = 0; order < record[0]; ++order) {
+        u32 value = (u32)dovi_read_se_v(bits);
+#if PARSER_FATAL_ARRAY_LIMITS
+        if (order == 3)
+            parser_limit_trap();
+#endif
+        write32(record + 0xc + order * 0x1c, value);
+        write32(record + 0x60 + order * 0x1c, dovi_read_u_v(header[10], bits));
+        for (coefficient = 1; coefficient < 7; ++coefficient)
+            coefficient_pair(record + 0xc + order * 0x1c + coefficient * 4u,
+                             record + 0x60 + order * 0x1c + coefficient * 4u, header, 10, bits);
+    }
+}
+
+static int mapping_read(byte *decoder, int partition, log_fn outer_log, u32 outer_level)
+{
+    byte *root = pointer_at(decoder);
+    byte *header = pointer_at(root);
+    byte *payload = pointer_at(root + 8);
+    byte *config = pointer_at(decoder + 8);
+    byte *part = partition_at(payload, partition);
+    struct dovi_bitstream *bits = (struct dovi_bitstream *)(decoder + 0x40);
+    log_fn log = logger_at(decoder + 0x315c8);
+    u32 level = read32(decoder + 0x315d0);
+    u32 component, pivot;
+    int predicted_partition = 0;
+
+    for (component = 0; component < 3; ++component) {
+        byte *pivot_count = header + 0x25 + component;
+        if (*pivot_count < 2)
+            *pivot_count = 2;
+        pivot = 0;
+        do {
+            byte mapping = (byte)dovi_read_ue_v(bits);
+            byte *reuse;
+            u32 coordinate = component * 0x3c + pivot * 4u;
+#if PARSER_FATAL_ARRAY_LIMITS
+            if (pivot == 15)
+                parser_limit_trap();
+#endif
+            part[component * 15u + pivot] = mapping;
+            reuse = part + 0x2d + component * 15u + pivot;
+            if (mapping <= 3) {
+                byte *count = config + mapping * 0xb4u + coordinate;
+                byte *history = config + 0x39c + mapping * 0xb4u + coordinate;
+                int use_prediction = 0;
+                if (signed32(read32(count)) < 1) {
+                    *reuse = 0;
+                } else {
+                    *reuse = (byte)parser_read_flag(bits);
+                    use_prediction = *reuse != 0;
+                }
+                if (use_prediction) {
+                    if (signed32(read32(count)) < 2) {
+                        predicted_partition = signed32(read32(history));
+                    } else {
+                        byte distance = (byte)(dovi_read_ue_v(bits) + 1u);
+                        predicted_partition = signed32((u32)partition - distance);
+                        part[0x605c + component * 15u + pivot] = distance;
+                    }
+                    /* The original dereferences before its range check. */
+                    write32(part + 0x6ea0 + coordinate,
+                            read32(partition_at(pointer_at(root + 8), predicted_partition) +
+                                   0x6ea0 + coordinate));
+                } else {
+                    byte *current_root = pointer_at(decoder);
+                    byte *current_header = pointer_at(current_root);
+                    byte *current_payload = pointer_at(current_root + 8);
+                    byte *current_part = partition_at(current_payload, partition);
+                    u32 record_offset;
+                    if (mapping == 0) {
+                        record_offset = 0x5c + component * 0x30c + pivot * 0x34;
+                        polynomial(current_header, current_part + record_offset, component, pivot,
+                                   bits);
+                    } else if (mapping == 1) {
+                        record_offset = 0x5c + component * 0xa8c + pivot * 0xb4;
+                        multi_regression(current_header, current_part + record_offset, bits);
+                    } else if (mapping == 2) {
+                        u32 coefficient;
+                        record_offset = 0x5c + component * 0x258 + pivot * 0x28;
+                        for (coefficient = 0; coefficient < 5; ++coefficient)
+                            coefficient_pair(current_part + record_offset + coefficient * 4u,
+                                             current_part + record_offset + 0x14 + coefficient * 4u,
+                                             current_header, 10, bits);
+                    } else {
+                        u32 first = read16(current_header + 0x88 + component * 0x20 + pivot * 2u);
+                        u32 end = read16(current_header + 0x8a + component * 0x20 + pivot * 2u);
+                        u32 entry;
+                        if ((u32)current_header[0x25 + component] - 2u == pivot)
+                            ++end;
+                        if (end > 0x400) {
+                            log_fn current_log = logger_at(decoder + 0x315c8);
+                            if (current_log != (log_fn)0 && read32(decoder + 0x315d0) >= 3)
+                                current_log(
+                                    "ERROR: Partition %d, cmp %d, pivot_idx %d:  mapping LUT size is limited to %d but is %d\n",
+                                    partition, component, pivot, 0x400, end);
+                            error_line(log, level, 0x371, -2);
+                            error_line(outer_log, outer_level, 0x3c1, -2);
+                            return -2;
+                        }
+                        record_offset = 0x5c + component * 0x2000;
+                        for (entry = first; entry < end; ++entry)
+                            coefficient_pair(current_part + record_offset + entry * 4u,
+                                             current_part + record_offset + 0x1000 + entry * 4u,
+                                             current_header, 10, bits);
+                    }
+                    if (read32(history) == 0)
+                        write32(history, (u32)partition);
+                    write32(part + 0x6ea0 + coordinate, (u32)((u64)current_payload - (u64)payload) +
+                                                            (u32)partition * 0x7038u +
+                                                            record_offset);
+                    write32(count, read32(count) + 1u);
+                }
+            }
+            if (*reuse == 1 && (predicted_partition < 0 || predicted_partition >= partition)) {
+                if (log != (log_fn)0 && level >= 3)
+                    log("ERROR: Partition %d, cmp %d, pivot_idx %d:  pred_part_idx_mapping shall be in the range [0 .. %d] but is %d\n",
+                        partition, component, pivot, partition - 1, predicted_partition);
+                error_line(outer_log, outer_level, 0x3c1, -2);
+                return -2;
+            }
+            ++pivot;
+        } while ((long long)pivot < (long long)*pivot_count - 1);
+    }
+    return 0;
+}
+
+/* Merged from rpu_chroma_impl.inc */
+/* Chroma filter dispatch with ordered inner and outer diagnostics. */
+static int chroma_read(byte *decoder, int partition, log_fn outer_log, u32 outer_level)
+{
+    byte *header = pointer_at(pointer_at(decoder));
+    log_fn log = logger_at(decoder + 0x315c8);
+    u32 level = read32(decoder + 0x315d0);
+    u32 component;
+    int result;
+    if (header[0x1e] != 14 || header[0x1d] == 0)
+        return 0;
+    for (component = 0; component < 2; ++component) {
+        if (header[0x1d] == 2) {
+            result = dovi_rpu_data_chroma_resampling_filter_1D_exp_read(decoder, partition,
+                                                                        component, 1);
+            if (result < 0) {
+                error_line(log, level, 0x21e, result);
+                error_line(outer_log, outer_level, 0x3c6, result);
+                return result;
+            }
+        }
+        result =
+            dovi_rpu_data_chroma_resampling_filter_1D_exp_read(decoder, partition, component, 0);
+        if (result < 0) {
+            error_line(log, level, 0x221, result);
+            error_line(outer_log, outer_level, 0x3c6, result);
+            return result;
+        }
+        if (header[0x1e] != 14 || header[0x1d] == 0)
+            break;
+    }
+    return 0;
+}
+
+
+static void residual_filter_read(byte *decoder)
+{
+    byte *root = pointer_at(decoder);
+    byte *header = pointer_at(root);
+    byte *payload = pointer_at(root + 8);
+    struct dovi_bitstream *bits = (struct dovi_bitstream *)(decoder + 0x40);
+    u32 row, coefficient;
+    write32(payload + 0x653c, dovi_read_u_v(header[0x11], bits));
+    write32(payload + 0x6540, dovi_read_u_v(header[0x11], bits));
+    if (header[0xe9] == 7) {
+        for (row = 0; row < 3; ++row) {
+            byte *current_root = pointer_at(decoder);
+            byte *current_header = pointer_at(current_root);
+            byte *current_payload = pointer_at(current_root + 8);
+            for (coefficient = 0; coefficient < 8; ++coefficient)
+                coefficient_pair(current_payload + 0x6544 + row * 0x20 + coefficient * 4u,
+                                 current_payload + 0x66c4 + row * 0x20 + coefficient * 4u,
+                                 current_header, 11, bits);
+        }
+    }
+    if (header[0xed] == 7) {
+        for (row = 0; row < 3; ++row) {
+            byte mode = header[0xec];
+            byte *current_root = pointer_at(decoder);
+            byte *current_header = pointer_at(current_root);
+            byte *current_payload = pointer_at(current_root + 8);
+            for (coefficient = 0; coefficient < 6; ++coefficient)
+                coefficient_pair(current_payload + 0x6604 + row * 0x20 + coefficient * 4u,
+                                 current_payload + 0x6784 + row * 0x20 + coefficient * 4u,
+                                 current_header, 11, bits);
+            if (mode == 1) {
+                for (coefficient = 0; coefficient < 6; ++coefficient)
+                    coefficient_pair(current_payload + 0x6664 + row * 0x20 + coefficient * 4u,
+                                     current_payload + 0x67e4 + row * 0x20 + coefficient * 4u,
+                                     current_header, 11, bits);
+            }
+        }
+    }
+
+}
+
+static int nlq_read(byte *decoder, int partition, log_fn outer_log, u32 outer_level)
+{
+    byte *root = pointer_at(decoder);
+    byte *header = pointer_at(root);
+    byte *payload = pointer_at(root + 8);
+    byte *config = pointer_at(decoder + 8);
+    byte *part = partition_at(payload, partition);
+    struct dovi_bitstream *bits = (struct dovi_bitstream *)(decoder + 0x40);
+    log_fn log = logger_at(decoder + 0x315c8);
+    u32 level = read32(decoder + 0x315d0);
+    u32 pivot = 0, component;
+    decoder[0x316e0] = 1;
+    if (header[0xf1] < 2)
+        header[0xf1] = 2;
+    do {
+#if PARSER_FATAL_ARRAY_LIMITS
+        if (pivot == 15)
+            parser_limit_trap();
+#endif
+        for (component = 0; component < 3; ++component) {
+            u32 coordinate = pivot * 3u + component;
+            byte *count = config + 0x2e8 + coordinate * 4u;
+            byte *reuse = part + DOVI_NLQ_PREDICTION_FLAGS_OFFSET + coordinate;
+            byte *record =
+                part + DOVI_NLQ_PARAMETERS_OFFSET + coordinate * DOVI_NLQ_PARAMETER_BYTES;
+            byte *reference = part + DOVI_NLQ_COEFFICIENT_REFERENCES_OFFSET + coordinate * 4u;
+            int use_prediction = 0;
+            if (signed32(read32(count)) < 1) {
+                *reuse = 0;
+            } else {
+                *reuse = (byte)parser_read_flag(bits);
+                use_prediction = *reuse != 0;
+            }
+            if (use_prediction) {
+                int predicted_partition;
+                if (signed32(read32(count)) < 2) {
+                    predicted_partition = 0;
+                } else {
+                    byte distance = (byte)(dovi_read_ue_v(bits) + 1u);
+                    predicted_partition = signed32((u32)partition - distance);
+                    reuse[DOVI_NLQ_PREDICTION_DISTANCE_OFFSET - DOVI_NLQ_PREDICTION_FLAGS_OFFSET] =
+                        distance;
+                }
+                if (*reuse == 1 && (predicted_partition < 0 || predicted_partition >= partition)) {
+                    if (log != (log_fn)0 && level >= 3)
+                        log("ERROR: Partition %d, cmp %d, pivot_idx %d:  pred_part_idx_nlq shall be in the range [0 .. %d] but is %d\n",
+#if PARSER_DECODER_EXTENSION_API
+                            partition, component, pivot, partition - 1, predicted_partition);
+#else
+                            partition, component, pivot, partition - 1);
+#endif
+                    error_line(outer_log, outer_level, 0x3d0, -1);
+                    return -1;
+                }
+                write32(reference,
+                        read32(partition_at(pointer_at(root + 8), predicted_partition) +
+                               DOVI_NLQ_COEFFICIENT_REFERENCES_OFFSET + coordinate * 4u));
+            } else {
+                u32 offset = dovi_read_u_v(header[0x10], bits);
+                write16(record + DOVI_NLQ_OFFSET, offset);
+                if ((offset & 0xffffu) != 0)
+                    decoder[0x316e0] = 0;
+                write32(record + DOVI_NLQ_VDR_IN_MAX_INT, dovi_read_ue_v(bits));
+                write32(record + DOVI_NLQ_VDR_IN_MAX_FRACTION, dovi_read_u_v(header[10], bits));
+                if (read32(record + DOVI_NLQ_VDR_IN_MAX_INT) != 1 ||
+                    read32(record + DOVI_NLQ_VDR_IN_MAX_FRACTION) != 0)
+                    decoder[0x316e0] = 0;
+                if (header[0xf0] == 1) {
+                    byte *current_root = pointer_at(decoder);
+                    byte *current_header = pointer_at(current_root);
+                    byte *current_part = partition_at(pointer_at(current_root + 8), partition);
+                    write16(current_part + DOVI_NLQ_UNION_OFFSET +
+                                coordinate * DOVI_NLQ_PARAMETER_BYTES,
+                            dovi_read_u_v(current_header[0x10], bits));
+                    write32(current_part + DOVI_NLQ_MU_LAW_MU_OFFSET +
+                                coordinate * DOVI_NLQ_PARAMETER_BYTES,
+                            dovi_read_ue_v(bits));
+                } else if (header[0xf0] == 0) {
+                    byte *current_root = pointer_at(decoder);
+                    byte *current_header = pointer_at(current_root);
+                    byte *current_record = partition_at(pointer_at(current_root + 8), partition) +
+                                           DOVI_NLQ_UNION_OFFSET +
+                                           coordinate * DOVI_NLQ_PARAMETER_BYTES;
+                    write32(current_record, dovi_read_ue_v(bits));
+                    write32(current_record + DOVI_NLQ_LINEAR_SLOPE_FRACTION -
+                                DOVI_NLQ_LINEAR_SLOPE_INT,
+                            dovi_read_u_v(current_header[10], bits));
+                    write32(current_record + DOVI_NLQ_LINEAR_THRESHOLD_INT -
+                                DOVI_NLQ_LINEAR_SLOPE_INT,
+                            dovi_read_ue_v(bits));
+                    write32(current_record + DOVI_NLQ_LINEAR_THRESHOLD_FRACTION -
+                                DOVI_NLQ_LINEAR_SLOPE_INT,
+                            dovi_read_u_v(current_header[10], bits));
+                    if (read32(record + DOVI_NLQ_LINEAR_SLOPE_INT) != 0 ||
+                        read32(record + DOVI_NLQ_LINEAR_SLOPE_FRACTION) != 0 ||
+                        read32(record + DOVI_NLQ_LINEAR_THRESHOLD_INT) != 0 ||
+                        read32(record + DOVI_NLQ_LINEAR_THRESHOLD_FRACTION) != 0)
+                        decoder[0x316e0] = 0;
+                }
+                write32(reference, (u32)partition * DOVI_RPU_PAYLOAD_PARTITION_BYTES +
+                                       DOVI_NLQ_PARAMETERS_OFFSET +
+                                       coordinate * DOVI_NLQ_PARAMETER_BYTES);
+                write32(count, read32(count) + 1u);
+            }
+        }
+        ++pivot;
+    } while ((long long)pivot < (long long)header[0xf1] - 1);
+    return 0;
+}
+
+static void nlq_filter_read(byte *decoder)
+{
+    byte *root = pointer_at(decoder);
+    byte *header = pointer_at(root);
+    byte *payload = pointer_at(root + 8);
+    struct dovi_bitstream *bits = (struct dovi_bitstream *)(decoder + 0x40);
+    u32 group, coefficient;
+    if (header[0x132] != 7)
+        return;
+    for (group = 0; group < 4; ++group) {
+        u32 offset = 0x6d90 + group * 0x44;
+        for (coefficient = 0; coefficient < 17; ++coefficient) {
+            u32 width = header[0x17];
+            u32 value = dovi_read_u_v(width + 2u, bits);
+/* STB 2.6 drops the sign bit when width&31 is 31; STB 2.4
+             * wraps width+1 before selecting its one-bit sign mask. */
+#if PARSER_NLQ_TRUNCATING_SIGN_SHIFT
+            value |= 0u - ((2u << (width & 31u)) & value);
+#else
+            value |= 0u - ((1u << ((width + 1u) & 31u)) & value);
+#endif
+            write32(payload + offset + coefficient * 4u, value);
+        }
+        write32(pointer_at(root + 8) + 0x7028 + group * 4u, offset);
+    }
+}
+
+int dovi_rpu_payload_read(void *opaque_decoder)
+{
+    byte *decoder = (byte *)opaque_decoder;
+    byte *root = pointer_at(decoder);
+    byte *header = pointer_at(root);
+    byte *config = pointer_at(decoder + 8);
+    struct dovi_bitstream *bits = (struct dovi_bitstream *)(decoder + 0x40);
+    u32 initial_bits = bits->bits_read;
+    log_fn log = logger_at(decoder + 0x315c8);
+    u32 level = read32(decoder + 0x315d0);
+    u32 i, row, column;
+    int partition = 0, result;
+    volatile byte *zero = config;
+    for (i = 0; i < 0x39c; ++i)
+        zero[i] = 0;
+    if (pointer_at(root)[0] != 2 || pointer_at(root)[0x19] != 0)
+        return signed32(bits->bits_read - initial_bits);
+    result = dovi_assign_pivot_values((void *)root);
+    if (result < 0)
+        return result;
+    if (header[0x16] == 0) {
+        result = dovi_assign_nlq_pivot_values((void *)root);
+        if (result < 0)
+            return result;
+    }
+    for (row = 0; row < header[0x134]; ++row) {
+        for (column = 0; column < header[0x133]; ++column) {
+            result = mapping_read(decoder, partition, log, level);
+            if (result < 0)
+                return result;
+            if ((read16(header + 2) & 0x700u) == 0 && header[0x1d] != 0 &&
+                (header[0x1e] & 0xfeu) == 14) {
+                result = chroma_read(decoder, partition, log, level);
+                if (result < 0)
+                    return result;
+            }
+            if (row == 0 && column == 0 && header[0x13] != 0 &&
+                (header[0xe9] == 7 || header[0xed] == 7))
+                residual_filter_read(decoder);
+            if ((read16(header + 2) & 0x700u) == 0 && header[0x16] == 0) {
+                result = nlq_read(decoder, partition, log, level);
+                if (result < 0)
+                    return result;
+                if (row == 0 && column == 0 && header[0x1d] != 0)
+                    nlq_filter_read(decoder);
+            } else {
+                decoder[0x316e0] = 0;
+            }
+            partition = signed32((u32)partition + 1u);
+        }
+    }
+    return signed32(bits->bits_read - initial_bits);
+}
diff --git a/tools/dvbridge/dv_stb26/rpu_payload.h b/tools/dvbridge/dv_stb26/rpu_payload.h
new file mode 100644
index 0000000..4fb2e58
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/rpu_payload.h
@@ -0,0 +1,17 @@
+#ifndef DOVI_RPU_PAYLOAD_H
+#define DOVI_RPU_PAYLOAD_H
+
+/*
+ * decoder+0 points to {header, payload}; decoder+8 points to writable
+ * configuration and +0x40 holds struct dovi_bitstream. Payload partitions have
+ * stride 0x7038. Logging callback/level are at +0x315c8/+0x315d0 and the MEL flag
+ * is at +0x316e0. Objects must be accessible, disjoint and stable; input is
+ * padded as in bitstream.h. Coefficient counts and indices are unchecked.
+ *
+ * Returns a wrapping signed bit count or a negative parser error. Partial
+ * writes, byte truncation, stale skipped fields and prediction reads before
+ * validation are preserved. Fatal limits follow parser_contract.h.
+ */
+int dovi_rpu_payload_read(void *decoder);
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/rpu_pipeline.c b/tools/dvbridge/dv_stb26/rpu_pipeline.c
new file mode 100644
index 0000000..31020f5
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/rpu_pipeline.c
@@ -0,0 +1,237 @@
+/* Run decoder stages and produce queued RPU output. */
+#include "rpu_pipeline.h"
+#include "fixed_access.h"
+#include "parser_access.h"
+#include "bitstream.h"
+#include "error_strings.h"
+#include "rpu_header.h"
+#include "rpu_validation.h"
+#include "rpu_payload.h"
+#include "detect_mel.h"
+#include "dm_payload.h"
+#include "rpu_buffering.h"
+#include "parser_layout.h"
+#include "parser_api.h"
+
+typedef char require_int32[(sizeof(int) == 4 && sizeof(unsigned int) == 4) ? 1 : -1];
+typedef char
+    require_pointer64[(sizeof(void *) == 8 && sizeof(dovi_validation_log_fn) == 8) ? 1 : -1];
+
+static dovi_validation_log_fn logger(const unsigned char *source)
+{
+    dovi_validation_log_fn value;
+    parser_copy8(&value, source);
+    return value;
+}
+
+static void outputs(unsigned char *decoder, void **header, void **payload, int *payload_size,
+                    void **dm, int *dm_size)
+{
+    unsigned char *data = parser_load_pointer(decoder);
+    *header = parser_load_pointer(data);
+    *payload = parser_load_pointer(parser_load_pointer(decoder) + 8);
+    data = parser_load_pointer(parser_load_pointer(decoder));
+    *payload_size = fixed_signed32((unsigned int)data[0x133] * data[0x134] * 0x7038u);
+    *dm = parser_load_pointer(parser_load_pointer(decoder) + 16);
+    *dm_size = 0x10744;
+}
+
+static int logged_error(dovi_validation_log_fn log, unsigned int severity, int error, int line)
+{
+    if (log != 0 && severity > 2u)
+        log("%s+%d: %s\n",
+            PARSER_DECODER_DIAGNOSTIC_SOURCE,
+            line, dovi_rpu_error_code_2_str(error));
+    return error;
+}
+
+/* Identity fallback writes only the first partition. */
+#if !PARSER_FATAL_ARRAY_LIMITS
+static
+#endif
+void dovi_set_default_payload(void *opaque)
+{
+    unsigned char *root = parser_load_pointer(opaque);
+    unsigned char *header = parser_load_pointer(root), *payload = parser_load_pointer(root + 8);
+    unsigned int component, pivot;
+    for (component = 0; component < 3; ++component) {
+        for (pivot = 0; (int)pivot < (int)header[0x25 + component] - 1; ++pivot) {
+            unsigned char *poly = payload + 0x5c + component * 0x30cu + pivot * 0x34u;
+#if PARSER_FATAL_ARRAY_LIMITS
+            if (pivot == 15u)
+                parser_limit_trap();
+#endif
+            payload[component * 15u + pivot] = 0;
+            payload[0x2d + component * 15u + pivot] = 0;
+            poly[0] = 1;
+            fixed_store_le32(poly + 0xc, 0);
+            fixed_store_le32(poly + 0x20, 0);
+            fixed_store_le32(poly + 0x10, 1);
+            fixed_store_le32(poly + 0x24, 0);
+        }
+    }
+#if PARSER_FATAL_ARRAY_LIMITS
+    if (header[0x16])
+        return;
+    fixed_store_le64(payload + 0x6898, 0);
+    fixed_store_le64(payload + 0x68a0, 0);
+    payload[0x6846] = 0;
+    payload[0x6844] = 0;
+    payload[0x6845] = 0;
+    payload[0x6874] = 0;
+    payload[0x6875] = 0;
+    fixed_store_le32(payload + 0x6878, 1);
+    fixed_store_le64(payload + 0x687c, 0);
+    fixed_store_le64(payload + 0x6884, 0);
+    fixed_store_le64(payload + 0x688a, 0);
+    fixed_store_le32(payload + 0x6894, 1);
+    fixed_store_le64(payload + 0x68a6, 0);
+    fixed_store_le32(payload + 0x68b0, 1);
+    fixed_store_le64(payload + 0x68b4, 0);
+    fixed_store_le64(payload + 0x68bc, 0);
+    fixed_store_le32(payload + 0x68c4, 0);
+#else
+    if (header[0x16] == 0) {
+        for (component = 0; component < 3; ++component) {
+            unsigned char *nlq = payload + 0x6874u + component * 0x1cu;
+            payload[0x6844 + component] = 0;
+            nlq[0] = 0;
+            nlq[1] = 0;
+            fixed_store_le32(nlq + 4, 1);
+            fixed_store_le32(nlq + 8, 0);
+            fixed_store_le32(nlq + 0xc, 0);
+            fixed_store_le32(nlq + 0x10, 0);
+            fixed_store_le32(nlq + 0x14, 0);
+            fixed_store_le32(nlq + 0x18, 0);
+        }
+    }
+#endif
+}
+
+int dovi_rpu_decoder_process_buffer(void *opaque, const unsigned char *input, unsigned int size,
+                                    void **header, void **payload, int *payload_size, void **dm,
+                                    int *dm_size)
+{
+    unsigned char *decoder = opaque;
+    dovi_validation_log_fn log = logger(decoder + DECODER_LOGGER);
+    unsigned int severity = fixed_load_le32(decoder + DECODER_SEVERITY), length;
+    unsigned char *data, *rh, *old;
+    int result;
+    parser_store_pointer(parser_load_pointer(decoder) + 8, parser_load_pointer(decoder + DECODER_CURRENT_PAYLOAD));
+    dovi_bitstream_init((struct dovi_bitstream *)(decoder + DECODER_BITSTREAM), input, size);
+    result = dovi_rpu_header_read(decoder);
+    if (result < 0)
+        return logged_error(log, severity, result, PARSER_HEADER_ERROR_LINE);
+    length = (unsigned int)result;
+    result = dovi_validate_level(parser_load_pointer(decoder), logger(decoder + DECODER_LOGGER),
+                                 fixed_load_le32(decoder + DECODER_SEVERITY));
+    if (result < 0)
+        return result;
+    result = dovi_validate_spatial_filter(parser_load_pointer(decoder), logger(decoder + DECODER_LOGGER),
+                                          fixed_load_le32(decoder + DECODER_SEVERITY));
+    if (result < 0)
+        return result;
+    data = parser_load_pointer(decoder);
+    rh = parser_load_pointer(data);
+    if (fixed_signed32(fixed_load_le32(parser_load_pointer(decoder + 8) + 0x66c)) <
+        (int)((unsigned int)rh[0x133] * rh[0x134])) {
+        /* STB 2.4 omits the %d argument; STB 2.6 supplies the partition count. */
+        if (log != 0 && severity > 2u)
+            log("ERROR: Payload buffer too small for %d partitions\n"
+#if PARSER_FATAL_ARRAY_LIMITS
+                , (unsigned int)rh[0x133] * rh[0x134]
+#endif
+            );
+        return -2;
+    }
+    if (rh[0] == 2 && rh[0x19] == 0) {
+        result = dovi_rpu_payload_read(decoder);
+        if (result < 0)
+            return logged_error(log, severity, result, PARSER_PAYLOAD_ERROR_LINE);
+        length += (unsigned int)result;
+        data = parser_load_pointer(decoder);
+    }
+    result =
+        dovi_validate_profile(data, logger(decoder + DECODER_LOGGER), fixed_load_le32(decoder + DECODER_SEVERITY));
+    if (result < 0)
+        return result;
+    if (fixed_load_le32(decoder + DECODER_DISABLE_MEL) == 0 &&
+        dovi_detect_mel((const struct dovi_decoder_prefix *)decoder) != 0)
+        parser_load_pointer(parser_load_pointer(decoder))[0x16] = 1;
+    data = parser_load_pointer(decoder);
+    rh = parser_load_pointer(data);
+    if (rh[0x18] != 0) {
+        result = dovi_dm_data_payload_read(decoder);
+        if (result < 0)
+            return logged_error(log, severity, result, PARSER_DM_ERROR_LINE);
+        length += (unsigned int)result;
+        data = parser_load_pointer(decoder);
+        rh = parser_load_pointer(data);
+    }
+    if (rh[0x19] == 0) {
+        unsigned char *slot;
+#if PARSER_FATAL_ARRAY_LIMITS
+        if (rh[0x1b] >= 15u)
+            parser_limit_trap();
+#endif
+        slot = decoder + DECODER_PAYLOAD_SLOTS + rh[0x1b] * 8u;
+        old = parser_load_pointer(slot);
+        parser_store_pointer(slot, parser_load_pointer(decoder + DECODER_CURRENT_PAYLOAD));
+        parser_store_pointer(decoder + DECODER_CURRENT_PAYLOAD, old);
+        rh = parser_load_pointer(data);
+#if PARSER_FATAL_ARRAY_LIMITS
+        if (rh[0x1b] >= 15u)
+            parser_limit_trap();
+#endif
+        parser_store_pointer(data + 8, parser_load_pointer(decoder + DECODER_PAYLOAD_SLOTS + rh[0x1b] * 8u));
+    } else if (((fixed_load_le32(decoder + 0x7c) >> (rh[0x1b] & 31u)) & 1u) == 0) {
+        dovi_set_default_payload(decoder);
+    } else {
+#if PARSER_FATAL_ARRAY_LIMITS
+        if (rh[0x1a] >= 15u)
+            parser_limit_trap();
+#endif
+        parser_store_pointer(data + 8, parser_load_pointer(decoder + DECODER_PAYLOAD_SLOTS + rh[0x1a] * 8u));
+    }
+    if (parser_load_pointer(decoder + DECODER_CURRENT_PAYLOAD) == 0 ||
+        parser_load_pointer(parser_load_pointer(decoder) + 8) == 0) {
+        if (log != 0 && severity > 2u)
+            log("Error: payload buffer not allocated\n");
+        return -2;
+    }
+    outputs(decoder, header, payload, payload_size, dm, dm_size);
+    return fixed_signed32(length);
+}
+
+int dovi_rpu_decoder_get_output(void *opaque, void **header, void **payload, int *payload_size,
+                                void **dm, int *dm_size)
+{
+    unsigned char *decoder = opaque;
+    unsigned int index;
+    int result;
+    if (fixed_load_le32(decoder + 0x315c0) != 0 && fixed_load_le32(decoder + 0x315bc) != 0 &&
+        fixed_load_le32(decoder + 0x315b8) != 0) {
+        outputs(decoder, header, payload, payload_size, dm, dm_size);
+        fixed_store_le32(decoder + 0x315b8, 0);
+        return 1;
+    }
+    index = fixed_load_le32(decoder + DECODER_OUTPUT_SLOT);
+    if (index == fixed_load_le32(decoder + DECODER_INPUT_SLOT) && fixed_load_le32(decoder + DECODER_DIRECT_MODE) == 0 &&
+        fixed_load_le32(decoder + DECODER_FLUSH) == 0)
+        return -20;
+    if (fixed_load_le32(parser_load_pointer(decoder + DECODER_SLOT_LENGTHS) + index * 4u) == 0)
+        return fixed_load_le32(decoder + DECODER_FLUSH) != 0 ? -21 : -20;
+    if (fixed_load_le32(decoder + DECODER_SEVERITY) > 6u) {
+        dovi_dump_rpu_buffer_info(decoder);
+        index = fixed_load_le32(decoder + DECODER_OUTPUT_SLOT);
+    }
+    result = dovi_rpu_decoder_process_buffer(
+        decoder, parser_load_pointer(decoder + 0x10) + (unsigned long long)index * 0x1000u,
+        fixed_load_le32(parser_load_pointer(decoder + DECODER_SLOT_LENGTHS) + index * 4u), header, payload,
+        payload_size, dm, dm_size);
+    index = fixed_load_le32(decoder + DECODER_OUTPUT_SLOT);
+    fixed_store_le32(parser_load_pointer(decoder + DECODER_SLOT_LENGTHS) + index * 4u, 0);
+    index = fixed_load_le32(decoder + DECODER_OUTPUT_SLOT);
+    fixed_store_le32(decoder + DECODER_OUTPUT_SLOT, (fixed_load_le32(decoder + DECODER_SLOT_COUNT) - 1u) & (index + 1u));
+    return result;
+}
diff --git a/tools/dvbridge/dv_stb26/rpu_pipeline.h b/tools/dvbridge/dv_stb26/rpu_pipeline.h
