diff --git a/tools/dvbridge/dv_stb26/parser_layout.h b/tools/dvbridge/dv_stb26/parser_layout.h
new file mode 100644
index 0000000..558b04d
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/parser_layout.h
@@ -0,0 +1,33 @@
+/* Byte offsets shared by the two native metadata-parser interfaces. */
+#ifndef DOVI_PARSER_LAYOUT_H
+#define DOVI_PARSER_LAYOUT_H
+#include "parser_context.h"
+
+enum parser_offset {
+    PARSER_INITIALIZED = 0x00, PARSER_EVENT_CALLBACK = 0x08,
+    PARSER_CALLBACK_CONTEXT = 0x10, PARSER_LAST_ERROR = 0x18,
+    PARSER_FLAGS = 0x1c, PARSER_DIRECT_MODE = 0x2c,
+    PARSER_DECODER = 0x38, PARSER_TIMESTAMP = 0x40,
+    PARSER_CURRENT_TIMESTAMP = 0x50, PARSER_LOGGER = 0x60,
+    PARSER_SAMPLE_COUNT = 0x68, PARSER_DECODER_STORAGE = 0x70
+};
+enum decoder_offset {
+    DECODER_ROOT = 0x00, DECODER_CONFIG = 0x08,
+    DECODER_INPUT_STORAGE = 0x10, DECODER_SLOT_LENGTHS = 0x18,
+    DECODER_INPUT_SLOT = 0x20, DECODER_OUTPUT_SLOT = 0x24,
+    DECODER_FLUSH = 0x28, DECODER_DISABLE_CRC = 0x2c,
+    DECODER_DIRECT_MODE = 0x30, DECODER_DISABLE_MEL = 0x34,
+    DECODER_SLOT_COUNT = 0x38, DECODER_BITSTREAM = 0x40,
+    DECODER_SEQUENCE_AVAILABLE = 0x78,
+    DECODER_LOGGER = 0x315c8, DECODER_SEVERITY = 0x315d0,
+    DECODER_FRAMING_STATE = 0x315d4, DECODER_PAYLOAD_STORAGE = 0x315d8,
+    DECODER_PAYLOAD_SLOTS = 0x31658, DECODER_CURRENT_PAYLOAD = 0x316d0,
+    DECODER_EVENT_CALLBACK = 0x316d8, DECODER_MEL = 0x316e0
+};
+#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L
+_Static_assert(offsetof(dv_md_parser_ctx_t, last_rc) == PARSER_LAST_ERROR, "parser error field");
+_Static_assert(offsetof(dv_md_parser_ctx_t, p_rpu_dcd_ctx) == PARSER_DECODER, "parser decoder field");
+_Static_assert(offsetof(dv_md_parser_ctx_t, ui64_sample) == PARSER_SAMPLE_COUNT, "parser sample field");
+_Static_assert(sizeof(dv_md_parser_ctx_t) == PARSER_DECODER_STORAGE, "parser prefix extent");
+#endif
+#endif
diff --git a/tools/dvbridge/dv_stb26/parser_lifecycle.c b/tools/dvbridge/dv_stb26/parser_lifecycle.c
new file mode 100644
index 0000000..b25663b
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/parser_lifecycle.c
@@ -0,0 +1,70 @@
+/* Initialize and destroy metadata parser state. */
+#include "parser_lifecycle.h"
+#include "parser_layout.h"
+#include "parser_process.h"
+#include "decoder_lifecycle.h"
+#include "error_strings.h"
+#include "fixed_access.h"
+
+#if !PARSER_RESET_FLAGS
+/* Context and decoder arena remain one static object in STB 2.4. */
+static union {
+    dv_md_parser_ctx_t context;
+    unsigned char bytes[MD_PARSER_SINGLETON_BYTES];
+} md_parser;
+
+dv_md_parser_ctx_t *dv_md_parser_create(void)
+{
+    parser_zero_bytes(md_parser.bytes, sizeof(dv_md_parser_ctx_t));
+    return &md_parser.context;
+}
+#endif
+
+int dovi_md_parser_init(dv_md_parser_ctx_t *parser, const dv_md_parser_conf_t *config)
+{
+    unsigned char *bytes = (unsigned char *)parser;
+    const unsigned char *configuration = (const unsigned char *)config;
+    void *decoder;
+    dovi_parser_log_fn log;
+    int result;
+    if (parser == 0)
+        return DV_MD_PARSER_INVALID_CONTEXT_HANDLE;
+    fixed_store_le32(bytes + PARSER_LAST_ERROR, DV_MD_PARSER_OK);
+    bytes[PARSER_INITIALIZED] = 0;
+    decoder = bytes + PARSER_DECODER_STORAGE;
+    parser_store_pointer(bytes + PARSER_DECODER, decoder);
+    parser_zero_bytes(bytes + PARSER_SAMPLE_COUNT, 8);
+    parser_copy8(bytes + PARSER_EVENT_CALLBACK, configuration);
+    parser_copy8(bytes + PARSER_CALLBACK_CONTEXT, configuration + 8);
+    parser_copy_bytes(bytes + PARSER_FLAGS, configuration + 0x10, sizeof(rpu_init_flags_t));
+    parser_copy8(bytes + PARSER_LOGGER, configuration + 0x30);
+    log = parser_load_logger(configuration + 0x30);
+    dovi_rpu_decoder_set_msg_log(decoder, log, S_RPU_NOTICE);
+    if (parser_load_output_callback(configuration) == 0) {
+        if (log != 0)
+            log("Dolby Vision metadata parser configured event notification callack is NULL\n");
+        fixed_store_le32(bytes + PARSER_LAST_ERROR, DV_MD_PARSER_INVALID_ARGUMENT);
+        return DV_MD_PARSER_INVALID_ARGUMENT;
+    }
+    result = dovi_rpu_decoder_init(decoder, configuration + 0x10);
+    if (result < 0) {
+        fixed_store_le32(bytes + PARSER_LAST_ERROR, (unsigned int)result);
+        log = parser_load_logger(bytes + PARSER_LOGGER);
+        if (log != 0)
+            log("Error: rpu_decoder_init failed: %s\n", dovi_rpu_error_code_2_str(result));
+        return result;
+    }
+    bytes[PARSER_INITIALIZED] = 1;
+    return DV_MD_PARSER_OK;
+}
+
+int dovi_md_parser_destroy(dv_md_parser_ctx_t *parser)
+{
+    unsigned char *bytes = (unsigned char *)parser;
+    if (parser == 0)
+        return DV_MD_PARSER_INVALID_CONTEXT_HANDLE;
+    if (parser_load_pointer(bytes + PARSER_DECODER) != 0)
+        parser_zero_bytes(bytes + PARSER_DECODER, 8);
+    bytes[PARSER_INITIALIZED] = 0;
+    return DV_MD_PARSER_OK;
+}
diff --git a/tools/dvbridge/dv_stb26/parser_lifecycle.h b/tools/dvbridge/dv_stb26/parser_lifecycle.h
new file mode 100644
index 0000000..c744368
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/parser_lifecycle.h
@@ -0,0 +1,28 @@
+/* Initialize and destroy metadata parser state. */
+#ifndef DOVI_PARSER_LIFECYCLE_H
+#define DOVI_PARSER_LIFECYCLE_H
+#include "parser_context.h"
+#include "parser_access.h"
+#include "parser_contract.h"
+#define DOVI_PARSER_INIT_CONFIG_SIZE 0x38u
+
+static inline dovi_parser_log_fn parser_load_logger(const void *source)
+{
+    dovi_parser_log_fn value;
+    parser_copy8(&value, source);
+    return value;
+}
+#if !PARSER_RESET_FLAGS
+/* Static STB 2.4 storage; create clears only the 0x70-byte parser prefix. */
+#define MD_PARSER_SINGLETON_BYTES 334048u
+dv_md_parser_ctx_t *dv_md_parser_create(void);
+#endif
+/* Parser includes decoder storage at +0x70. Configuration and arena are
+ * disjoint and stable; access is bytewise and does not require arena alignment.
+ * A null parser returns 2 without reading config. Missing callback returns 9
+ * after installing the decoder logger/severity. Destroy clears the initialized
+ * byte and decoder pointer without freeing or clearing the arena.
+ */
+int dovi_md_parser_init(dv_md_parser_ctx_t *parser, const dv_md_parser_conf_t *config);
+int dovi_md_parser_destroy(dv_md_parser_ctx_t *parser);
+#endif
diff --git a/tools/dvbridge/dv_stb26/parser_process.c b/tools/dvbridge/dv_stb26/parser_process.c
new file mode 100644
index 0000000..9c2b346
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/parser_process.c
@@ -0,0 +1,99 @@
+/* Dispatch metadata input to the decoder and deliver parser events. */
+#include "parser_process.h"
+#include "parser_layout.h"
+#include "rpu_buffering.h"
+#include "fixed_access.h"
+
+static int equal_timestamp(const void *left, const void *right)
+{
+    const unsigned char *a = left, *b = right;
+    unsigned int index;
+    for (index = 0; index < 8; ++index)
+        if (a[index] != b[index])
+            return 0;
+    return 1;
+}
+
+static void sample(unsigned char *parser, void *header, void *payload, int payload_size,
+                   void *dm, int dm_size, int result)
+{
+    parser_load_output_callback(parser + PARSER_EVENT_CALLBACK)(
+        parser_load_pointer(parser + PARSER_CALLBACK_CONTEXT), MD_PARSER_SAMPLE_AVAIL_EVT,
+        parser + PARSER_TIMESTAMP, header, payload, payload_size, dm, dm_size, result);
+}
+
+static void error(unsigned char *parser, int result)
+{
+    fixed_store_le32(parser + PARSER_LAST_ERROR, (unsigned int)result);
+    parser_load_output_callback(parser + PARSER_EVENT_CALLBACK)(
+        parser_load_pointer(parser + PARSER_CALLBACK_CONTEXT), MD_PARSER_ERROR_EVT,
+        0, 0, 0, 0, 0, 0, 0);
+}
+
+int dovi_md_parser_process(dv_md_parser_ctx_t *context, unsigned int flags,
+                           const void *timestamp, const unsigned char *input,
+                           unsigned int size, int flush, int *flags_out)
+{
+    unsigned char *parser = (unsigned char *)context;
+    void *header = 0, *payload = 0, *dm = 0;
+    int payload_size = 0, dm_size = 0, result, output;
+    unsigned int output_flags;
+    if (parser == 0)
+        return DV_MD_PARSER_INVALID_CONTEXT_HANDLE;
+    if (parser[PARSER_INITIALIZED] == 0)
+        return DV_MD_PARSER_UNINITIALIZE;
+    if ((flags & 8u) != 0 && timestamp != 0 &&
+        !equal_timestamp(timestamp, parser + PARSER_CURRENT_TIMESTAMP)) {
+        parser_copy8(parser + PARSER_TIMESTAMP, parser + PARSER_CURRENT_TIMESTAMP);
+        parser_copy8(parser + PARSER_CURRENT_TIMESTAMP, timestamp);
+    }
+    if (fixed_load_le32(parser + PARSER_DIRECT_MODE) != 0) {
+        result = dovi_rpu_decoder_process_buffer(parser_load_pointer(parser + PARSER_DECODER),
+                                                 input, size, &header, &payload, &payload_size,
+                                                 &dm, &dm_size);
+        if (result > 0) {
+            sample(parser, header, payload, payload_size, dm, dm_size, result);
+            result = 0;
+        } else {
+            error(parser, result);
+        }
+    } else {
+        result = dovi_rpu_decoder_push_data(parser_load_pointer(parser + PARSER_DECODER),
+                                            input, fixed_signed32(size), flush);
+        if (result != 0) {
+            fixed_store_le32(parser + PARSER_LAST_ERROR, (unsigned int)result);
+        } else {
+            do {
+                header = 0;
+                payload = 0;
+                dm = 0;
+                output = dovi_rpu_decoder_get_output(parser_load_pointer(parser + PARSER_DECODER),
+                                                     &header, &payload, &payload_size, &dm, &dm_size);
+                if (output > 0) {
+                    if (dovi_rpu_decoder_last_rpu_output(parser_load_pointer(parser + PARSER_DECODER)))
+                        parser_copy8(parser + PARSER_TIMESTAMP, parser + PARSER_CURRENT_TIMESTAMP);
+                    sample(parser, header, payload, payload_size, dm, dm_size, output);
+                } else {
+                    if ((unsigned int)output + 21u <= 1u)
+                        break;
+                    error(parser, output);
+                    result = output;
+                }
+#if !PARSER_DRAIN_AFTER_ERROR
+                if (output <= 0)
+                    break;
+#endif
+            } while ((unsigned int)output + 19u < 0xfffffffeu);
+        }
+    }
+    output_flags = fixed_load_le32(flags_out);
+    #if PARSER_DRAIN_AFTER_ERROR
+    output_flags = (output_flags & ~1u) |
+                   parser_load_pointer(parser + PARSER_DECODER)[DECODER_MEL];
+#else
+    output_flags = (output_flags & ~1u) |
+                   (parser_load_pointer(parser + PARSER_DECODER)[DECODER_MEL] != 0);
+#endif
+    fixed_store_le32(flags_out, output_flags);
+    return result;
+}
diff --git a/tools/dvbridge/dv_stb26/parser_process.h b/tools/dvbridge/dv_stb26/parser_process.h
