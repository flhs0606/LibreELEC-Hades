+++ b/tools/dvbridge/dv_stb26/memory_query.h
@@ -0,0 +1,18 @@
+#ifndef DOVI_MEMORY_QUERY_H
+#define DOVI_MEMORY_QUERY_H
+
+#define DOVI_RPU_MEMORY_CONFIG_MIN_SIZE 0x10u
+#define DOVI_MD_MEMORY_CONFIG_MIN_SIZE 0x20u
+#define DOVI_MEMORY_QUERY_LEVEL_COUNT 16u
+
+/*
+ * The decoder reads little-endian u32 values at config+4 (level) and config+12
+ * (payload-only mode). The parser wrapper passes config+16 to the decoder.
+ * Callers provide readable configuration and levels 0..15. With
+ * PARSER_FATAL_ARRAY_LIMITS, a level >=16 traps; otherwise indexing is unchecked.
+ * These queries do not validate pointers or lengths.
+ */
+unsigned long long dovi_rpu_decoder_mem_query(const unsigned char *config);
+unsigned long long dovi_md_parser_mem_query(const unsigned char *config);
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/metadata_callbacks.c b/tools/dvbridge/dv_stb26/metadata_callbacks.c
new file mode 100644
index 0000000..e7114ad
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/metadata_callbacks.c
@@ -0,0 +1,90 @@
+/* Accumulate composer and metadata output from parser sample events. */
+#include "metadata_callbacks.h"
+#include "module_parser.h"
+#include "module_parser_context.h"
+#include "parser_state.h"
+/* #include composer_conversion.h */
+/* #include composer_validation.h */
+#include "dm_serialization.h"
+#include "error_strings.h"
+#include "parser_access.h"
+#include "fixed_access.h"
+
+#if PARSER_ALLOCATED_APPLICATION_STORAGE
+#define PREFIX "\001" "6[dovi_gen_5_15_2026]: "
+unsigned int dovi_module_frame_nr;
+#else
+#define PREFIX "\001" "6"
+#endif
+
+void dovi_md_parser_evt_handler_cb(void *context, dv_md_parser_evt_t event,
+                                   const void *timestamp, const void *header,
+                                   const void *payload, int payload_size,
+                                   const void *dm, int dm_size, int output_result)
+{
+    struct dovi_module_parser_context *ctx;
+    dovi_module_log_fn logger;
+    unsigned char *frame_counter, *composer_size, *metadata_size;
+    int result, length;
+    unsigned int offset;
+#if PARSER_ALLOCATED_APPLICATION_STORAGE
+    ctx = context;
+    logger = dovi_module_os.printk;
+    frame_counter = (unsigned char *)&dovi_module_frame_nr;
+    composer_size = (unsigned char *)&ctx->composer_size;
+    metadata_size = (unsigned char *)&ctx->metadata_size;
+#else
+    struct dovi_module_parser_storage *state = context;
+    ctx = &state->storage.ctx;
+    logger = state->logger;
+    frame_counter = (unsigned char *)&state->counters.frame_nr;
+    composer_size = (unsigned char *)&state->counters.comp_size;
+    metadata_size = (unsigned char *)&state->counters.md_size;
+#endif
+    (void)timestamp;
+    (void)payload_size;
+    (void)dm_size;
+    (void)output_result;
+    fixed_store_le32(frame_counter, fixed_load_le32(frame_counter) + 1u);
+    if (event != MD_PARSER_SAMPLE_AVAIL_EVT) {
+        if (event != MD_PARSER_ERROR_EVT)
+            return;
+        result = parser_clamp_error(dovi_md_parser_get_last_err(ctx->parser));
+        goto error;
+    }
+    parser_zero_bytes(ctx->composer_config, sizeof(ctx->composer_config));
+    /* dovi_comp_rpu_2_main_cfg disabled */
+    result = 0;
+    if (result != 0)
+        goto error;
+    offset = fixed_load_le32(composer_size);
+    if (offset > 0x18f8u) {
+        logger(PREFIX "comp_size too big\n");
+        return;
+    }
+    parser_copy_bytes(ctx->composer_output + fixed_signed32(offset), ctx->composer_config,
+                      sizeof(ctx->composer_config));
+    fixed_store_le32(composer_size, fixed_load_le32(composer_size) + 0x708u);
+    result = 0;
+    if (result != 0)
+        goto error;
+    length = 0x10442;
+    result = dovi_dm_rpu_payload_2_byte_sequence(dm, ctx->metadata_sequence, &length);
+    if (result != 0)
+        goto error;
+    offset = fixed_load_le32(metadata_size);
+    if (fixed_signed32(offset) > fixed_signed32(0x400u - (unsigned int)length)) {
+        logger(PREFIX "md_size too big\n");
+        return;
+    }
+    parser_copy_bytes(ctx->metadata_output + fixed_signed32(offset), ctx->metadata_sequence,
+#if PARSER_SIGN_EXTEND_METADATA_COPY_LENGTH
+                      (unsigned long long)(long long)length);
+#else
+                      (unsigned int)length);
+#endif
+    fixed_store_le32(metadata_size, fixed_load_le32(metadata_size) + (unsigned int)length);
+    return;
+error:
+    logger(PREFIX "%s\n", dovi_rpu_error_code_2_str(result));
+}
diff --git a/tools/dvbridge/dv_stb26/metadata_callbacks.h b/tools/dvbridge/dv_stb26/metadata_callbacks.h
new file mode 100644
index 0000000..a9bf5a1
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/metadata_callbacks.h
@@ -0,0 +1,17 @@
+/* Native module metadata event callback. */
+#ifndef DOVI_METADATA_CALLBACKS_H
+#define DOVI_METADATA_CALLBACKS_H
+#include "parser_context.h"
+/* Composer and metadata buffers provide 8192/1024 writable bytes. All copied
+ * ranges are disjoint, callbacks are serialized, and timestamp/input lengths
+ * are ignored. Frame count advances for every event, including errors. Output
+ * thresholds retain native signedness and composer writes precede DM errors.
+ * STB 2.4 counters live beside its singleton; STB 2.6 sizes live per instance
+ * while its frame count remains module-wide. Native copy-length widening is
+ * retained even for nonpositive lengths outside normal serializer output.
+ */
+void dovi_md_parser_evt_handler_cb(void *context, dv_md_parser_evt_t event,
+                                   const void *timestamp, const void *header,
+                                   const void *payload, int payload_size,
+                                   const void *dm, int dm_size, int output_result);
+#endif
diff --git a/tools/dvbridge/dv_stb26/metadata_init_body.c b/tools/dvbridge/dv_stb26/metadata_init_body.c
new file mode 100644
index 0000000..55ca841
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/metadata_init_body.c
@@ -0,0 +1,63 @@
+/* Bind and initialize metadata callback storage and parser configuration. */
+#include "module_parser.h"
+#include "module_parser_context.h"
+#include "memory_query.h"
+#include "parser_access.h"
+#include "parser_lifecycle.h"
+#include "error_strings.h"
+
+#define PREFIX "\001" "6[dovi_gen_5_15_2026]: "
+
+void *dovi_metadata_parser_init(void)
+{
+    struct dovi_module_parser_context *ctx = dovi_module_os.vmalloc(sizeof(*ctx));
+    void *allocation;
+    unsigned long long size;
+    int result;
+    if (!ctx) {
+        dovi_module_os.printk(PREFIX "Error malloc app_ctx_t\n");
+        return 0;
+    }
+    parser_zero_bytes(ctx, sizeof(*ctx));
+    allocation = dovi_module_os.vmalloc(0x10442);
+    ctx->metadata_sequence = allocation;
+    if (!allocation) {
+        dovi_module_os.printk(PREFIX "Error malloc dm_byte_sequence\n");
+        goto fail;
+    }
+    parser_zero_bytes(allocation, 0x10442);
+    parser_zero_bytes(&ctx->config.flags, sizeof(ctx->config.flags));
+    ctx->config.flags.profile = RPU_MAIN_PROFILE;
+    ctx->config.flags.payload_only = 1;
+    size = dovi_md_parser_mem_query((const unsigned char *)&ctx->config);
+    allocation = dovi_module_os.vmalloc(size);
+    ctx->parser = allocation;
+    if (!allocation) {
+        dovi_module_os.printk(PREFIX "Error malloc h_md_parser\n");
+        goto fail;
+    }
+    parser_zero_bytes(allocation, size);
+    ctx->config.p_md_parser_cb_ctx = ctx;
+    ctx->config.pf_md_parser_cb = dovi_md_parser_evt_handler_cb;
+    parser_zero_bytes(&ctx->config.pf_msg_log, sizeof(ctx->config.pf_msg_log));
+    result = dovi_md_parser_init(ctx->parser, &ctx->config);
+    if (result == 0) {
+        dovi_module_os.printk(PREFIX "Creating DV mp success\n");
+        return ctx;
+    }
+    dovi_module_os.printk(PREFIX "dv_md_parser_init(rc='%s') failed)\n",
+                          dovi_rpu_error_code_2_str(parser_clamp_error(result)));
+fail:
+    dovi_module_os.printk(PREFIX "Error creating DV metadata parser\n");
+    if (ctx->metadata_sequence) {
+        dovi_module_os.vfree(ctx->metadata_sequence);
+        ctx->metadata_sequence = 0;
+    }
+    if (ctx->parser) {
+        dovi_md_parser_destroy(ctx->parser);
+        dovi_module_os.vfree(ctx->parser);
+        ctx->parser = 0;
+    }
+    dovi_module_os.vfree(ctx);
+    return 0;
+}
diff --git a/tools/dvbridge/dv_stb26/metadata_runtime.c b/tools/dvbridge/dv_stb26/metadata_runtime.c
new file mode 100644
index 0000000..1533fcd
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/metadata_runtime.c
@@ -0,0 +1,105 @@
+/* Expose metadata host callbacks and retain native parser state. */
+#include "module_parser.h"
+#include "module_parser_context.h"
+#include "parser_process.h"
+#include "parser_state.h"
+#include "parser_access.h"
+#include "fixed_access.h"
+#include "error_strings.h"
+#include "parser_lifecycle.h"
+#include "supplemental_dispatch.h"
+
+#define PREFIX "\001" "6[dovi_gen_5_15_2026]: "
+
+static void process_error(int result)
+{
+    dovi_module_os.printk(PREFIX "dv_md_parser_process failed %s\n",
+                          dovi_rpu_error_code_2_str(parser_clamp_error(result)));
+}
+
+void dovi_metadata_parser_release(void **context)
+{
+    struct dovi_module_parser_context *ctx = *context;
+    if (!ctx)
+        return;
+    if (ctx->metadata_sequence) {
+        dovi_module_os.vfree(ctx->metadata_sequence);
+        ctx->metadata_sequence = 0;
+    }
+    if (ctx->parser) {
+        dovi_md_parser_destroy(ctx->parser);
+        dovi_module_os.vfree(ctx->parser);
+        ctx->parser = 0;
+    }
+    if (*context) {
+        dovi_module_os.vfree(*context);
+        *context = 0;
+    }
+}
+
+int dovi_metadata_parser_reset(void *context)
+{
+    struct dovi_module_parser_context *ctx = context;
+    int result;
+    if (!ctx) {
+        dovi_module_os.printk(PREFIX "metadata_parser_reset null param\n");
+        return -1;
+    }
+    result = dovi_md_parser_reset(ctx->parser, 1);
+    if (result == 0) {
+        dovi_module_frame_nr = 0;
+        return 0;
+    }
+    dovi_module_os.printk(PREFIX "dv_md_parser_reset(rc='%s') failed\n",
+                          dovi_rpu_error_code_2_str(result));
+    return -1;
+}
+
+int dovi_metadata_parser_process(void *context, const unsigned char *input, unsigned int size,
+                                 void *composer_output, unsigned int *composer_size,
+                                 void *metadata_output, unsigned int *metadata_size,
+                                 unsigned int flags, int input_kind)
+{
+    struct dovi_module_parser_context *ctx = context;
+    int output_flags = 0;
+    unsigned int length = 0u - 5u;
+    int result;
+    if (!ctx) {
+        dovi_module_os.printk(PREFIX "metadata_parser_process null param\n");
+        return -1;
+    }
+    parser_zero_bytes(&ctx->composer_size, 8);
+    ctx->input = input;
+    ctx->composer_output = composer_output;
+    ctx->metadata_output = metadata_output;
+    if ((unsigned int)input_kind - 1u < 2u) {
+        result = dovi_md_parser_process_vui(ctx->parser);
+        if (result != 0)
+            process_error(result);
+        result = dovi_md_parser_process_mastering_display_colour_volume(
+            ctx->parser, input + 0x1c, fixed_load_le32(input + 0x18));
+        if (result != 0)
+            process_error(result);
+        result = dovi_md_parser_process_user_data_registered_itu_t_t35(
+            ctx->parser, 0, 0, input + 0x120, fixed_load_le32(input + 0x11c));
+        if (result == 0)
+            goto success;
+        result = parser_clamp_error(result);
+        process_error(result);
+    } else {
+        length = parser_trimmed_payload_size(input, size);
+        result = dovi_md_parser_process(ctx->parser, 0, 0, input + 5, length, (int)(flags & 1u),
+                                        &output_flags);
+        if (result == 0)
+            goto success;
+        result = parser_clamp_error(result);
+    }
+    dovi_module_os.printk(PREFIX "dv_md_parser_process %d:%02x,%02x (rc='%s') failed\n",
+                          fixed_signed32(length), (unsigned int)input[5], (unsigned int)input[6],
+                          dovi_rpu_error_code_2_str(result));
+    return -1;
+success:
+    *composer_size = ctx->composer_size;
+    *metadata_size = ctx->metadata_size;
+    return fixed_signed32(output_flags);
+}
diff --git a/tools/dvbridge/dv_stb26/module_parser.h b/tools/dvbridge/dv_stb26/module_parser.h
new file mode 100644
index 0000000..f63714f
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/module_parser.h
@@ -0,0 +1,34 @@
+/* Host metadata-parser ownership and callback wrappers. */
+#ifndef DOVI_MODULE_PARSER_H
+#define DOVI_MODULE_PARSER_H
+
+typedef int (*dovi_module_log_fn)(const char *format, ...);
+
+#define DOVI_MODULE_PARSER_CONTEXT_SIZE 0x770u
+#define DOVI_MODULE_PARSER_COMPOSER_CAPACITY 0x2000u
+#define DOVI_MODULE_PARSER_METADATA_CAPACITY 0x400u
+
+/* The kernel bridge or host adapter defines this table before any call.
+ * Allocation returns stable, writable, suitably aligned storage or NULL.
+ * Free and printk retain their original ordering. printf-style arguments
+ * contain integers and pointers only, and all supplied callbacks are valid.
+ */
+struct dovi_module_imports {
+    void *(*vmalloc)(unsigned long long size);
+    void (*vfree)(void *pointer);
+    int (*printk)(const char *format, ...);
+};
+extern struct dovi_module_imports dovi_module_os;
+extern unsigned int dovi_module_frame_nr;
+
+void *dovi_metadata_parser_init(void);
+void dovi_metadata_parser_release(void **context);
+int dovi_metadata_parser_reset(void *context);
+int dovi_metadata_parser_process(void *context, const unsigned char *input, unsigned int size,
+                                 void *composer_output, unsigned int *composer_size,
+                                 void *metadata_output, unsigned int *metadata_size,
+                                 unsigned int flags, int input_kind);
+
+#include "metadata_callbacks.h"
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/module_parser_context.h b/tools/dvbridge/dv_stb26/module_parser_context.h
new file mode 100644
index 0000000..1aa2057
