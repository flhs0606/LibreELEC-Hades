+    if (setting_words == (int *)0x0) {
+        result = 0;
+        goto return_result;
+    }
+    if (setting_words[DOVI_SETTING_WORD(DOVI_SETTING_NUM_INPUT)] == 0) {
+        if (enable_debug != 0) {
+            _printk("reset cp\n");
+        }
+        memset(&reg1, 0, 0x790);
+        memset(&reg2, 0, 0x158);
