@@ -0,0 +1,11 @@
+#ifndef DOVI_ERROR_STRINGS_H
+#define DOVI_ERROR_STRINGS_H
+
+/*
+ * Return a stable, non-NULL pointer to the diagnostic text. Codes -22..0 select
+ * the table. Codes -19..-15 and all codes outside -22..0 share the
+ * "Unknown error_code" pointer. Static storage must not be written or freed.
+ */
+const char *dovi_rpu_error_code_2_str(int code);
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/ext_blocks.c b/tools/dvbridge/dv_stb26/ext_blocks.c
new file mode 100644
index 0000000..f229512
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/ext_blocks.c
@@ -0,0 +1,364 @@
+/* Parse extension headers and level-specific metadata payloads. */
+#include "parser_api.h"
+#include "dm_payload.h"
+#include "bitstream.h"
+#include "decoder_lifecycle.h"
+
+typedef unsigned char byte;
+typedef unsigned int u32;
+typedef unsigned long long u64;
+typedef int (*log_fn)(const char *, ...);
+typedef dec_event_callback_t event_fn;
+typedef char require_uint32[(sizeof(u32) == 4 && sizeof(int) == 4) ? 1 : -1];
+typedef char require_pointer64[(sizeof(void *) == 8 && sizeof(log_fn) == 8 && sizeof(event_fn) == 8)
+                                   ? 1
+                                   : -1];
+
+static void copy8(byte *dest, const byte *src)
+{
+    u32 i;
+    for (i = 0; i < 8u; ++i)
+        dest[i] = src[i];
+}
+
+static byte *read_pointer(const byte *p)
+{
+    byte *value;
+    copy8((byte *)&value, p);
+    return value;
+}
+
+static log_fn read_log(const byte *p)
+{
+    log_fn value;
+    copy8((byte *)&value, p);
+    return value;
+}
+
+static event_fn read_event(const byte *p)
+{
+    event_fn value;
+    copy8((byte *)&value, p);
+    return value;
+}
+
+static u32 read32(const byte *p)
+{
+    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24);
+}
+
+static void write16(byte *p, u32 value)
+{
+    p[0] = (byte)value;
+    p[1] = (byte)(value >> 8);
+}
+
+static void write32(byte *p, u32 value)
+{
+    write16(p, value);
+    write16(p + 2, value >> 16);
+}
+
+static int signed32(u32 value)
+{
+    return (value & 0x80000000u) ? -1 - (int)~value : (int)value;
+}
+
+static void zero_message(char *message)
+{
+    volatile char *dest = message;
+    u32 i;
+    for (i = 0; i < 256u; ++i)
+        dest[i] = 0;
+}
+
+/* Each diagnostic substitutes one decimal value in 0..255. */
+/* Merged from message_decimal_impl.inc */
+/* Format one decimal value in the range 0..255. */
+static void message_decimal(char *message, const char *format, u32 value)
+{
+    u32 pos = 0;
+    while (*format != 0) {
+        if (format[0] == '%' && format[1] == 'd') {
+            if (value >= 100u)
+                message[pos++] = (char)('0' + value / 100u);
+            if (value >= 10u)
+                message[pos++] = (char)('0' + (value / 10u) % 10u);
+            message[pos++] = (char)('0' + value % 10u);
+            format += 2;
+        } else {
+            message[pos++] = *format++;
+        }
+    }
+    message[pos] = 0;
+}
+
+
+static void read_words(byte *dest, u32 count, u32 width, struct dovi_bitstream *bits)
+{
+    while (count-- != 0) {
+        write16(dest, dovi_read_u_v(width, bits));
+        dest += 2;
+    }
+}
+
+static void read_bytes(byte *dest, u32 count, struct dovi_bitstream *bits)
+{
+    while (count-- != 0)
+        *dest++ = (byte)dovi_read_u_v(8u, bits);
+}
+
+#if PARSER_DECODER_EXTENSION_API
+int dovi_ext_block_payload_read(void *decoder, void *block, void *dovi_bitstream,
+                                const byte *block_index)
+{
+    byte *ctx = (byte *)decoder;
+    byte *record = (byte *)block;
+    byte *config = read_pointer(ctx + 8);
+    const byte *event_slot = ctx + 0x316d8;
+    struct dovi_bitstream *bits = (struct dovi_bitstream *)dovi_bitstream;
+#else
+int dovi_ext_block_payload_read(void *context, void *event_slot, void *block,
+                                struct dovi_bitstream *bits, const byte *block_index)
+{
+    byte *record = (byte *)block;
+    byte *config = (byte *)context;
+#endif
+    u32 length = read32(record), declared_bits = length * 8u;
+    u32 consumed = 0, level = record[4], limit = 0, i;
+    int result = 0;
+    const char *limit_message = (const char *)0;
+    char message[256];
+    zero_message(message);
+
+    switch (level) {
+    case 1:
+    case 3:
+        read_words(record + 6, 3, 12, bits);
+        consumed = 36;
+        break;
+    case 2:
+        read_words(record + 6, 6, 12, bits);
+        {
+            u32 value = dovi_read_u_v(13, bits);
+            write16(record + 0x12, value | (0u - (value & 0x1000u)));
+        }
+        consumed = 85;
+        limit = 8;
+        limit_message = "Found more than %d L2 trims\n";
+        break;
+    case 4:
+        read_words(record + 6, 2, 12, bits);
+        consumed = 24;
+        break;
+    case 5:
+        read_words(record + 6, 4, 13, bits);
+        consumed = 52;
+        break;
+    case 6:
+        read_words(record + 6, 4, 16, bits);
+        consumed = 64;
+        break;
+    case 8:
+        record[6] = (byte)dovi_read_u_v(8, bits);
+        read_words(record + 8, 6, 12, bits);
+        consumed = 80;
+        if (read32(record) >= 11u) {
+            read_words(record + 0x14, 1, 12, bits);
+            consumed = 92;
+            if (read32(record) >= 13u) {
+                read_words(record + 0x16, 1, 12, bits);
+                consumed = 104;
+                if (read32(record) >= 14u) {
+                    read_bytes(record + 0x18, 6, bits);
+                    consumed = 152;
+                    if (read32(record) >= 20u) {
+                        read_bytes(record + 0x1e, 6, bits);
+                        consumed = 200;
+                    }
+                }
+            }
+        }
+        limit = 5;
+        limit_message = "Found more than %d L8 trims\n";
+        break;
+    case 9:
+        record[6] = (byte)dovi_read_u_v(8, bits);
+        consumed = 8;
+        if (record[6] >= 19u) {
+            /* Signed 16-bit extraction has identical stored low 16 bits. */
+            read_words(record + 8, 8, 16, bits);
+            consumed = 136;
+        }
+        break;
+    case 10:
+        record[6] = (byte)dovi_read_u_v(8, bits);
+        read_words(record + 8, 2, 12, bits);
+        record[0x0c] = (byte)dovi_read_u_v(8, bits);
+        consumed = 40;
+        if (record[0x0c] >= 19u) {
+            read_words(record + 0x0e, 8, 16, bits);
+            consumed = 168;
+        }
+        limit = 4;
+        limit_message = "Found more than %d L10 trims\n";
+        break;
+    case 11:
+        read_bytes(record + 6, 4, bits);
+        consumed = 32;
+        break;
+    case 254:
+        read_bytes(record + 6, 2, bits);
+        consumed = 16;
+        break;
+    case 255:
+        read_bytes(record + 6, 6, bits);
+        consumed = 48;
+        break;
+    default:
+        if (length != 0) {
+            i = 0;
+            do {
+                record[6 + i] = (byte)dovi_read_u_v(8, bits);
+                consumed += 8u;
+#if PARSER_BOUNDED_UNKNOWN_EXTENSION
+                if (i == 255u)
+                    break;
+#endif
+                ++i;
+            } while (i < read32(record));
+        }
+        break;
+    }
+
+    if (limit != 0 && config[0x67c + record[4]] >= limit) {
+        if (read_event((const byte *)event_slot) != (event_fn)0) {
+            message_decimal(message, limit_message, limit);
+            read_event((const byte *)event_slot)(4, 0x100, message);
+        }
+        result = -1;
+    } else {
+        config[0x77c + record[4]] = *block_index;
+        config[0x67c + record[4]] = (byte)(config[0x67c + record[4]] + 1u);
+    }
+
+    /* Minimum payload lengths are not enforced here. */
+    if (consumed < declared_bits) {
+        u32 remaining = declared_bits - consumed;
+        do {
+            (void)parser_read_flag(bits);
+        } while (--remaining != 0);
+    }
+    return result;
+}
+
+/* Merged from extension_levels_impl.inc */
+/* Extension levels that replace an existing record of the same level. */
+static int unique_level(u32 level)
+{
+    switch (level) {
+    case 1:
+    case 3:
+    case 4:
+    case 5:
+    case 6:
+    case 9:
+    case 11:
+    case 254:
+    case 255:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+
+int dovi_ext_blocks_read(void *decoder, void *blocks, byte *count, u32 kind)
+{
+    byte *ctx = (byte *)decoder, *records = (byte *)blocks;
+    struct dovi_bitstream *bits = (struct dovi_bitstream *)(ctx + 0x40);
+    log_fn log = read_log(ctx + 0x315c8);
+    u32 log_level = read32(ctx + 0x315d0), adjusted_count = *count;
+    u32 output_count = 0, processed = 0;
+    byte block_index = 0;
+    char message[256];
+    zero_message(message);
+
+    if (*count != 0) {
+        align_to_byte(bits);
+
+        if (*count != 0) {
+            do {
+                u32 length = dovi_read_ue_v(bits);
+                u32 level = dovi_read_u_v(8, bits);
+                u32 selected;
+                byte *config;
+                u64 remaining;
+                int payload_result;
+
+                if (read_event(ctx + 0x316d8) != (event_fn)0) {
+                    int old_payload_level = level == 1u || level == 2u || level == 4u ||
+                                            level == 5u || level == 6u || level == 255u;
+                    if ((kind == 1u && !old_payload_level) ||
+                        ((PARSER_NONFIRST_EXTENSION_KIND ? kind != 1u : kind == 2u) &&
+                         old_payload_level)) {
+                        message_decimal(message,
+                                        kind == 1u ? "Found level %d extension in payload 1"
+                                                   : "Found level %d extension in payload 2",
+                                        level);
+                        read_event(ctx + 0x316d8)(4, 0x105, message);
+                    }
+                }
+
+                config = read_pointer(ctx + 8);
+                if (unique_level(level) && config[0x67c + level] != 0) {
+                    --adjusted_count;
+                    block_index = config[0x77c + level];
+                    selected = block_index;
+                    if (read_event(ctx + 0x316d8) != (event_fn)0) {
+                        message_decimal(message, "Found more than one L%d extension level", level);
+                        read_event(ctx + 0x316d8)(4, 0x101, message);
+                    }
+                } else {
+                    byte *record = records + (u64)(output_count & 255u) * 0x108;
+                    block_index = (byte)output_count;
+                    selected = output_count;
+                    output_count += 1u;
+                    write32(record, length);
+                    record[4] = (byte)level;
+                }
+
+                if (length > 256u) {
+                    if (log != (log_fn)0 && log_level >= 3u)
+                        log("ERROR: Found level %d extension with length %d (> MAX_UNKNOWN_MD_SIZE %d)\n",
+                            level, signed32(length), 256);
+                    return -2;
+                }
+                remaining = (u64)bits->tail - (u64)bits->next + 1u;
+                if ((remaining & 0x8000000000000000ull) != 0 || remaining < length) {
+                    if (log != (log_fn)0 && log_level >= 3u)
+                        log("ERROR: Found level %d extension with length %d. This is beyond the size of the rpu input buffer. The stream is corrupted.\n",
+                            level, length, 256);
+                    return -2;
+                }
+#if PARSER_DECODER_EXTENSION_API
+                payload_result = dovi_ext_block_payload_read(
+                    ctx, records + (u64)(selected & 255u) * 0x108, bits, &block_index);
+#else
+                payload_result = dovi_ext_block_payload_read(
+                    read_pointer(ctx + 8), ctx + 0x316d8, records + (u64)(selected & 255u) * 0x108,
+                    bits, &block_index);
+#endif
+                if (payload_result < 0) {
+                    output_count -= 1u;
+                    --adjusted_count;
+                }
+                ++processed;
+            } while (processed < *count);
+        }
+    }
+    if ((output_count & 255u) != 255u)
+        records[(u64)(output_count & 255u) * 0x108 + 4] = 0;
+    *count = (byte)adjusted_count;
+    return 0;
+}
diff --git a/tools/dvbridge/dv_stb26/ext_blocks.h b/tools/dvbridge/dv_stb26/ext_blocks.h
new file mode 100644
index 0000000..117fdcf
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/ext_blocks.h
@@ -0,0 +1,27 @@
+#ifndef DOVI_EXT_BLOCKS_H
+#define DOVI_EXT_BLOCKS_H
+
+#include "parser_contract.h"
+#include "bitstream.h"
+
+/*
+ * Records have stride 0x108, a little-endian length at +0, level at +4 and
+ * payload at +6. Decoder+8 points to mutable configuration and +0x40 embeds
+ * the bitstream. Supply stable, disjoint objects and accessible padded input.
+ * Unknown payload limits, alignment and callback interfaces follow the parser
+ * contract. Fixed levels preserve their unchecked minimum-length behavior.
+ * The list reader updates count only on success; the payload reader receives
+ * the selected record index, rather than an output/removal flag.
+ * The list reader returns 0 or -2; the payload reader returns 0 or -1.
+ */
+#if PARSER_DECODER_EXTENSION_API
+int dovi_ext_blocks_read(void *decoder, void *blocks, unsigned char *count, unsigned int kind);
+int dovi_ext_block_payload_read(void *decoder, void *block, void *bits,
+                                const unsigned char *block_index);
+#else
+int dovi_ext_blocks_read(void *decoder, void *blocks, unsigned char *count, unsigned int kind);
+int dovi_ext_block_payload_read(void *context, void *event_callback_slot, void *record,
+                                struct dovi_bitstream *bits, const unsigned char *block_index);
+#endif
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/fixed_access.h b/tools/dvbridge/dv_stb26/fixed_access.h
new file mode 100644
index 0000000..a3dd879
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/fixed_access.h
@@ -0,0 +1,81 @@
+/* Fixed-width signed views and explicit unaligned little-endian accesses. */
+#ifndef DOVI_FIXED_ACCESS_H
+#define DOVI_FIXED_ACCESS_H
+#include "fixed_bits.h"
+
+/* Raw register views require the same scalar widths in both library versions. */
+typedef char fixed_require_scalar_widths[
+    (sizeof(unsigned int) == 4 && sizeof(unsigned long long) == 8) ? 1 : -1];
+
+static inline int fixed_signed32(unsigned int value)
+{
+    return value <= 0x7fffffffu ? (int)value : -1 - (int)~value;
+}
+
+static inline short fixed_signed16(unsigned int value)
+{
+    value &= 0xffffu;
+    return (short)(value <= 0x7fffu ? (int)value : (int)value - 0x10000);
+}
+
+static inline long long fixed_signed64(unsigned long long value)
+{
+    return value <= 0x7fffffffffffffffull ? (long long)value : -1 - (long long)~value;
+}
+
+static inline unsigned int fixed_sign16(unsigned int value)
+{
+    return (value & 0x7fffu) - (value & 0x8000u);
+}
+
+static inline unsigned int fixed_load_le16(const void *pointer)
+{
+    const unsigned char *bytes = pointer;
+    return (unsigned int)bytes[0] | ((unsigned int)bytes[1] << 8);
+}
+
+static inline unsigned int fixed_load_le32(const void *pointer)
+{
+    const unsigned char *bytes = pointer;
+    return fixed_load_le16(bytes) | (fixed_load_le16(bytes + 2) << 16);
+}
+
+static inline unsigned long long fixed_load_le64(const void *pointer)
+{
+    const unsigned char *bytes = pointer;
+    return fixed_load_le32(bytes) | ((unsigned long long)fixed_load_le32(bytes + 4) << 32);
+}
+
+static inline unsigned int fixed_load_be16(const void *pointer)
+{
+    const unsigned char *bytes = pointer;
+    return ((unsigned int)bytes[0] << 8) | (unsigned int)bytes[1];
+}
+
+static inline unsigned int fixed_load_be32(const void *pointer)
+{
+    const unsigned char *bytes = pointer;
+    return (fixed_load_be16(bytes) << 16) | fixed_load_be16(bytes + 2);
+}
+
+static inline void fixed_store_le16(void *pointer, unsigned int value)
+{
+    unsigned char *bytes = pointer;
+    bytes[0] = (unsigned char)value;
+    bytes[1] = (unsigned char)(value >> 8);
+}
+
+static inline void fixed_store_le32(void *pointer, unsigned int value)
+{
+    unsigned char *bytes = pointer;
+    fixed_store_le16(bytes, value);
+    fixed_store_le16(bytes + 2, value >> 16);
+}
+
+static inline void fixed_store_le64(void *pointer, unsigned long long value)
+{
+    unsigned char *bytes = pointer;
+    fixed_store_le32(bytes, (unsigned int)value);
+    fixed_store_le32(bytes + 4, (unsigned int)(value >> 32));
+}
+#endif
diff --git a/tools/dvbridge/dv_stb26/fixed_arithmetic.c b/tools/dvbridge/dv_stb26/fixed_arithmetic.c
new file mode 100644
index 0000000..4397177
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/fixed_arithmetic.c
@@ -0,0 +1,164 @@
+/* Fixed-point arithmetic with native argument and result widths. */
+#include "fixed_access.h"
+#include "fixed_arithmetic.h"
+
+
+static unsigned long long unsigned_product_high(unsigned long long a, unsigned long long b)
+{
+    unsigned long long low = (unsigned long long)(unsigned int)a * (unsigned int)b;
+    unsigned long long cross_a = (unsigned long long)(unsigned int)a * (b >> 32);
+    unsigned long long cross_b = (unsigned long long)(unsigned int)b * (a >> 32);
+    unsigned long long carry = (low >> 32) + (unsigned int)cross_a + (unsigned int)cross_b;
+    return (a >> 32) * (b >> 32) + (cross_a >> 32) + (cross_b >> 32) + (carry >> 32);
+}
+
+int dovi_sadd_sss(unsigned int first, unsigned int second)
+{
+    return fixed_signed32(fixed_add(first, second));
+}
+
+int dovi_ssub_sss(unsigned int first, unsigned int second)
+{
+    return fixed_signed32(fixed_subtract(first, second));
+}
+
+unsigned int dovi_uabs_ss(unsigned int value)
+{
+    return fixed_abs32(value);
+}
+
+unsigned long long dovi_uabs_ls(unsigned long long value)
+{
+    return fixed_abs64(value);
+}
+
+unsigned long long dovi_smpy_ss(unsigned int first, unsigned int second)
+{
+    return fixed_multiply(first, second);
+}
+
+unsigned int dovi_unorm_s(unsigned int value)
+{
+    return fixed_normalize32(fixed_abs32(value));
+}
+
+unsigned long long dovi_unorm_u(unsigned long long value)
+{
+    /* The original cbz w0 returns without changing x0 in this case. */
+    return (unsigned int)value == 0 ? value : fixed_normalize32((unsigned int)value);
+}
+
+unsigned long long dovi_unorm_u_lut(unsigned long long value)
+{
+    return (unsigned int)value == 0 ? value : fixed_normalize_lut32((unsigned int)value);
+}
+
+unsigned int dovi_unorm_sl(unsigned long long value)
+{
+    return fixed_normalize64(fixed_abs64(value));
+}
+
+unsigned int dovi_unorm_ul(unsigned long long value)
+{
+    return fixed_normalize64(value);
+}
+
+int dovi_sshl_ssu(unsigned int raw_value, unsigned int raw_shift)
+{
+    unsigned int value = raw_value, shift = raw_shift;
+    unsigned long long wide;
+    if ((shift & 0x80000000u) != 0)
+        return fixed_signed32(0);
+    if (shift >= 31u)
+        shift = 31;
+    wide = fixed_sign32(value) << shift;
+    if (wide != fixed_sign32((unsigned int)wide))
+        return fixed_signed32(0x7fffffffu + (value >> 31));
+    return fixed_signed32((unsigned int)wide);
+}
+
+int dovi_sshr_sss(unsigned int raw_value, unsigned int raw_shift)
+{
+    unsigned int value = raw_value, shift = raw_shift;
+    if ((shift & 0x80000000u) != 0)
+        return fixed_signed32(dovi_sshl_ssu(value, 0u - shift));
+    return fixed_signed32(fixed_asr32(value, shift < 31u ? shift : 31u));
+}
+
+unsigned long long dovi_sdiv_sls(unsigned long long numerator, unsigned int denominator)
+{
+    return denominator == 0 ? 0 : fixed_divide(numerator, denominator);
+}
+
+int dovi_abs_int32(unsigned int value)
+{
+    return fixed_signed32(fixed_abs32(value));
+}
+
+long long dovi_abs_int64(unsigned long long value)
+{
+    return fixed_signed64(fixed_abs64(value));
+}
+
+unsigned long long dovi_sdiv(unsigned long long numerator, unsigned int denominator)
+{
+    return denominator == 0 ? 0x7fffffffull : fixed_divide(numerator, denominator);
+}
+
+void dovi_uint64_mul(unsigned long long a, unsigned long long b, void *high, void *low)
+{
+    unsigned long long upper = unsigned_product_high(a, b);
+    fixed_store_le64(low, a * b);
+    fixed_store_le64(high, upper);
+}
+
+void dovi_int64_mul(unsigned long long a, unsigned long long b, void *high, void *low)
+{
+    unsigned long long upper = unsigned_product_high(a, b);
+    upper -= b & (0ull - (a >> 63));
+    upper -= a & (0ull - (b >> 63));
+    fixed_store_le64(low, a * b);
+    fixed_store_le64(high, upper);
+}
+
+unsigned long long dovi_uint64_lshift(unsigned long long a, unsigned long long b,
+                                      unsigned int shift)
+{
+    return (a << ((0u - shift) & 63u)) | (b >> (shift & 63u));
+}
+
+unsigned long long dovi_int64_lshift(unsigned long long a, unsigned long long b,
+                                     unsigned long long shift)
+{
+    return (a << (shift & 63u)) | fixed_asr64(b, (unsigned int)shift);
+}
+
+/* Merged from matrix_arithmetic.c */
+/* Fixed-point matrix arithmetic. */
+#include "fixed_access.h"
+#include "matrix_arithmetic.h"
+#include "fixed_arithmetic.h"
+#include "matrix_scale_impl.h"
+
+
+unsigned int dovi_FindInt64M33Precision(const void *input)
+{
+    return matrix_precision(input);
+}
+
+unsigned int dovi_Adjust64M33ScaleTo16M33(const void *input, unsigned int scale, void *output)
+{
+    return matrix_scale(input, scale, output, 0, MATRIX_SATURATE);
+}
+
+unsigned int dovi_InvM33(const void *input, void *output, unsigned int input_scale,
+                         unsigned int output_scale)
+{
+    return matrix_inverse(input, output, input_scale, output_scale, MATRIX_SATURATE);
+}
+
+unsigned int dovi_Adjust64M33ScaleTo16M33Rounded(const void *input, unsigned int scale,
+                                                 void *output)
+{
+    return matrix_scale(input, scale, output, 1, MATRIX_SATURATE);
+}
diff --git a/tools/dvbridge/dv_stb26/fixed_arithmetic.h b/tools/dvbridge/dv_stb26/fixed_arithmetic.h
new file mode 100644
index 0000000..47eb08b
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/fixed_arithmetic.h
@@ -0,0 +1,41 @@
+#ifndef DOVI_FIXED_ARITHMETIC_H
+#define DOVI_FIXED_ARITHMETIC_H
+
+/* Raw inputs preserve every native bit pattern. Signed add/subtract and
+ * absolute-value results support callers that perform signed arithmetic; the
+ * fixed helpers define wrapping and signed minima without signed-C overflow.
+ */
+int dovi_sadd_sss(unsigned int first, unsigned int second);
+int dovi_ssub_sss(unsigned int first, unsigned int second);
+unsigned int dovi_uabs_ss(unsigned int value);
+unsigned long long dovi_uabs_ls(unsigned long long value);
+unsigned long long dovi_smpy_ss(unsigned int first, unsigned int second);
+unsigned int dovi_unorm_s(unsigned int value);
+unsigned long long dovi_unorm_u(unsigned long long value);
+unsigned long long dovi_unorm_u_lut(unsigned long long value);
+unsigned int dovi_unorm_sl(unsigned long long value);
+unsigned int dovi_unorm_ul(unsigned long long value);
+int dovi_sshl_ssu(unsigned int raw_value, unsigned int raw_shift);
+int dovi_sshr_sss(unsigned int raw_value, unsigned int raw_shift);
+unsigned long long dovi_sdiv_sls(unsigned long long numerator, unsigned int denominator);
+int dovi_abs_int32(unsigned int value);
+long long dovi_abs_int64(unsigned long long value);
+unsigned long long dovi_sdiv(unsigned long long numerator, unsigned int denominator);
+
+/* Products write the low word first, then the high word, in little-endian
+ * byte order. Output slots need eight writable bytes each and may overlap.
+ * The signed version interprets the inputs as two's-complement 64-bit values.
+ */
+void dovi_uint64_mul(unsigned long long a, unsigned long long b, void *high, void *low);
+void dovi_int64_mul(unsigned long long a, unsigned long long b, void *high, void *low);
+
+/* Preserve these differently defined original functions despite their names:
+ * unsigned: (a << ((-shift)&63)) | (b >> (shift&63));
+ * signed:   (a << (shift&63)) | arithmetic_shift_right(b, shift&63).
+ */
+unsigned long long dovi_uint64_lshift(unsigned long long a, unsigned long long b,
+                                      unsigned int shift);
+unsigned long long dovi_int64_lshift(unsigned long long a, unsigned long long b,
+                                     unsigned long long shift);
+
+#endif
diff --git a/tools/dvbridge/dv_stb26/fixed_bits.h b/tools/dvbridge/dv_stb26/fixed_bits.h
new file mode 100644
index 0000000..984dc46
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/fixed_bits.h
@@ -0,0 +1,191 @@
+/* Shared fixed-width primitives; public wrappers retain their result widths. */
+#ifndef DOVI_FIXED_BITS_H
+#define DOVI_FIXED_BITS_H
+
+static inline unsigned long long fixed_sign32(unsigned int value)
+{
+    return (unsigned long long)value | ((0ull - (value >> 31)) << 32);
+}
+
+/* Shift counts retain AArch64 register masking, including a zero shift. */
+static inline unsigned int fixed_asr32(unsigned int value, unsigned int shift)
+{
+    shift &= 31u;
+    if (shift == 0)
+        return value;
+    return (value >> shift) | ((0u - (value >> 31)) << (32u - shift));
+}
+
+static inline unsigned long long fixed_asr64(unsigned long long value, unsigned int shift)
+{
+    shift &= 63u;
+    if (shift == 0)
+        return value;
+    return (value >> shift) | ((0ull - (value >> 63)) << (64u - shift));
+}
+
+static inline int fixed_less32(unsigned int first, unsigned int second)
+{
+    return (first ^ 0x80000000u) < (second ^ 0x80000000u);
+}
+
+static inline int fixed_less64(unsigned long long first, unsigned long long second)
+{
+    return (first ^ 0x8000000000000000ull) < (second ^ 0x8000000000000000ull);
+}
+
+static inline unsigned int fixed_add(unsigned int a, unsigned int b)
+{
+    unsigned int sum = a + b;
+    if ((~(a ^ b) & (a ^ sum) & 0x80000000u) != 0)
+        return 0x7fffffffu + (a >> 31);
+    return sum;
+}
+
+static inline unsigned int fixed_subtract(unsigned int a, unsigned int b)
+{
+    unsigned int difference = a - b;
+    if (((a ^ b) & (a ^ difference) & 0x80000000u) != 0)
+        return 0x7fffffffu + (a >> 31);
+    return difference;
+}
+
+static inline unsigned int fixed_abs32(unsigned int value)
+{
+    if (value == 0x80000000u)
+        return 0x7fffffffu;
+    return value >> 31 ? 0u - value : value;
+}
+
+static inline unsigned long long fixed_abs64(unsigned long long value)
+{
+    if (value == 0x8000000000000000ull)
+        return 0x7fffffffffffffffull;
+    return value >> 63 ? 0ull - value : value;
+}
+
+static inline unsigned int fixed_normalize32(unsigned int value)
+{
+    unsigned int shifts = 0;
+    if (value == 0)
+        return 0;
+    while ((value & 0x80000000u) == 0) {
+        value <<= 1;
+        ++shifts;
+    }
+    return shifts == 0 ? 0 : shifts - 1u;
+}
+
+static inline unsigned int fixed_normalize64(unsigned long long value)
+{
+    unsigned int shifts = 0;
+    if (value == 0)
+        return 0;
+    while ((value & 0x8000000000000000ull) == 0) {
+        value <<= 1;
+        ++shifts;
+    }
+    return shifts == 0 ? 0 : shifts - 1u;
+}
+
+static inline unsigned long long fixed_multiply(unsigned int a, unsigned int b)
+{
+    return (fixed_sign32(a) * fixed_sign32(b)) >> 31;
+}
+
+/* Raw signed divide first wraps INT64_MIN/-1, then saturates to signed32.
+ * An in-range negative quotient retains its complete sign-extended bits. */
+static inline unsigned long long fixed_divide(unsigned long long numerator,
+                                              unsigned int denominator)
+{
+    unsigned long long magnitude = numerator >> 63 ? 0ull - numerator : numerator;
+    unsigned int divisor = denominator >> 31 ? 0u - denominator : denominator;
+    unsigned long long quotient;
+    if (divisor == 0)
+        return 0;
+    quotient = magnitude / divisor;
+    if (((numerator >> 63) ^ (denominator >> 31)) != 0)
+        quotient = 0ull - quotient;
+    if (quotient != fixed_sign32((unsigned int)quotient))
+        quotient = 0x7fffffffull + (quotient >> 63);
+    return quotient;
+}
+
+static inline unsigned int fixed_normalize_lut32(unsigned int value)
+{
+    static const unsigned int lut[16] = {
+        0u, 3u, 2u, 2u, 1u, 1u, 1u, 1u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u
+    };
+    unsigned int shifts = 0;
+    if (!value)
+        return 0;
+    if (value < 0x10000u)
+        shifts = 16;
+    else
+        value >>= 16;
+    if (value < 0x100u)
+        shifts += 8;
+    else
+        value >>= 8;
+    if (value < 0x10u)
+        shifts += 4;
+    else
+        value >>= 4;
+    return lut[value] + shifts;
+}
+
+static inline unsigned int fixed_log_polynomial(unsigned int value)
+{
+    unsigned int result = (unsigned int)fixed_multiply(value, 0xfe64613fu);
+    result = (unsigned int)fixed_multiply(value, result + 0x7a2972du);
+    result = (unsigned int)fixed_multiply(value, result + 0xee6c8ee6u);
+    result = (unsigned int)fixed_multiply(value, result + 0x1d275dc5u);
+    result = (unsigned int)fixed_multiply(value, result + 0xd213873au);
+    return (unsigned int)fixed_multiply(value, result + 0x5c518466u);
+}
+
+/* Normalization is0..30 and the accumulator is positive below2^63 for
+ * every raw32 input. See numerics.md for the recorded coefficient bounds. */
+static inline unsigned int fixed_sqrt_approximation(unsigned int value)
+{
+    unsigned int norm = fixed_normalize32(value), a = value << (norm & 31u);
+    unsigned int square = (unsigned int)fixed_multiply(a, a);
+    unsigned int cube = (unsigned int)fixed_multiply(square, a);
+    unsigned int fourth = (unsigned int)fixed_multiply(cube, a);
+    unsigned long long accumulator =
+        (unsigned long long)a * 0x52aa9432u + fixed_sign32(square) * fixed_sign32(0xc6f3beebu) +
+        fixed_sign32(cube) * 0x1f11c934u + fixed_sign32(fourth) * fixed_sign32(0xf88b70b4u) +
+        0x0762247a00000000ull;
+    unsigned long long result = fixed_asr64(accumulator, (norm >> 1) + 30u);
+    if (result > 0x7fffffffull)
+        result = 0x7fffffffull;
+    return norm & 1u ? (unsigned int)fixed_multiply((unsigned int)result, 0x5a82799au)
+                     : (unsigned int)result;
+}
+
+static inline unsigned int fixed_power_polynomial(unsigned int value)
+{
+    unsigned int p = (unsigned int)fixed_multiply(value, 0x29080u);
+    p = (unsigned int)fixed_multiply(value, p + 0x164080u);
+    p = (unsigned int)fixed_multiply(value, p + 0x9d8f80u);
+    p = (unsigned int)fixed_multiply(value, p + 0x38d3180u);
+    p = (unsigned int)fixed_multiply(value, p + 0xf5fe000u);
+    p = (unsigned int)fixed_multiply(value, p + 0x2c5c8b80u);
+    return p + 0x40000000u;
+}
+
+/* Raw AArch64 signed divide, including zero and INT64_MIN/-1. */
+static inline unsigned long long fixed_raw_divide64(unsigned long long numerator,
+                                                    unsigned long long denominator)
+{
+    unsigned long long a = numerator >> 63 ? 0ull - numerator : numerator;
+    unsigned long long b = denominator >> 63 ? 0ull - denominator : denominator;
+    unsigned long long q = b ? a / b : 0;
+    return (numerator ^ denominator) >> 63 ? 0ull - q : q;
+}
+
+static inline unsigned int fixed_raw_divide32(unsigned int numerator, unsigned int denominator)
+{
+    return (unsigned int)fixed_raw_divide64(fixed_sign32(numerator), fixed_sign32(denominator));
+}
+#endif
diff --git a/tools/dvbridge/dv_stb26/fixed_transcendentals.c b/tools/dvbridge/dv_stb26/fixed_transcendentals.c
new file mode 100644
index 0000000..327e8a0
--- /dev/null
+++ b/tools/dvbridge/dv_stb26/fixed_transcendentals.c
@@ -0,0 +1,316 @@
+/* Integer Taylor approximations with native scale and result handling. */
+#include "fixed_access.h"
+#include "fixed_transcendentals.h"
+#include "fixed_arithmetic.h"
+
+typedef unsigned int u32;
+#include "fixed_transcendentals_tables.h"
+
+static unsigned long long mul32(unsigned int a, unsigned int b)
+{
+    return fixed_sign32(a) * fixed_sign32(b);
+}
+
+static unsigned int integer_part(unsigned int value, unsigned int fraction)
+{
+    if ((fraction >> 31) != 0)
+        return fraction;
+    return fixed_asr32(value, fraction < 31u ? fraction : 31u);
+}
+
+static unsigned int logarithmic_product(unsigned int value, unsigned long long exponent)
+{
+    return (unsigned int)((fixed_sign32(dovi_fxLOG2Taylor(value, 26u) - 0x7c000000u) * exponent) >>
+                          31);
+}
+
+static unsigned int power_scaled(unsigned int product, unsigned int bias)
+{
+    return dovi_sshr_sss(fixed_power_polynomial((product & 0x3ffffffu) << 5),
+                         bias - fixed_asr32(product, 26));
+}
+
+static unsigned int correction(unsigned long long exponent, unsigned int bias)
+{
+    return dovi_sshr_sss(fixed_power_polynomial((unsigned int)exponent & 0x7fffffffu),
+                         bias + ((unsigned int)(exponent >> 31) & 1u));
+}
+
+static unsigned long long pow_repeated_correction(unsigned long long value,
+                                                  unsigned long long exponent,
+                                                  unsigned int input_shift)
+{
+    unsigned long long e = fixed_asr64(exponent, 1);
+    unsigned int p = power_scaled(logarithmic_product((unsigned int)(value >> input_shift), e), 0);
+    unsigned int c = correction(e, 3u), i;
+    unsigned long long v = fixed_asr64(mul32(c, p), 27);
+    for (i = 1; i + 1u < input_shift; ++i)
+        v = fixed_asr64(v * fixed_sign32(c), 27);
+    v = fixed_asr64(v * fixed_sign32(c), 30);
+    return fixed_asr64(v * v, 27);
+}
+
+static unsigned long long wide_square_shift(unsigned long long value, unsigned int shift)
+{
+    unsigned long long high, low;
+    dovi_uint64_mul(value, value, &high, &low);
+    return (low >> shift) | (high << (64u - shift));
+}
+
+void dovi_fx_assert(int test, const char *message)
+{
+    (void)test;
+    (void)message;
+}
+
+int dovi_fxLOG2Taylor(unsigned int raw_value, unsigned int raw_scale_out)
+{
+    unsigned int norm, a, result, shift, integral;
+    if (raw_value == 0u)
+        return fixed_signed32(1u << (raw_scale_out & 31u));
+    norm = dovi_unorm_s(raw_value);
+    a = ((raw_value << (norm & 31u)) & 0x3fffffffu) << 1;
+    result = fixed_log_polynomial(a);
+    shift = 30u - raw_scale_out;
+    result = (shift >> 31) != 0 ? shift : fixed_asr32(result + 0x8e8u, shift < 31u ? shift : 31u);
+    integral = (raw_scale_out >> 31) != 0 ? 0 : (30u - norm) << (raw_scale_out & 31u);
+    return fixed_signed32(result + integral);
+}
+
+int dovi_fxPOW2Taylor(unsigned int raw_value, unsigned int raw_scale_in, unsigned int raw_scale_out)
+{
+    unsigned int value = raw_value, scale_in = raw_scale_in, scale_out = raw_scale_out;
+    unsigned int integer = integer_part(value, scale_in);
+    unsigned int result = fixed_power_polynomial((value << ((0u - scale_in) & 31u)) >> 1);
+    return fixed_signed32(dovi_sshr_sss(result, 30u - scale_out - integer));
+}
+
+int dovi_powTaylor(unsigned int value, unsigned int exponent)
+{
+    return fixed_signed32(power_scaled(logarithmic_product(value, exponent), 0xffffffffu));
+}
+
+long long dovi_LfxPOW2Taylor(unsigned int raw_value, unsigned int raw_scale_in)
+{
+    unsigned int value = raw_value, scale_in = raw_scale_in;
+    unsigned int integer = integer_part(value, scale_in), shift = integer + 2u;
+    unsigned long long result =
+        fixed_sign32(fixed_power_polynomial((value << ((0u - scale_in) & 31u)) >> 1));
+    if (shift != 0 && (shift >> 31) == 0)
+        return fixed_signed64(result << (shift & 63u));
+    return fixed_signed64(fixed_asr64(result, 0u - shift));
+}
+
+int dovi_expNTaylor(unsigned int raw_value, unsigned int raw_scale_out)
+{
+    unsigned int value = raw_value, scale_out = raw_scale_out;
+    unsigned int p = (unsigned int)(mul32(value, 0x5c551d94u) >> 30);
+    return fixed_signed32(dovi_sshr_sss(fixed_power_polynomial((p & 0x3fffffffu) << 1),
+                                        30u - scale_out - fixed_asr32(p, 30)));
+}
+
+unsigned long long dovi__powInSTaylor(unsigned long long raw_value, unsigned int raw_scale)
+{
+    unsigned long long value = raw_value;
+    unsigned int scale = raw_scale;
+    unsigned int p = dovi_fxPOW2Taylor(
+        logarithmic_product((unsigned int)(value >> (scale & 63u)), 0x14640000u), 26, 30);
+    unsigned int c = dovi_fxPOW2Taylor(0x14640000u, 31, 27), count = scale - 2u;
+    unsigned long long v = fixed_asr64(mul32(c, p), 27);
+    do {
+        v = (v * fixed_sign32(c)) >> 27;
+        --count;
+    } while (count != 0);
+    return (v * fixed_sign32(c)) >> 26;
+}
+
+unsigned int dovi_ssqrt_s(unsigned int value)
+{
+    return fixed_sqrt_approximation(value);
+}
+
+unsigned long long dovi_log10Taylor(unsigned int value)
+{
+    return mul32(dovi_fxLOG2Taylor(value, 26u) - 0x7c000000u, 0x268826a1u) >> 31;
+}
+
+unsigned long long dovi_powIn4Taylor(unsigned long long value, unsigned int exponent)
+{
+    unsigned int p = power_scaled(logarithmic_product((unsigned int)(value >> 2), exponent), 0);
+    unsigned int c = correction(exponent, 1u);
+    unsigned int v = (unsigned int)(mul32(p, c) >> 29);
+    return mul32(v, c) >> 30;
+}
+
+unsigned long long dovi_powInExp2Taylor(unsigned int value, unsigned long long exponent)
+{
+    unsigned int p = power_scaled(logarithmic_product(value, exponent >> 1), 0xffffffffu);
+    return mul32(p, p) >> 31;
+}
+
+unsigned long long dovi_powIn4Exp2Taylor(unsigned long long value, unsigned long long exponent)
+{
+    unsigned long long e = fixed_asr64(exponent, 1);
+    unsigned int p = power_scaled(logarithmic_product((unsigned int)(value >> 2), e), 0);
+    unsigned int c = correction(e, 3u), v = (unsigned int)(mul32(p, c) >> 27);
+    v = (unsigned int)(mul32(v, c) >> 30);
+    return mul32(v, v) >> 27;
+}
+
+unsigned long long dovi_powIn4Exp4Taylor(unsigned long long value, unsigned long long exponent)
+{
+    unsigned long long e = fixed_asr64(exponent, 2);
+    unsigned int p = power_scaled(logarithmic_product((unsigned int)(value >> 2), e), 0);
+    unsigned int c = correction(e, 3u);
+    unsigned long long v = fixed_asr64(mul32(c, p), 27);
+    v = fixed_asr64(v * fixed_sign32(c), 30);
+    v = fixed_asr64(v * v, 27);
+    return fixed_asr64(v * v, 23);
+}
+
+unsigned long long dovi_powIn8Exp2Taylor(unsigned long long value, unsigned long long exponent)
+{
+    return pow_repeated_correction(value, exponent, 3);
+}
+
+unsigned long long dovi_powIn32Exp2Taylor(unsigned long long value, unsigned long long exponent)
+{
+    return pow_repeated_correction(value, exponent, 5);
+}
+
+unsigned long long dovi_powInsExpsTaylor(unsigned int value, unsigned int input_fraction,
+                                         unsigned int exponent, unsigned int exponent_fraction)
+{
+    unsigned int logarithm, clipped, shift;
+    unsigned long long product, p;
+    if (value == 0)
+        return 0;
+    logarithm = dovi_fxLOG2Taylor(value, 26u) - (input_fraction << 26);
+    product = fixed_asr64(mul32(logarithm, exponent), exponent_fraction);
+    clipped = (unsigned int)product;
+    if (!fixed_less64(product, 0x80000000ull))
+        clipped = 0x7fffffffu;
+    if (!fixed_less64(0xffffffff7fffffffull, product))
+        clipped = 0x80000000u;
+    shift = fixed_asr32(clipped, 26);
+    p = fixed_sign32(fixed_power_polynomial((clipped & 0x3ffffffu) << 5));
+    if ((clipped ^ 0x80000000u) > (0xfbffffffu ^ 0x80000000u))
+        return p << ((shift + 2u) & 63u);
+    return fixed_asr64(p, 0xfffffffeu - shift);
+}
+
+unsigned long long dovi_log10TaylorB(unsigned int value)
+{
+    return mul32(dovi_fxLOG2Taylor(value, 26u), 0x268826a1u) >> 31;
+}
+
+unsigned int dovi_expNTaylorIn2(unsigned int value)
+{
+    unsigned int p = (unsigned int)(mul32(value, 0x2e2a8ecau) >> 29);
+    return dovi_sshr_sss(fixed_power_polynomial((p & 0x1fffffffu) << 2), 2u - fixed_asr32(p, 29));
+}
+
+unsigned int dovi_expNTaylorIn8(unsigned int value)
+{
+    unsigned int p = (unsigned int)(mul32(value, 0xb8aa3b2u) >> 27);
+    return dovi_sshr_sss(fixed_power_polynomial((p & 0x7ffffffu) << 4), 11u - fixed_asr32(p, 27));
+}
+
+#if defined(_MSC_VER)
+void __debugbreak(void);
+#pragma intrinsic(__debugbreak)
+
+__declspec(noreturn) static void angle_limit_trap(void)
+{
+    __debugbreak();
+    __assume(0);
+}
+
+__declspec(noreturn) static void angle_bounds_trap(void)
+{
+    __debugbreak();
+    __assume(0);
+}
+#elif defined(__GNUC__) || defined(__clang__)
+__attribute__((noreturn)) static void angle_limit_trap(void)
+{
+#if defined(__aarch64__)
+    __builtin_trap();
+    __builtin_unreachable();
+#else
+    __builtin_trap();
+#endif
+}
+
+__attribute__((noreturn)) static void angle_bounds_trap(void)
+{
+#if defined(__aarch64__)
+    __builtin_trap();
+    __builtin_unreachable();
+#else
+    __builtin_trap();
+#endif
+}
+#else
+#error "Provide nonreturning angle bounds traps."
+#endif
+
+unsigned int dovi_ATan2(unsigned int y, unsigned int x)
+{
+    unsigned int ay = dovi_uabs_ss(y), ax = dovi_uabs_ss(x);
+    unsigned int ratio, index, next, angle;
+    int vertical = ax < ay;
+    ratio =
+        (unsigned int)dovi_sdiv((unsigned long long)(vertical ? ax : ay) << 18, vertical ? ay : ax);
+    if ((ratio ^ 0x80000000u) >= (0x3ffffu ^ 0x80000000u))
+        ratio = 0x3ffffu;
+    index = (ratio >> 11) & 0xffffu;
+    next = ((ratio >> 11) & 0xffffu);
+    next = (next | ((0u - ((next >> 15) & 1u)) << 16)) + 1u;
+    if (index > 128u || next > 128u)
+        angle_limit_trap();
+    if (index > 128u)
+        angle_bounds_trap();
+    angle = arc_tan_lut[index] +
+            (unsigned int)(mul32(ratio & 0x7ffu, arc_tan_lut[next] - arc_tan_lut[index]) >> 11);
+    if (vertical) {
+        if (y != 0 && (y >> 31) == 0)
+            return x != 0 && (x >> 31) == 0 ? 0x6487fu - angle : 0x6487fu + angle;
+        return x != 0 && (x >> 31) == 0 ? angle - 0x6487fu : 0u - 0x6487fu - angle;
+    }
+    if (x != 0 && (x >> 31) == 0)
+        return (y >> 31) != 0 ? 0u - angle : angle;
+    return y != 0 && (y >> 31) == 0 ? 0xc90feu - angle : angle - 0xc90feu;
+}
+
+unsigned long long dovi_powIn2Exp128Taylor(unsigned long long value, unsigned long long exponent)
+{
+    unsigned long long e = fixed_asr64(exponent, 7), v;
+    unsigned int p = dovi_fxPOW2Taylor(logarithmic_product((unsigned int)(value >> 1), e), 26, 30);
+    unsigned int c = dovi_fxPOW2Taylor((unsigned int)e, 31, 27), i;
+    v = fixed_asr64(mul32(c, p), 27);
+    v = fixed_asr64(v * v, 29);
+    for (i = 0; i < 6u; ++i)
+        v = fixed_asr64(v * v, 31);
+    return v;
+}
+
+unsigned long long dovi_powIn16Exp8Taylor(unsigned long long value, unsigned long long exponent)
+{
+    unsigned long long e = fixed_asr64(exponent, 3), v;
+    unsigned int p = dovi_fxPOW2Taylor(logarithmic_product((unsigned int)(value >> 4), e), 26, 30);
+    unsigned int c = dovi_fxPOW2Taylor((unsigned int)e, 31, 27);
+    v = fixed_asr64(mul32(c, p), 27);
+    v = (v * fixed_sign32(c)) >> 27;
+    v = (v * fixed_sign32(c)) >> 27;
+    v *= fixed_sign32(c);
+    if ((v >> 57) == 0) {
+        v >>= 27;
+        v = (v * v) >> 29;
+        v = (v * v) >> 31;
+        return (v * v) >> 31;
+    }
+    v = wide_square_shift(v >> 27, 29);
+    v = wide_square_shift(v, 31);
+    return wide_square_shift(v, 31);
+}
