+        if (trim_count_or_value != 0) {
+            if (-1 < (int)source_component_or_luma_adjustment) {
+                source_component_or_luma_adjustment = 0;
+            }
+            input_state[0x3e] = source_component_or_luma_adjustment;
+        }
+    } else {
+        input_state[100] = 0;
+    }
