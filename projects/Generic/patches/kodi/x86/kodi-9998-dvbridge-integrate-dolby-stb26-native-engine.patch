+    fixed_store_le64((unsigned char *)setting_words + DOVI_SETTING_CORE1 + 0x2bc, word1);
+    memcpy(setting_words + DOVI_SETTING_WORD(DOVI_SETTING_CORE1), &DOVI_CORE1_U8_00C8, 0x2b4);
