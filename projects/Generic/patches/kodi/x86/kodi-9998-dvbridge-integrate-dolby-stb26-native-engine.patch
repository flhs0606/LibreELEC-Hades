+    summary->contrast_slope = trim->contrast_slope >> 0xe;
+    summary->chroma_weight = trim->chroma_weight >> 0xe;
+    summary->saturation_gain = trim->saturation_gain >> 0xe;
+    summary->luminance_gain = trim->luminance_gain >> 8;
+}
